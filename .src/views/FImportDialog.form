# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,109,67)
  Text = ("Photo import dialog")
  Resizable = False
  Spacing = True
  Margin = True
  Padding = 4
  { PanelList Panel
    MoveScaled(1,1,107,56)
    { PictureBoxPreview PictureBox
      MoveScaled(75,4,25,21)
      Alignment = Align.Center
      Border = Border.Plain
      Mode = PictureBox.Contain
    }
    { Label4 Label
      MoveScaled(75,1,18,3)
      Text = ("Preview")
    }
    { Label3 Label
      MoveScaled(1,1,25,3)
      Text = ("Photos to import")
    }
    { ListEditorPhotos ListEditor
      MoveScaled(1,4,73,33)
      Moveable = False
    }
    { CheckBoxEnableAlbum CheckBox
      MoveScaled(75,29,33,4)
      Text = ("Import photos into an album")
    }
    { !LabelAlbumNameSelected Label
      MoveScaled(78,34,25,3)
      #Public = True
      AutoResize = True
      Alignment = Align.Center
      Border = Border.Plain
      BorderWidth = 1
      BorderRadius = 10
      BorderColor = Color.DarkRoyal
    }
    { ScrollView1 ScrollView
      MoveScaled(76,38,29,16)
    }
  }
  { VBoxButtons2 VBox
    MoveScaled(1,58,84,8)
    { Separator2 Separator
      MoveScaled(0,0,72,2)
    }
    { HBoxButtons2 HBox
      MoveScaled(0,2,82,5)
      Spacing = True
      Padding = 4
      { Spring2 Spring
        MoveScaled(31,0,4,4)
      }
      { ButtonAccept Button
        MoveScaled(41,0,18,4)
        Text = ("Accept")
      }
      { ButtonExit Button
        MoveScaled(63,0,18,4)
        Text = ("Exit")
      }
    }
  }
}
