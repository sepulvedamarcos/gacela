' Gambas class file

Private $IsSelected As Boolean
Private $PhotoId As Integer
Private $SelectionService As PhotoSelectionService
Private $PhotoEntity As PhotoEntity
Private $IsTrashView As Boolean

Property Read PhotoId As Integer
Property Read IsSelected As Boolean
Property Read PhotoEntity As PhotoEntity

Public Sub _new(oSelectionService As PhotoSelectionService, oPhoto As PhotoEntity, bIsTrashView As Boolean) '' Initializes the photo component with its entity and selection service.
  
  $SelectionService = oSelectionService
  $PhotoEntity = oPhoto
  $PhotoId = oPhoto.Id
  $IsTrashView = bIsTrashView
  
  Me.Width = 160
  Me.Height = 100
  
  PanelPhoto.x = 0
  PanelPhoto.y = 0
  PanelPhoto.Width = Me.Width
  PanelPhoto.Height = Me.Height
  
  If oPhoto.HasThumbnail Then
    PictureBoxPhoto.Image = Image.FromString(oPhoto.Thumbnail)
  Else
    If IsDir(oPhoto.ImagePath) Then
      PictureBoxPhoto.Image = Image.Load(oPhoto.ImagePath &/ oPhoto.FileName)
    Else
      PictureBoxPhoto.Image = Image.Load(oPhoto.ImagePath)
    Endif
  Endif
  
  PictureBoxPhoto.Width = PanelPhoto.Width - 2
  PictureBoxPhoto.Height = PanelPhoto.Height - 2
  PictureBoxPhoto.Mode = PictureBox.Contain
  PictureBoxPhoto.Alignment = Align.Center
  PictureBoxPhoto.x = 2
  PictureBoxPhoto.y = 2
  PictureBoxPhoto.Padding = 8
  
  If oPhoto.IsLocked Then ButtonLock.Picture = Picture["icon:/16/lock"]
  
End

Public Sub Form_Enter() '' Handles mouse hover entry.
  
  ButtonSeleccionar.Visible = True
  ButtonSeleccionar.Raise()
  
  PictureBoxPhoto.Border = Border.Styled
  
  If $IsTrashView Then
    ButtonDelete.Visible = True
    ButtonDelete.Raise()
    ButtonLock.Visible = False
  Else
    ButtonLock.Visible = True
    ButtonLock.Raise()
    ButtonDelete.Visible = False
  Endif

End

Public Sub Form_Leave() '' Handles mouse hover exit.
  
  ButtonSeleccionar.Visible = False
  PictureBoxPhoto.Border = Border.None
  
  ButtonLock.Visible = False
  ButtonDelete.Visible = False

End

Public Sub ButtonDelete_Click()

  If $SelectionService <> Null Then
    $SelectionService.DeletePermanently($PhotoEntity)
  Endif

End

Public Sub ButtonSeleccionar_Click() '' Handles selection button click.
  
  SetSelected(Not $IsSelected)
  
End

Public Sub SetSelected(bIsSelected As Boolean, Optional bShouldNotify As Boolean = True) '' Updates the selection state and visual feedback.
  
  If $IsSelected = bIsSelected Then
    RefreshSelectionVisual()
    Return
  Endif
  
  $IsSelected = bIsSelected
  RefreshSelectionVisual()
  
  If Not bShouldNotify Then Return
  If $SelectionService = Null Then Return
  
  If $IsSelected Then
    $SelectionService.Select($PhotoEntity)
  Else
    $SelectionService.Unselect($PhotoEntity)
  Endif
  
End

Public Sub PictureBoxPhoto_DblClick() '' Handles double click on the photo.
  
  Dim FV As FPhotoViewer
  
  FV = New FPhotoViewer
  FV.ShowModal()
  
End

Public Sub ResizeScaledForm(iSize As Integer) '' Scales the photo component visually.
  
  If iSize > 0 Then
    Me.Width = Me.Width * 1.25
    Me.Height = Me.Height * 1.25
    PanelPhoto.Width = PanelPhoto.Width * (1.25)
    PanelPhoto.Height = PanelPhoto.Height * (1.25)
  Else
    Me.Width = Me.Width / 1.25
    Me.Height = Me.Height / 1.25
    PanelPhoto.Width = PanelPhoto.Width / (1.25)
    PanelPhoto.Height = PanelPhoto.Height / (1.25)
  Endif
  
End

Public Sub ButtonLock_Click()

  If $SelectionService <> Null Then
    $SelectionService.ToggleLock($PhotoEntity)
  Endif
  
End


' =============================================================================
'
'          Private methods
'
' =============================================================================

Private Function PhotoId_Read() As Integer
  
  Return $PhotoId
  
End

Private Function IsSelected_Read() As Boolean
  
  Return $IsSelected
  
End

Private Function PhotoEntity_Read() As PhotoEntity
  
  Return $PhotoEntity
  
End

Private Sub RefreshSelectionVisual()
  
  If $IsSelected Then
    PictureBoxPhoto.Background = Color.LightGray
  Else
    PictureBoxPhoto.Background = Color.Transparent
  Endif
  
End

