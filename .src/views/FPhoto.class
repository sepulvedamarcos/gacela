' Gambas class file

Private $cPhoto As PhotoEntity
Private $oPictureBox As PictureBox

Public Sub _new(cPhoto As PhotoEntity)
  $cPhoto = cPhoto

  ButtonSeleccionar.Top = 4
  ButtonSeleccionar.Left = 4

  $oPictureBox = New PictureBox(Me)
  $oPictureBox.X = 0
  $oPictureBox.Y = 0
  $oPictureBox.Width = Me.Width
  $oPictureBox.Height = Me.Height
  $oPictureBox.Padding = 8
  $oPictureBox.Mode = PictureBox.Contain
  $oPictureBox.Expand = True
  $oPictureBox.Alignment = Align.Center
  If cPhoto.HasThumbnail Then
    $oPictureBox.Image = Image.FromString(cPhoto.Thumbnail)
  Else
    $oPictureBox.Image = Image.Load(cPhoto.ImagePath &/ cPhoto.FileName)
  Endif

End


Public Sub Form_Resize()

  Me.Height = Me.Parent.Height
  Me.Width = Me.Parent.Width
  $oPictureBox.Height = Me.Height
  $oPictureBox.Width = Me.Width

End


Public Sub PictureBoxPhoto_Enter()

End

Public Sub PictureBoxPhoto_Leave()

End

Public Sub Form_Enter()

  ButtonSeleccionar.Visible = True
  ButtonSeleccionar.Raise()

End

Public Sub Form_Leave()

  ButtonSeleccionar.Visible = False

End

Public Sub ButtonSeleccionar_Click()

  ' PictureBoxPhoto.Background = Color.Blue
  Form.Refresh

End

