      { Label1 Label
        MoveScaled(1,2,50,3)
        Text = ("Move images to internal repository")
      }
      { SwitchButtonDeleteOriginal SwitchButton
        MoveScaled(53,2,8,4)
      }
      { Label3 Label
        MoveScaled(1,6,51,7)
