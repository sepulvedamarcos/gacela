' Gambas class file

Private $AlbumService As AlbumService
Private $Logger As LoggerPort
Private $SelectedAlbumIds As Integer[]
Private $RowAlbumIds As Integer[]
Private $Titulo As String = "FAlbumSelectionDialog"
Private $LogMessage As LogMessage
Private $Action As Integer

Property Read SelectedAlbumIds As Integer[]

Public Sub _new(oAlbumService As AlbumService, oLogger As LoggerPort, iAction As Integer)
  
  Dim oAlbums As AlbumEntity[]
  
  $AlbumService = oAlbumService
  $Logger = oLogger
  $SelectedAlbumIds = New Integer[]
  $RowAlbumIds = New Integer[]
  $Action = iAction
  
VBoxListAlbums.Visible = True
VBoxManageAlbum.visible = False
Me.Width = VBoxButtons.Width + 10
Me.Height = 410
  
  If iAction = Enumeration.ALBUM_ADD_ACTION Then 
    Me.Text = ("Add selected photos to albums")
  Else If iAction = Enumeration.ALBUM_REMOVE_ACTION Then
    Me.Text = ("Remove selected photos from albums")
  Else 
    Me.text = ("Manage albums")
  Endif
  
  InitializeGrid()
  oAlbums = $AlbumService.FindAlbums("", 0, Constants.USE_SOFT_FALSE)
  BindGrid(oAlbums)
  
  If oAlbums.Count = 0 Then
    LabelTitle.Text = ("No albums available")
    BtnOK.Enabled = False
  Endif
  
  
  
Catch
  $LogMessage = New LogMessage($Titulo, "_new", "Problem loading albums: " & Error.Text)
  If $Logger <> Null Then $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Sub BtnOK_Click()
  
  Dim iRow As Integer
  
  $SelectedAlbumIds = New Integer[]
  
  For iRow = 0 To TableViewAlbums.Rows.Max
    If TableViewAlbums.Rows[iRow].Selected Then
      $SelectedAlbumIds.Add($RowAlbumIds[iRow])
    Endif
  Next
  
  If $SelectedAlbumIds.Count = 0 Then
    Message.Warning(("You must select at least one album"))
    Return
  Endif
  
  Me.Close(Enumeration.DLG_OK)
  
End

Public Sub BtnCancel_Click()
  
  Me.Close(Enumeration.DLG_CANCEL)
  
End

Private Function SelectedAlbumIds_Read() As Integer[]
  
  Dim iId As Integer
  Dim aCopy As New Integer[]
  
  For Each iId In $SelectedAlbumIds
    aCopy.Add(iId)
  Next
  
  Return aCopy
  
End

Private Sub InitializeGrid()
  
  With TableViewAlbums
    .Columns.Count = 2
    .Rows.Count = 0
    .Header = GridView.Horizontal
    ' .Resizable = False
    
    .Columns[0].Text = ("Albums")
    .Columns[0].Alignment = Align.Left
    ' .Columns[0].Width = 60
    .Columns[0].Expand = True
    
    .Columns[1].Text = ("Description")
    .Columns[1].Alignment = Align.Left
    ' .Columns[1].Width = 75
    .Columns[1].Expand = True
    
  End With
  
End

Private Sub BindGrid(oAlbums As AlbumEntity[])
  
  Dim iRow As Integer = 0
  
  $RowAlbumIds = New Integer[]
  For Each oAlbum As AlbumEntity In oAlbums
    iRow = TableViewAlbums.Rows.Count
    TableViewAlbums.Rows.Count = TableViewAlbums.Rows.Count + 1
    TableViewAlbums[iRow, 0].Text = Trim(oAlbum.Name)
    TableViewAlbums[iRow, 1].Text = Trim(oAlbum.Description)
    $RowAlbumIds.Add(oAlbum.Id)
  Next
  
End

Public Sub Form_Open()
  
End

Public Sub ButtonNewAlbum_Click()

VBoxListAlbums.Visible = False
VBoxManageAlbum.visible = True


End


Public Sub BtnOKNew_Click()

  

End

Public Sub BtnCancelNew_Click()

VBoxListAlbums.Visible = True
VBoxManageAlbum.visible = False
  
End
