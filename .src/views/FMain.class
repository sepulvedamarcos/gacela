Private Sub FindPhotoFilterActive()
  
  $LogMessage = New LogMessage($Titulo, "FindPhotoFilterActive()", "Find photo filter was active")
  $Logger.Info($LogMessage)
  
  If SearchByMenu_Album.Value Then
    $LogMessage = New LogMessage($Titulo, "FindPhotoFilterActive()", ("no implemented yet SearchByMenu_Album.Value"))
    $Logger.Warning($LogMessage)
    
  Else If SearchByMenu_PhotoName.Value Then
    $LogMessage = New LogMessage($Titulo, "FindPhotoFilterActive()", ("no implemented yet SearchByMenu_PhotoName.Value"))
    $Logger.Warning($LogMessage)
    
  Else If SearchByMenu_Description.Value Then
    $LogMessage = New LogMessage($Titulo, "FindPhotoFilterActive()", ("no implemented yet SearchByMenu_Description.Value"))
    $Logger.Warning($LogMessage)
    
  Else If SearchByMenu_Date.value Then
    $LogMessage = New LogMessage($Titulo, "FindPhotoFilterActive()", ("no implemented yet SearchByMenu_Date.value"))
    $Logger.Warning($LogMessage)
    
  Else If SearchByMenu_Tag.value Then
    $LogMessage = New LogMessage($Titulo, "FindPhotoFilterActive()", ("no implemented yet SearchByMenu_Tag.value"))
    $Logger.Warning($LogMessage)
    
  Endif
  
End

Private Sub MoveSelectedImagesToTrashDirectory() '' Method move images to trash directory
  
  Dim oSelected As PhotoEntity[]
  Dim oSummary As FSummary
  Dim eSummary As Summary
  Dim oProgress As FProgressBar
  Dim oFQuestion As FQuestion
  Dim sTitle, sText As String
  Dim isConfirmed As Boolean = True
  Dim oQuestionService As QuestionInteractionService
  
  $LogMessage = New LogMessage($Titulo, "MoveSelectedImagesToTrashDirectory", "Move selected images to trash")
  $Logger.Info($LogMessage)
  
  oQuestionService = New QuestionInteractionService($Logger)
  
  ' 1. El SERVICIO decide si la UI debe actuar (Lógica de negocio en el core)
  If oQuestionService.ShouldAsk($Configuration, Constants.ASKBEFORE_MOVETRASH) Then
    
    sTitle = ("Move images to trash")
    sText = ("Are you sure you want to move the selected photos to trash directory")
    
    ' 2. El FORMULARIO orquestra la interacción (Capa de Vista)
    oFQuestion = New FQuestion(oQuestionService, $Logger, sTitle, sText)
    If oFQuestion.ShowModal() = Enumeration.DLG_OK Then
      
      ' 3. El SERVICIO guarda la decisión capturada por la UI (DRY/Persistencia)
      oQuestionService.SaveUserDecision($Configuration, Constants.ASKBEFORE_MOVETRASH, oQuestionService.ShouldNotShowAgain)
      isConfirmed = True
    Else
      isConfirmed = False
    Endif
    
  Endif
  
  ' 4. Continuamos si hay confirmación (ya sea por el usuario o por decisión automática del servicio)
  If isConfirmed Then
    oSelected = $PhotoSelectionService.GetSelectedEntities()
    If oSelected.Count = 0 Then
      Message.Warning(("No images selected"))
      Return
    Endif
    
    oProgress = New FProgressBar($PhotoService, ("Moving images to trash"))
    oProgress.Show()
    Wait 0.05
    
    eSummary = $PhotoService.MoveToTrash(oSelected)
    
    oProgress.Close()
    
    ReloadGallery()
    
    ShowStatus(("Move to trash has finished. OK: ") & eSummary.OkCount & (" and NOK: ") & eSummary.FailCount, 5000)
    If $Configuration.ShouldShowMoveToTrashSummary Then
      oSummary = New FSummary(eSummary, $Logger, $Configuration, Enumeration.DIALOG_SUMMARY_TRASH)
      oSummary.ShowModal()
    Endif
    
  Endif
  
End

Private Sub LoadEnvironment()
  
  HBoxToolBar.Visible = $Configuration.ShouldShowMainToolbar
  HBoxStatusBar.Visible = $Configuration.ShouldShowMainStatusBar
  SliderZoomer.MaxValue = $MaxAmplifier
  SliderZoomer.MinValue = 1
  SliderZoomer.Value = 1
  
End

Private Sub ZoomIn()
  
  Dim oPanel As FPhoto
  
  If $Amplifier < $MaxAmplifier Then
    $Amplifier += 1
    
    If SliderZoomer.Value <> $Amplifier Then SliderZoomer.Value = $Amplifier
    
    For Each oPanel In PanelGalleryContent.Children
      If oPanel Is FPhoto Then
        oPanel.ResizeScaledForm(1)
      Endif
    Next
  Endif
  
End

Private Sub ZoomOut()
  
  Dim oPanel As FPhoto
  
  If $Amplifier > 1 Then
    $Amplifier -= 1
    
    If SliderZoomer.Value <> $Amplifier Then SliderZoomer.Value = $Amplifier
    
    For Each oPanel In PanelGalleryContent.Children
      If oPanel Is FPhoto Then
        oPanel.ResizeScaledForm(-1)
      Endif
    Next
  Endif
  
End

Public Sub SliderZoomer_Drag()
  
  ApplyZoom()
  
End

Public Sub SliderZoomer_Change()
  
  ApplyZoom()
  
End

Public Sub SliderZoomer_MouseDrag()
  
  ApplyZoom()
  
End

Private Sub ApplyZoom()
  
  Dim iTarget As Integer = SliderZoomer.Value
  
  If $IsZooming Then Return
  If $Amplifier = iTarget Then Return
  
  $IsZooming = True
  
  While $Amplifier < iTarget
    ZoomIn()
  Wend
  
  While $Amplifier > iTarget
    ZoomOut()
  Wend
  
  $IsZooming = False
  
End

Public Sub EditMenu_Share_Click()
  
  ExecuteSharing(True)
  
End

Public Sub EditMenu_Unshare_Click()
  
  ExecuteSharing(False)
  
End

Public Sub EditMenu_Lock_Click()
  
  LockSelectedImages(True)
  
End

Public Sub EditMenu_Unlock_Click()
  
  LockSelectedImages(False)
  
End

Private Sub LockSelectedImages(bIsLocked As Boolean, Optional aManualSelected As PhotoEntity[]) '' Orchestrates the lock/unlock process
  
  Dim oSelected As PhotoEntity[]
  Dim oSummary As FSummary
  Dim eSummary As Summary
  Dim oProgress As FProgressBar
  Dim oFQuestion As FQuestion
  Dim sTitle, sText As String
  Dim isConfirmed As Boolean = True
  Dim oQuestionService As QuestionInteractionService
  
  $LogMessage = New LogMessage($Titulo, "LockSelectedImages", "Updating lock status: " & bIsLocked)
  $Logger.Info($LogMessage)
  
  oQuestionService = New QuestionInteractionService($Logger)
  
  ' 1. Check if we should ask for confirmation
  If oQuestionService.ShouldAsk($Configuration, Constants.ASKBEFORE_LOCK) Then
    
    sTitle = IIf(bIsLocked, ("Lock images"), ("Unlock images"))
    sText = IIf(bIsLocked, ("Are you sure you want to LOCK the selected photos? They cannot be permanently deleted while locked."), ("Are you sure you want to UNLOCK the selected photos?"))
    
    oFQuestion = New FQuestion(oQuestionService, $Logger, sTitle, sText)
    if oFQuestion.ShowModal() = Enumeration.DLG_OK Then
      oQuestionService.SaveUserDecision($Configuration, Constants.ASKBEFORE_LOCK, oQuestionService.ShouldNotShowAgain)
      isConfirmed = True
    Else
      isConfirmed = False
    Endif
  Endif
  
  If isConfirmed Then
    If aManualSelected <> Null Then
      oSelected = aManualSelected
    Else
      oSelected = $PhotoSelectionService.GetSelectedEntities()
    Endif
    
    If oSelected.Count = 0 Then
      Message.Warning(("No images selected"))
      Return
    Endif
    
    oProgress = New FProgressBar($PhotoService, IIf(bIsLocked, ("Locking images"), ("Unlocking images")))
    oProgress.Show()
    Wait 0.05
    
    eSummary = $PhotoService.UpdateLockStatus(oSelected, bIsLocked)
    
    oProgress.Close()
    
    ReloadGallery()
    
    ShowStatus(IIf(bIsLocked, ("Locking finished. OK: "), ("Unlocking finished. OK: ")) & eSummary.OkCount & (" and NOK: ") & eSummary.FailCount, 5000)
    
    If $Configuration.ShouldShowLockSummary And If(aManualSelected <> Null, aManualSelected.Count > 1, $PhotoSelectionService.SelectedCount > 1) Then
      oSummary = New FSummary(eSummary, $Logger, $Configuration, Enumeration.DIALOG_SUMMARY_LOCK)
      oSummary.ShowModal()
    Endif
  Endif
  
End

Private Sub ExecuteSharing(bToShared As Boolean)
  
  Dim oSharingService As PhotoSharingService
  Dim oProgress As FProgressBar
  Dim oSummary As Summary
  Dim sTitle As String = If(bToShared, ("Sharing selected images"), ("Unsharing selected images"))
  
  If Message.Question(If(bToShared, ("Are you sure you want to SHARE the selected images? They will be moved to the shared gallery."), ("Are you sure you want to UNSHARE the selected images? They will be moved back to your private gallery.")), ("Yes"), ("No")) <> 1 Then Return
  
  oSharingService = New PhotoSharingService($PhotoService, $Configuration, $Logger)
  oProgress = New FProgressBar(oSharingService, sTitle)
  
  oSummary = oSharingService.Execute($PhotoSelectionService.GetSelectedEntities(), bToShared)
  
  oProgress.Close()
  
  If oSummary <> Null Then
    Dim oSummaryDialog As New FSummary(oSummary, $Logger, $Configuration, Enumeration.DIALOG_SUMMARY_SHARE)
    oSummaryDialog.ShowModal()
  Endif
  
  $PhotoSelectionService.Clear()
  ReloadGallery()
  
End
