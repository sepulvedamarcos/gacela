Public Sub AlbumRadio_Click()
  
  Dim oRadio As RadioButton
  Dim iAlbumId As Integer
  
  For Each oRadio In $AlbumPanel.Children
    If oRadio.Value = True Then
      iAlbumId = oRadio.Tag
      $PhotoService.SetAlbumFilter(iAlbumId)
      ReloadGallery()
      Return
    Endif
  Next
  
End

