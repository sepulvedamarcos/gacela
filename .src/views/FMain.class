Private Function LastImportSummary_Read() As Summary
  
  Return $LastImportSummary
  
End

Private Sub LastImportSummary_Write(Value As Summary)
  
  $LastImportSummary = Value
  
End

Private Sub UpdateSelectionActions(Optional iCount As Integer = -1, Optional bHasSelection As Boolean = False)
  
  If iCount < 0 Then
    If $PhotoSelectionService = Null Then
      iCount = 0
      bHasSelection = False
    Else
      iCount = $PhotoSelectionService.SelectedCount
      bHasSelection = $PhotoSelectionService.HasSelection()
    Endif
  Endif
  
  If $IsViewingTrash Then
    EditMenu_TrashOut.Enabled = bHasSelection
  Else
    EditMenu_Trash.Enabled = bHasSelection
    EditMenu_AddSelectedToAlbums.Enabled = bHasSelection
    EditMenu_RemoveSelectedFromAlbums.Enabled = bHasSelection
    EditMenu_Share.Enabled = bHasSelection And $Configuration.WhichGallery = Enumeration.GalleryType_Private
    EditMenu_Unshare.Enabled = bHasSelection And $Configuration.WhichGallery = Enumeration.GalleryType_Shared
    EditMenu_Lock.Enabled = bHasSelection
    EditMenu_Unlock.Enabled = bHasSelection
    
    ToolButtonTrash.Enabled = bHasSelection
  Endif
  
End

Private Sub AssignSelectedPhotosToAlbums(bIsAddOperation As Boolean)
  
  Dim oDialog As FAlbumSelection
  Dim oSelectionAlbum As AlbumSelectionService
  Dim aPhotoIds As Integer[]
  Dim aAlbumIds As Integer[]
  Dim iAffected As Integer
  Dim oSelectedAlbums As AlbumEntity[]
  
  If $PhotoSelectionService = Null Or Not $PhotoSelectionService.HasSelection() Then
    Message.Warning(("You must select at least one photo"))
    Return
  Endif
  
  oSelectionAlbum = New AlbumSelectionService
  
  If bIsAddOperation Then
    oDialog = New FAlbumSelection($AlbumService, $Logger, oSelectionAlbum, Enumeration.ALBUM_ADD_ACTION)
  Else
    oDialog = New FAlbumSelection($AlbumService, $Logger, oSelectionAlbum, Enumeration.ALBUM_REMOVE_ACTION)
  Endif
  
  If oDialog.ShowModal() <> Enumeration.DLG_OK Then Return
  
  aPhotoIds = $PhotoSelectionService.GetSelectedIds()
  oSelectedAlbums = oSelectionAlbum.GetSelectedAlbumEntities()
  
  aAlbumIds = New Integer[]
  For Each oAlbum As AlbumEntity In oSelectedAlbums
    aAlbumIds.Add(oAlbum.Id)
  Next
  
  If bIsAddOperation Then
    iAffected = $AlbumService.AddPhotosToAlbums(aPhotoIds, aAlbumIds)
    ShowStatus(("Relations created: ") & iAffected, 3500)
  Else
    iAffected = $AlbumService.RemovePhotosFromAlbums(aPhotoIds, aAlbumIds)
    ShowStatus(("Relations removed: ") & iAffected, 3500)
  Endif
  
  ClearSelectedPhotos()
  ReloadGallery()
  ReloadAlbums()
  
End

