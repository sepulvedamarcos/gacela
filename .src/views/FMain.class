Public Sub ShowStatus(sMessage As String, Optional iTimeoutMs As Integer = 2500)

  If $StatusDefaultText = "" Then
    $StatusDefaultText = LabelStatusBar.Text
  Endif

  LabelStatusBar.Text = sMessage

  StatusTimer.Stop()
  If iTimeoutMs > 0 Then
    StatusTimer.Delay = iTimeoutMs
    StatusTimer.Start()
  Endif

End

Public Sub ToolButtonViewTrash_Click()

  ShowStatus(("Open deleted images folder"), 0)

End

Public Sub AlbumRadio_Click()

  Dim oRadio As RadioButton
  Dim iAlbumId As Integer

  For Each oRadio In $AlbumPanel.Children
    If oRadio.Value = True Then
      iAlbumId = oRadio.Tag
      $PhotoService.SetAlbumFilter(iAlbumId)
      ReloadGallery()
      Return
    Endif
  Next

End

Public Sub SelectionService_SelectionChanged(iCount As Integer, bHasSelection As Boolean)

  UpdateSelectionActions(iCount, bHasSelection)

End

Public Sub SelectAllPhotos()

  Dim oCtrl As Control
  Dim oPhoto As FPhoto

  For Each oCtrl In PanelGalleryContent.Children
    If oCtrl Is FPhoto Then
      oPhoto = oCtrl
      oPhoto.SetSelected(True)
    Endif
  Next

End

Public Sub ClearSelectedPhotos()

  Dim oCtrl As Control
  Dim oPhoto As FPhoto

  For Each oCtrl In PanelGalleryContent.Children
    If oCtrl Is FPhoto Then
      oPhoto = oCtrl
      oPhoto.SetSelected(False)
    Endif
  Next

End

