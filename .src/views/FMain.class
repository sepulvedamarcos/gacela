Public Sub SelectionService_DeleteRequested(oPhoto As PhotoEntity)
  
  Dim oSummary As Summary
  Dim iResp As Integer
  Dim sMsg As String
  
  sMsg = ("Are you sure you want to PERMANENTLY delete this photo?")
  sMsg &= "\n\n" & oPhoto.FileName
  sMsg &= "\n\n" & ("This action cannot be undone.")
  
  If Message.Question(sMsg, ("Delete Permanently"), ("Cancel")) <> 1 Then Return
  
  oSummary = $PhotoService.PermanentlyDelete([oPhoto])
  
  If oSummary.HasErrors() Then
    FSummary.ShowSummary(oSummary, ("Permanent Delete Results"))
  Else
    ' Just for visual confirmation if it's only one
    ' Message.Info(("Deleted successfully"))
  Endif
  
  ' Refresh the view to reflect the deletion
  $PhotoSelectionService.Clear()
  ClearPhotoGallery()
  CreatePhotoPanels($PhotoService.LoadFirstPage())
  
End

