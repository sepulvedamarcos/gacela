Private Sub UpdateTrashCount()
  
  Dim iCount As Integer = $PhotoService.GetTrashCount()
  
  ToolButtonViewTrash.Tooltip = ("Total deleted images in folder") & " (" & iCount & ")"
  
End

Private Sub ReloadTrash()
  
  $IsViewingTrash = True
  $TrashPage = 0
  
  If $PhotoSelectionService <> Null Then
    $PhotoSelectionService.Clear()
  Endif
  
  ClearPhotoGallery()
  CreatePhotoPanels($PhotoService.LoadTrashPage($TrashPage))
  
End

Private Sub RestoreSelectedImagesFromTrash() '' Method to restore images from trash
  
  Dim oSelected As PhotoEntity[]
  Dim oSummary As Summary
  Dim oProgress As FProgressBar
  
  $LogMessage = New LogMessage($Titulo, "RestoreSelectedImagesFromTrash", "Restoring selected images")
  $Logger.Info($LogMessage)
  
  oSelected = $PhotoSelectionService.GetSelectedEntities()
  If oSelected.Count = 0 Then
    Message.Warning(("No images selected to restore"))
    Return
  Endif
  
  oProgress = New FProgressBar($PhotoService, ("Restoring images"))
  oProgress.Show()
  Wait 0.05
  
  oSummary = $PhotoService.RestoreFromTrash(oSelected)
  
  oProgress.Close()
  
  UpdateTrashCount()
  ReloadTrash() ' Refresh trash view
  
  ShowStatus(("Restore finished. OK: ") & oSummary.OkCount & (" and NOK: ") & oSummary.FailCount, 5000)
  
End

Private Sub CreatePhotoPanels(photos As PhotoEntity[])
  
  Dim oFPhoto As FPhoto
  Dim i As Integer
  
  $LogMessage = New LogMessage($Titulo, "CreatePhotoPanels", "Creating initial panels")
  $Logger.Info($LogMessage)
  
  For Each cPhoto As PhotoEntity In photos
    oFPhoto = New FPhoto($PhotoSelectionService, cPhoto, PanelGalleryContent)
    For i = 1 To $Amplifier
      oFPhoto.ResizeScaledForm(1)
    Next
    oFPhoto.Show()
  Next
  
End

Private Sub ClearPhotoGallery()
  
  ' Destroy all controls
  For Each ctrl As Control In PanelGalleryContent.Children
    ctrl.Delete()
  Next
  
End

Private Sub ImportProcess(Optional listFiles As String[]) '' Import images process
  
  Dim iResp As Integer
  Dim oSelector As FImport
  Dim oImportSummary As FSummary
  Dim oProgress As FProgressBar
  Dim oImportSelection As New PhotoImportSelectionService
  
  If listFiles <> Null Then
    oImportSelection.SetPaths(listFiles)
  Endif
  
  oSelector = New FImport(Me, $PhotoService, $AlbumService, $Logger, oImportSelection, $Configuration)
  iResp = oSelector.ShowModal()
  
  If iResp = Enumeration.DLG_OK Then
    
    oProgress = New FProgressBar($PhotoService, ("Import images"))
    oProgress.Show()
    Wait 0.05
    
    $LastImportSummary = $PhotoService.ImportPhotos(oImportSelection.SelectedPaths, oImportSelection.SelectedAlbumId)
    
    oProgress.Close()
    
    ReloadGallery()
    If $LastImportSummary <> Null Then
      ShowStatus(("Import finished. OK: ") & $LastImportSummary.OkCount & (" NOK: ") & $LastImportSummary.FailCount, 5000)
      If $Configuration.ImportShowSummary Then
        oImportSummary = New FSummary($LastImportSummary, $Logger, $Configuration, Enumeration.DIALOG_SUMMARY_IMPORT)
        oImportSummary.ShowModal()
      Endif
    Endif
    ReloadAlbums()
  Endif
  
End

Private Sub SelectGallery(iGallery As Integer)
  
  Select Case iGallery
    Case Enumeration.GalleryType_Private
      
      GalleryMenu_PrivateGallery.Value = True
      GalleryMenu_ShareGallery.Value = False
      
      MenuButtonCollection.Picture = GalleryMenu_PrivateGallery.Picture
      MenuButtonCollection.Text = GalleryMenu_PrivateGallery.Text
      
      $IsViewingTrash = False
      $SelectedGallery = iGallery
      $PhotoService.ToggleGallery(iGallery)
      ReloadGallery()
      
    Case Enumeration.GalleryType_Shared
      
      GalleryMenu_PrivateGallery.Value = False
      GalleryMenu_ShareGallery.Value = True
      
      MenuButtonCollection.Picture = GalleryMenu_ShareGallery.Picture
      MenuButtonCollection.Text = GalleryMenu_ShareGallery.Text
      
      $IsViewingTrash = False
      $SelectedGallery = iGallery
      $PhotoService.ToggleGallery(iGallery)
      ReloadGallery()
      
    Case Enumeration.GalleryType_Trash
      
      $IsViewingTrash = True
      ReloadTrash()
      
  End Select
  
End

Private Sub ReloadGallery()
  
  If $PhotoSelectionService <> Null Then
    $PhotoSelectionService.Clear()
  Endif
  
  ClearPhotoGallery()
  CreatePhotoPanels($PhotoService.LoadFirstPage())
  UpdateTrashCount()
  
End

Private Sub ReloadAlbums()
  
  ClearAlbumExpander()
  AddAlbumExpander()
  
End

Private Sub ShowConfigurationPanel()
  
  Dim oForm As FConfiguration
  
  oForm = New FConfiguration($Logger, $Configuration)
  oForm.ShowModal()
  
End

Private Sub StatusTimer_Timer()
  
  StatusTimer.Stop()
  LabelStatusBar.Text = $StatusDefaultText
  
End

Private Function LastImportSummary_Read() As Summary
  
  Return $LastImportSummary
  
End

Private Sub LastImportSummary_Write(Value As Summary)
  
  $LastImportSummary = Value
  
End

Private Sub AddAlbumExpander()
  
  Dim oCKAlbum As RadioButton
  Dim iHeight As Integer = 28
  Dim oAlbums As AlbumEntity[]
  
  ExpanderAlbum.Hidden = False
  Wait 0.5
  
  $AlbumPanel = New Panel(ExpanderAlbum)
  $AlbumPanel.Arrangement = Arrange.Vertical
  $AlbumPanel.Width = ExpanderAlbum.Width
  $AlbumPanel.Background = Color.Royal
  
  oCKAlbum = New RadioButton($AlbumPanel) As "AlbumRadio"
  oCKAlbum.Text = ("Todos")
  oCKAlbum.Tag = 0
  oCKAlbum.Height = 28
  oCKAlbum.Width = $AlbumPanel.Width
  oCKAlbum.Value = True
  
  $AlbumPanel.Height = $AlbumPanel.Height + iHeight
  iHeight = iHeight + 28
  
  oAlbums = $AlbumService.FindAlbums()
  For Each oAlbum As AlbumEntity In oAlbums
    
    oCKAlbum = New RadioButton($AlbumPanel) As "AlbumRadio"
    oCKAlbum.Text = oAlbum.Name
    oCKAlbum.Tag = oAlbum.Id
    ' oCKAlbum.Background = Color.Red
    oCKAlbum.Height = 28
    oCKAlbum.Width = $AlbumPanel.Width
    
    $AlbumPanel.Height = $AlbumPanel.Height + iHeight
    iHeight = iHeight + 28
  Next
  
  ExpanderAlbum.Arrangement = Arrange.Fill
  ExpanderAlbum.Height = iHeight
  ExpanderAlbum.Hidden = True
  
End

Private Sub ClearAlbumExpander()
  
  If $AlbumPanel = Null Then Return
  
  For Each ctrl As Control In $AlbumPanel.Children
    ctrl.Delete()
  Next
  $AlbumPanel.Delete()
  $AlbumPanel = Null
  
End

Private Sub UpdateSelectionActions(Optional iCount As Integer = -1, Optional bHasSelection As Boolean = False)
  
  If iCount < 0 Then
    If $PhotoSelectionService = Null Then
      iCount = 0
      bHasSelection = False
    Else
      iCount = $PhotoSelectionService.SelectedCount
      bHasSelection = $PhotoSelectionService.HasSelection()
    Endif
  Endif
  
  If $IsViewingTrash Then
    EditMenu_TrashOut.Enabled = bHasSelection
  Else
    EditMenu_Trash.Enabled = bHasSelection
    EditMenu_AddSelectedToAlbums.Enabled = bHasSelection
    EditMenu_RemoveSelectedFromAlbums.Enabled = bHasSelection
    
    ToolButtonTrash.Enabled = bHasSelection
  Endif
  
End

Private Sub AssignSelectedPhotosToAlbums(bIsAddOperation As Boolean)
  
  Dim oDialog As FAlbumSelection
  Dim oSelectionAlbum As AlbumSelectionService
  Dim aPhotoIds As Integer[]
  Dim aAlbumIds As Integer[]
  Dim iAffected As Integer
  Dim oSelectedAlbums As AlbumEntity[]
  
  If $PhotoSelectionService = Null Or Not $PhotoSelectionService.HasSelection() Then
    Message.Warning(("You must select at least one photo"))
    Return
  Endif
  
  oSelectionAlbum = New AlbumSelectionService
  
  If bIsAddOperation Then
    oDialog = New FAlbumSelection($AlbumService, $Logger, oSelectionAlbum, Enumeration.ALBUM_ADD_ACTION)
  Else
    oDialog = New FAlbumSelection($AlbumService, $Logger, oSelectionAlbum, Enumeration.ALBUM_REMOVE_ACTION)
  Endif
  
  If oDialog.ShowModal() <> Enumeration.DLG_OK Then Return
  
  aPhotoIds = $PhotoSelectionService.GetSelectedIds()
  oSelectedAlbums = oSelectionAlbum.GetSelectedAlbumEntities()
  
  aAlbumIds = New Integer[]
  For Each oAlbum As AlbumEntity In oSelectedAlbums
    aAlbumIds.Add(oAlbum.Id)
  Next
  
  If bIsAddOperation Then
    iAffected = $AlbumService.AddPhotosToAlbums(aPhotoIds, aAlbumIds)
    ShowStatus(("Relations created: ") & iAffected, 3500)
  Else
    iAffected = $AlbumService.RemovePhotosFromAlbums(aPhotoIds, aAlbumIds)
    ShowStatus(("Relations removed: ") & iAffected, 3500)
  Endif
  
  ClearSelectedPhotos()
  ReloadGallery()
  ReloadAlbums()
  
End

Private Sub ShowAlbumManager()
  
  Dim oDialog As FAlbumSelection
  Dim oAlbumSelection As AlbumSelectionService
  
  oAlbumSelection = New AlbumSelectionService
  oDialog = New FAlbumSelection($AlbumService, $Logger, oAlbumSelection, Enumeration.ALBUM_MANAGE_ACTION)
  oDialog.ShowModal()
  
End

