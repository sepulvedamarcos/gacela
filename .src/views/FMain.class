Public Sub ShowStatus(sMessage As String, Optional iTimeoutMs As Integer = 2500)
  
  If $StatusDefaultText = "" Then
    $StatusDefaultText = LabelStatusBar.Text
  Endif
  
  LabelStatusBar.Text = sMessage
  
  StatusTimer.Stop()
  If iTimeoutMs > 0 Then
    StatusTimer.Delay = iTimeoutMs
    StatusTimer.Start()
  Endif
  
End

Public Sub ToolButtonViewTrash_Click()
  
  $IsViewingTrash = Not $IsViewingTrash
  
  If $IsViewingTrash Then
    ShowStatus(("Viewing deleted images"), 0)
    ToolButtonViewTrash.Tooltip = ("Return to gallery")
    ToolButtonViewTrash.Picture = Picture["icon:/22/folder-home"]
    ReloadTrash()
  Else
    ShowStatus(("Viewing main gallery"), 0)
    ToolButtonViewTrash.Tooltip = ("Open deleted images folder")
    ToolButtonViewTrash.Picture = Picture["icon:/22/trash"]
    ReloadGallery()
  Endif
  
End

