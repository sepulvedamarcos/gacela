Public Sub PanelGalleryContent_Scroll()
  
  Dim fScrollPos As Float
  Dim fScrollMax As Float
  Dim fThreshold As Float = 0.8  ' 80% of scroll
  Dim aNewPhotos As PhotoEntity[]
  
  ' Calculate scroll position (0.0 to 1.0)
  fScrollMax = PanelGalleryContent.ScrollHeight - PanelGalleryContent.ClientHeight
  
  If fScrollMax <= 0 Then Return
  
  fScrollPos = PanelGalleryContent.ScrollY / fScrollMax
  
  ' If it reached 80% and not loading, load more
  If fScrollPos >= fThreshold Then
    If $IsViewingTrash Then
      $TrashPage += 1
      aNewPhotos = $PhotoService.LoadTrashPage($TrashPage)
    Else
      aNewPhotos = $PhotoService.LoadNextPage()
    Endif
    
    If aNewPhotos.Count > 0 Then
      CreatePhotoPanels(aNewPhotos)
    End If
  Endif
  
End

