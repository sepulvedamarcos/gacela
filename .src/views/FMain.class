' Gambas class file

Private $Width As Integer = 160
Private $Height As Integer = 90

Private $Configuration As Configuration
Private $Log4Gambas As Log4Gambas3
Private $PhotoService As PhotoService
Private $Titulo As String = "[FMain] "
Private $StatusDefaultText As String
Private StatusTimer As Timer
Private $LastImportSummary As ImportSummary

Public Sub _new(cConfiguration As Configuration, oLogger As Log4Gambas3, cPhotoService As PhotoService)
  
  $Configuration = cConfiguration
  $Log4Gambas = oLogger
  $PhotoService = cPhotoService
  
End

Public Sub Form_Open()
  
  $Log4Gambas.Debug(LogPrefix("Form_Open") & "On form open we load photo records")
  
  SelectGallery($Configuration.WhichGallery)
  
  ExpanderAlbum.Hidden = True
  ExpanderTags.Hidden = True
  
  $StatusDefaultText = LabelStatusBar.Text
  StatusTimer = New Timer
  StatusTimer.Enabled = False
  
End

Public Sub Form_Drop()
  
  Dim aFilesDrop As String[]
  Dim sFileDrop As String
  Dim sNamesErr As String
  
  $Log4Gambas.Debug(LogPrefix("Form_Drop") & "Drag and drop files")
  
  aFilesDrop = Drag.Paste("text/uri-list")
  For Each sFileDrop In aFilesDrop
    $Log4Gambas.Debug(LogPrefix("Form_Drop") & "file: [" & File.BaseName(sFileDrop) & "." & File.Ext(sFileDrop) & "]")
    If LCase(File.Ext(sFileDrop)) = "jpg" Or LCase(File.Ext(sFileDrop)) = "png" Then
    Else
      sNamesErr = sNamesErr & File.BaseName(sFileDrop) & "." & File.Ext(sFileDrop)
    Endif
  Next
  
  If sNamesErr = "" Then
    ImportProcess(aFilesDrop)
  Else
    Message.Error(("Some of the files you are trying to import are not valid"))
  Endif
  
End

Public Sub ButtonZoomIn_Click()
  
  Dim vPane As Variant
  
  For Each vPane In PanelGalleryContent.Children
    vPane.Width = vPane.Width * 1.25
    vPane.Height = vPane.Height * 1.25
  Next
  
End

Public Sub ButtonZoomOut_Click()
  
  Dim vPane As Variant
  
  For Each vPane In PanelGalleryContent.Children
    vPane.Width = vPane.Width / 1.25
    vPane.Height = vPane.Height / 1.25
  Next
  
End

Public Sub PanelGalleryContent_Scroll()
  
  Dim fScrollPos As Float
  Dim fScrollMax As Float
  Dim fThreshold As Float = 0.8  ' 80% of scroll
  Dim aNewPhotos As PhotoEntity[]
  
  ' Calculate scroll position (0.0 to 1.0)
  fScrollMax = PanelGalleryContent.ScrollHeight - PanelGalleryContent.ClientHeight
  
  If fScrollMax <= 0 Then Return
  
  fScrollPos = PanelGalleryContent.ScrollY / fScrollMax
  
  ' If it reached 80% and not loading, load more
  If fScrollPos >= fThreshold Then
    aNewPhotos = $PhotoService.LoadNextPage()
    If aNewPhotos.Count > 0 Then
      CreatePhotoPanels(aNewPhotos)
    End If
  Endif
  
End

Public Sub ViewGallery_Exit_Click()
  
  Me.Close
  
End

Public Sub ToolButtonExit_Click()
  
  Me.Close
  
End

Public Sub ViewGallery_ShareCollection_Click()
  
  SelectGallery(Enumeration.GalleryType_Shared)
  
End

Public Sub ViewGallery_PrivateCollection_Click()
  
  SelectGallery(Enumeration.GalleryType_Private)
  
End

Public Sub CollectionToolMenu_Private_Click()
  
  SelectGallery(Enumeration.GalleryType_Private)
  
End

Public Sub CollectionToolMenu_Share_Click()
  
  SelectGallery(Enumeration.GalleryType_Shared)
  
End

Public Sub ViewGallery_ImportImages_Click()
  
  ImportProcess()
  
End

Public Sub ToolButtonImport_Click()
  
  ImportProcess()
  
End

Public Sub HelpMenu_About_Click()
  
  FAbout.ShowDialog
  
End

Public Sub ToolButtonConfiguration_Click()
  
  ShowConfigurationPanel
  
End

Public Sub OptionsMenu_Configuration_Click()
  
  ShowConfigurationPanel
  
End

Public Sub ToolButtonTrash_Enter()
  
  ShowStatus(("View deleted images"), 0)
  
End

Public Sub ToolButtonTrash_Leave()
  
  ShowStatus("", 0)
  
End

Public Sub ShowStatus(sMessage As String, Optional iTimeoutMs As Integer = 2500)
  
  If $StatusDefaultText = "" Then
    $StatusDefaultText = LabelStatusBar.Text
  Endif
  
  LabelStatusBar.Text = sMessage
  
  StatusTimer.Stop()
  If iTimeoutMs > 0 Then
    StatusTimer.Delay = iTimeoutMs
    StatusTimer.Start()
  Endif
  
End

Public Sub ToolButtonTrash_Click()

  ShowStatus(("Open deleted images folder"), 0)

End


' ==================================================
'
'          Private methods
'
' ==================================================

Private Sub CreatePhotoPanels(photos As PhotoEntity[])
  
  Dim oPanelPhoto As Panel
  Dim cFormPhoto As FPhoto
  Dim cPhoto As PhotoEntity
  
  $Log4Gambas.Info("Creating initial panels")
  For Each cPhoto In photos
    oPanelPhoto = New Panel(PanelGalleryContent)
    oPanelPhoto.Width = $Width
    oPanelPhoto.Height = $Height
    oPanelPhoto.Border = Border.Plain
    oPanelPhoto.Arrangement = Arrange.Fill
    oPanelPhoto.Tag = cPhoto.Id
    
    cFormPhoto = New FPhoto(cPhoto, oPanelPhoto)
    cFormPhoto.Width = $Width
    cFormPhoto.Height = $Height
    
    oPanelPhoto.Show()
  Next
  
End

Private Sub ClearPhotoGallery()
  
  ' Destroy all controls
  For Each ctrl As Control In PanelGalleryContent.Children
    ctrl.Delete()
  Next
  
End

Private Sub ImportProcess(Optional listFiles As String[])
  
  Dim vResp As Variant
  Dim cSelector As FImportDialog
  
  cSelector = New FImportDialog($PhotoService, $Log4Gambas, listFiles)
  vResp = cSelector.ShowModal()
  
  If vResp = Enumeration.DLG_OK Then
    ReloadGallery()
    If cSelector.ImportSummary <> Null Then
      $LastImportSummary = cSelector.ImportSummary
      ShowStatus(("Import finished. OK: ") & $LastImportSummary.OkCount & (" NOK: ") & $LastImportSummary.FailCount, 5000)
      If $Configuration.ImportShowSummary Then
        Dim oImportResume As FImportResume
        oImportResume = New FImportResume($LastImportSummary, $Log4Gambas, $Configuration)
        oImportResume.ShowModal()
      Endif
    Endif
    ' ClearPhotoGallery()
    ' CreatePhotoPanels($PhotoService.LoadNextPage())
    'FIXME: At the end of the process, write to the status bar and allow a click to open the import event
    'TODO: ideally the status bar would keep a history like a log
    'FIXME: for now, the import summary window will be opened here
    ' fImportR = New FImportResume(1)
  Endif
  
End

Private Sub SelectGallery(iGallery As Integer)
  
  Select Case iGallery
    Case Enumeration.GalleryType_Private
      CollectionToolMenu_Private.Value = True
      CollectionToolMenu_Share.Value = False
      ViewGallery_PrivateCollection.Value = CollectionToolMenu_Private.Value
      ViewGallery_ShareCollection.Value = CollectionToolMenu_Share.Value
      
      MenuButtonCollection.Picture = CollectionToolMenu_Private.Picture
      MenuButtonCollection.Text = CollectionToolMenu_Private.Text
      
    Case Enumeration.GalleryType_Shared
      CollectionToolMenu_Private.Value = False
      CollectionToolMenu_Share.Value = True
      ViewGallery_PrivateCollection.Value = CollectionToolMenu_Private.Value
      ViewGallery_ShareCollection.Value = CollectionToolMenu_Share.Value
      
      MenuButtonCollection.Picture = CollectionToolMenu_Share.Picture
      MenuButtonCollection.Text = CollectionToolMenu_Share.Text
      
  End Select
  
  $PhotoService.ToggleGallery(iGallery)
  ReloadGallery()
  
End

Private Sub ReloadGallery()
  
  ClearPhotoGallery()
  
  CreatePhotoPanels($PhotoService.LoadFirstPage())
  
End

Private Sub ShowConfigurationPanel()
  
  Dim oForm As FConfiguration
  
  oForm = New FConfiguration($Log4Gambas, $Configuration)
  oForm.ShowModal()
  
End

Private Sub StatusTimer_Timer()
  
  StatusTimer.Stop()
  LabelStatusBar.Text = $StatusDefaultText
  
End

Private Function LogPrefix(methodName As String) As String
  
  Return $Titulo & "[" & methodName & "] "
  
End
