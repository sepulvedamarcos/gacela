' Gambas class file

Private $width As Integer = 160
Private $height As Integer = 90

Private $configuration As Configuration
Private $log4Gambas As Log4Gambas3
Private $photoService As PhotoService
' Private $formPhotos As FPhoto
Private $titulo As String = "[FMain] "

Public Sub _new(configuration As Configuration, logger As Log4Gambas3, photoService As PhotoService)
  
  $configuration = configuration
  $log4Gambas = logger
  $photoService = photoService
  
End

Public Sub Form_Open()
  
  Dim btn As Button
  
  $log4Gambas.Debug("en formulario open obtenemos los registros de fotos")
  
  MainMenu_PrivateCollection.Checked = IIf($configuration.whichLibrary = Enumeration.LibraryType_Private, True, False)
  MainMenu_ShareCollection.Checked = IIf($configuration.whichLibrary = Enumeration.LibraryType_Private, False, True)
  CollectionToolMenu_Private.Checked = IIf($configuration.whichLibrary = Enumeration.LibraryType_Private, True, False)
  CollectionToolMenu_Share.Checked = IIf($configuration.whichLibrary = Enumeration.LibraryType_Private, False, True)
  
  MenuButtonCollection.Text = IIf($configuration.whichLibrary = Enumeration.LibraryType_Private, Constants.COLLECTION_PRIVATE, Constants.COLLECTION_SHARE) 
  
  ExpanderAlbum.Hidden = True
  ExpanderTags.Hidden = True
  
  ClearPhotoGallery()
  ' TODO: aqui deberia levantar los filtros usados la ultima vez
  CreatePhotoPanels($photoService.loadFirstPage())
  
  btn = New Button(ExpanderAlbum)
  btn.Width = 60
  btn.Height = 24
  btn.Text = "hola que tal"
  
End

Public Sub Form_Drop()
  
  Dim filedrop As String
  Dim filesDrop As String[]
  Dim namesErr As String
  
  'FIXME: mover este codigo a una fumncion estandar para agregar un boton en la toolbar para importar
  
  $log4Gambas.Debug($titulo & "Drag and drop de archivos")
  
  filesDrop = Drag.Paste("text/uri-list")
  For Each fileDrop In filesDrop
    $log4Gambas.debug($titulo & "archivo : [" & File.BaseName(fileDrop) & "." & File.Ext(fileDrop) & "]")
    If LCase(File.Ext(fileDrop)) = "jpg" Or LCase(File.Ext(fileDrop)) = "png" Then
    Else
      namesErr = namesErr & File.BaseName(fileDrop) & "." & File.Ext(fileDrop)
    Endif
  Next
  
  If namesErr = "" Then
    ImportProcess(filesDrop)
  Else
    Message.Error(("Algunos de los archivos que se intenta importar no son validos"))
  Endif
  
End

Public Sub ButtonZoomIn_Click()
  
  Dim pane As Variant
  
  For Each pane In PanelGalleryContent.Children
    pane.Width = pane.Width * 1.25
    pane.Height = pane.Height * 1.25
  Next
  
End

Public Sub ButtonZoomOut_Click()
  
  Dim pane As Variant
  
  For Each pane In PanelGalleryContent.Children
    pane.Width = pane.Width / 1.25
    pane.Height = pane.Height / 1.25
  Next
  
End

Public Sub PanelGalleryContent_Scroll()
  
  Dim scrollPos As Float
  Dim scrollMax As Float
  Dim threshold As Float = 0.8  ' 80% del scroll
  Dim newPhotos As PhotoEntity[]
  
  ' Calcular posición del scroll (0.0 a 1.0)
  scrollMax = PanelGalleryContent.ScrollHeight - PanelGalleryContent.ClientHeight
  
  If scrollMax <= 0 Then Return
  
  scrollPos = PanelGalleryContent.ScrollY / scrollMax
  
  ' Si llegó al 80% y no está cargando, cargar más
  If scrollPos >= threshold Then
    newPhotos = $photoService.loadNextPage()
    If newPhotos.Count > 0 Then
      CreatePhotoPanels(newPhotos)
    End If
  Endif
  
End

Public Sub MainMenu_Exit_Click()
  
  Me.Close
  
End

Public Sub MainMenu_ShareCollection_Click()
  
  MainMenu_PrivateCollection.Checked = False
  CollectionToolMenu_Private.Checked = False
  CollectionToolMenu_Share.Checked = True
  MenuButtonCollection.Text = Constants.COLLECTION_SHARE
  
End

Public Sub MainMenu_PrivateCollection_Click()
  
  MainMenu_ShareCollection.Checked = False
  CollectionToolMenu_Share.Checked = False
  CollectionToolMenu_Private.Checked = True
  MenuButtonCollection.Text = Constants.COLLECTION_PRIVATE
  
End

Public Sub CollectionToolMenu_Private_Click()
  
  MainMenu_ShareCollection.Checked = False
  CollectionToolMenu_Share.Checked = False
  CollectionToolMenu_Private.Checked = True
  MenuButtonCollection.Text = Constants.COLLECTION_PRIVATE
  
  MainMenu_PrivateCollection.Checked = True
  MainMenu_ShareCollection.Checked = False
  
End

Public Sub CollectionToolMenu_Share_Click()
  
  MainMenu_PrivateCollection.Checked = False
  CollectionToolMenu_Private.Checked = False
  CollectionToolMenu_Share.Checked = True
  MenuButtonCollection.Text = Constants.COLLECTION_SHARE
  
  MainMenu_PrivateCollection.Checked = False
  MainMenu_ShareCollection.Checked = True
  
End

Public Sub MainMenu_ImportImages_Click()
  
  ImportProcess()
  
End

' ==================================================
'
'          Metodos privados
'
' ==================================================

Private Sub CreatePhotoPanels(photos As PhotoEntity[])
  
  Dim panelPhoto As Panel
  Dim formPhoto As FPhoto
  Dim photo As PhotoEntity
  ' Dim pictureBox As PictureBox
  
  $log4Gambas.Info("Creacion de paneles iniciales")
  For Each photo In photos
    panelPhoto = New Panel(PanelGalleryContent)
    panelPhoto.Width = $width
    panelPhoto.Height = $height
    panelPhoto.Border = Border.Plain
    panelPhoto.Arrangement = Arrange.Fill
    panelPhoto.Tag = photo.Id
    
    formPhoto = New FPhoto(photo, panelPhoto)
    formPhoto.Width = $width
    formPhoto.Height = $height
    
    panelPhoto.Show()
  Next
  
End

Private Sub ClearPhotoGallery()
  
  ' Destruir todos los controles
  For Each ctrl As Control In PanelGalleryContent.Children
    ctrl.Delete()
  Next
  
End

Private Sub ImportProcess(Optional listFiles As String[])
  Dim resp As Variant
  Dim selector As FImportDialog
  
  selector = New FImportDialog($photoService, $log4Gambas, listFiles)
  resp = selector.ShowModal()
  
  If resp = Enumeration.DLG_OK Then
    CreatePhotoPanels($photoService.loadNextPage())
    'FIXME: Al final del proceso escribir en la barra de estado y posibilitar que con un click se levante el evento de importacion
    'TODO: genial seria que la barra de estados lleve una memoria de las cosas que han pasado como un log
    'FIXME: por ahora pondre la ventana de resumen de importacion aca
    ' fImportR = New FImportResume(1)
  Endif
  
End
