' Gambas class file

Private $Width As Integer = 160
Private $Height As Integer = 90

Private $Configuration As Configuration
Private $Logger As LoggerPort
Private $PhotoService As PhotoService
Private $AlbumService As AlbumService
Private $TagService As TagService
Private $PhotoSelectionService As PhotoSelectionService
Private $Titulo As String = "FMain"
Private $LogMessage As LogMessage
Private $StatusDefaultText As String
Private StatusTimer As Timer
Private $LastImportSummary As ImportSummary
Private $AlbumPanel As Panel

Property LastImportSummary As ImportSummary

Public Sub _new(cConfiguration As Configuration, oLogger As LoggerPort, cPhotoService As PhotoService, cAlbumService As AlbumService, cTagService As TagService) '' Initializes main form dependencies.

  $Configuration = cConfiguration
  $Logger = oLogger
  $PhotoService = cPhotoService
  $AlbumService = cAlbumService
  $TagService = cTagService

End

Public Sub Form_Open()

  $LogMessage = New LogMessage($Titulo, "Form_Open", "On form open we load photo records")
  $Logger.Debug($LogMessage)

  $PhotoSelectionService = New PhotoSelectionService As "SelectionService"

  SelectGallery($Configuration.WhichGallery)

  $StatusDefaultText = LabelStatusBar.Text
  StatusTimer = New Timer
  StatusTimer.Enabled = False

  AddAlbumExpander()
  UpdateSelectionActions()

End

Public Sub Form_Drop()

  Dim aFilesDrop As String[]
  Dim sFileDrop As String
  Dim sNamesErr As String

  $LogMessage = New LogMessage($Titulo, "Form_Drop", "Drag and drop files")
  $Logger.Debug($LogMessage)

  aFilesDrop = Drag.Paste("text/uri-list")
  For Each sFileDrop In aFilesDrop
    $LogMessage = New LogMessage($Titulo, "Form_Drop", "file: [" & File.BaseName(sFileDrop) & "." & File.Ext(sFileDrop) & "]")
    $Logger.Debug($LogMessage)
    If LCase(File.Ext(sFileDrop)) = "jpg" Or LCase(File.Ext(sFileDrop)) = "png" Then
    Else
      sNamesErr = sNamesErr & File.BaseName(sFileDrop) & "." & File.Ext(sFileDrop)
    Endif
  Next

  If sNamesErr = "" Then
    ImportProcess(aFilesDrop)
  Else
    Message.Error(("Some of the files you are trying to import are not valid"))
  Endif

End

Public Sub ButtonZoomIn_Click()

  Dim vPane As Variant

  For Each vPane In PanelGalleryContent.Children
    vPane.Width = vPane.Width * 1.25
    vPane.Height = vPane.Height * 1.25
  Next

End

Public Sub ButtonZoomOut_Click()

  Dim vPane As Variant

  For Each vPane In PanelGalleryContent.Children
    vPane.Width = vPane.Width / 1.25
    vPane.Height = vPane.Height / 1.25
  Next

End

Public Sub PanelGalleryContent_Scroll()

  Dim fScrollPos As Float
  Dim fScrollMax As Float
  Dim fThreshold As Float = 0.8  ' 80% of scroll
  Dim aNewPhotos As PhotoEntity[]

  ' Calculate scroll position (0.0 to 1.0)
  fScrollMax = PanelGalleryContent.ScrollHeight - PanelGalleryContent.ClientHeight

  If fScrollMax <= 0 Then Return

  fScrollPos = PanelGalleryContent.ScrollY / fScrollMax

  ' If it reached 80% and not loading, load more
  If fScrollPos >= fThreshold Then
    aNewPhotos = $PhotoService.LoadNextPage()
    If aNewPhotos.Count > 0 Then
      CreatePhotoPanels(aNewPhotos)
    End If
  Endif

End

