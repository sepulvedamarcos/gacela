Public Sub ShowStatus(sMessage As String, Optional iTimeoutMs As Integer = 2500)
  
  If $StatusDefaultText = "" Then
    $StatusDefaultText = LabelStatusBar.Text
  Endif
  
  LabelStatusBar.Text = sMessage
  
  StatusTimer.Stop()
  If iTimeoutMs > 0 Then
    StatusTimer.Delay = iTimeoutMs
    StatusTimer.Start()
  Endif
  
End

