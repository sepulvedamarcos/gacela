Public Sub _new(oConfiguration As Configuration, oLogger As LoggerPort, oPhotoService As PhotoService, oAlbumService As AlbumService, oTagService As TagService) '' Initializes main form dependencies.
  
  $Configuration = oConfiguration
  $Logger = oLogger
  $PhotoService = oPhotoService
  $AlbumService = oAlbumService
  $TagService = oTagService
  
End

Public Sub Form_Open()
  
  $LogMessage = New LogMessage($Titulo, "Form_Open", "On form open we load photo records")
  $Logger.Debug($LogMessage)
  
  $PhotoSelectionService = New PhotoSelectionService As "SelectionService"
  
  LoadEnvironment()
  SelectGallery($Configuration.WhichGallery)
  
  $StatusDefaultText = LabelStatusBar.Text
  StatusTimer = New Timer
  StatusTimer.Enabled = False
  
  PopulateFilterTreeView()
  UpdateSelectionActions()
  UpdateTrashCount()
  
End

Public Sub TreeViewFilters_Select() '' Handles filter selection from the tree view.
  
  Dim oSpec As New PhotoSpecification
  Dim sKey As String = TreeViewFilters.Current.Key
  Dim aKeyParts As String[]
  Dim sDate As String
  
  $LogMessage = New LogMessage($Titulo, "TreeViewFilters_Select", "Filter selected: " & sKey)
  $Logger.Debug($LogMessage)
  
  ' Always sync the soft delete state with the current view
  oSpec.IsSoftDeleted = $IsViewingTrash
  
  If sKey Begins "ROOT:" Then
   oSpec = New PhotoSpecification
   oSpec.IsSoftDeleted = $IsViewingTrash
  Else If sKey Begins "ALB:" Then
    aKeyParts = Split(sKey, ":")
    oSpec.AlbumId = CInt(aKeyParts[1])
  Else If sKey Begins "TAG:" Then
    aKeyParts = Split(sKey, ":")
    oSpec.TagId = CInt(aKeyParts[1])
  Else If sKey Begins "YEAR:" Then
    sDate = Split(sKey, ":")[1]
    oSpec.StartDate = Date(Val(sDate), 1, 1)
    oSpec.EndDate = Date(Val(sDate), 12, 31, 23, 59, 59)
  Else If sKey Begins "MONTH:" Then
    sDate = Split(sKey, ":")[1]
    aKeyParts = Split(sDate, "-")
    oSpec.StartDate = Date(Val(aKeyParts[0]), Val(aKeyParts[1]), 1)
    oSpec.EndDate = Date(Val(aKeyParts[0]), Val(aKeyParts[1]), Day(Date(Val(aKeyParts[0]), Val(aKeyParts[1]) + 1, 1) - 1), 23, 59, 59)
  Else If sKey Begins "DATE:" Then
    sDate = Split(sKey, ":")[1]
    aKeyParts = Split(sDate, "-")
    oSpec.StartDate = Date(Val(aKeyParts[0]), Val(aKeyParts[1]), Val(aKeyParts[2]))
    oSpec.EndDate = Date(Val(aKeyParts[0]), Val(aKeyParts[1]), Val(aKeyParts[2]), 23, 59, 59)
  Else
    ' Root nodes or unimplemented filters
    Return
  Endif
  
  $PhotoService.ApplyFilters(oSpec)
  RenderCurrentPhotoFilter()
  
End

Private Sub PopulateFilterTreeView() '' Fills the tree view with albums, tags, and date filters.
  
  Dim oAlbums As AlbumEntity[]
  Dim oTags As TagEntity[]
  Dim aDates As String[]
  Dim sDate, sYear, sMonth, sDay As String
  Dim sYearKey, sMonthKey As String
  
  TreeViewFilters.Clear()
  
  ' Root: All Photos
  TreeViewFilters.Add("ROOT:ALL", ("All Photos"), Picture["icon:/16/home"])
  
  ' Root: Albums
  TreeViewFilters.Add("ROOT:ALBUMS", ("Albums"), Picture["icon:/16/directory"])
  oAlbums = $AlbumService.FindAlbums()
  For Each oAlbum As AlbumEntity In oAlbums
    TreeViewFilters.Add("ALB:" & oAlbum.Id, oAlbum.Name, Picture["icon:/16/book"], "ROOT:ALBUMS")
  Next
  TreeViewFilters["ROOT:ALBUMS"].Expanded = True
  
  ' Root: Tags
  TreeViewFilters.Add("ROOT:TAGS", ("Tags"), Picture["icon:/16/tag"])
  oTags = $TagService.FindTags()
  For Each oTag As TagEntity In oTags
    TreeViewFilters.Add("TAG:" & oTag.Id, oTag.Name, Picture["icon:/16/bookmark"], "ROOT:TAGS")
  Next
  TreeViewFilters["ROOT:TAGS"].Expanded = True
  
  ' Root: Dates
  TreeViewFilters.Add("ROOT:DATES", ("Dates"), Picture["icon:/16/calendar"])
  aDates = $PhotoService.Repository.GetAvailableDates()
  
  If aDates <> Null Then
    For Each sDate In aDates
      sYear = Left(sDate, 4)
      sMonth = Mid(sDate, 6, 2)
      sDay = Right(sDate, 2)
      
      sYearKey = "YEAR:" & sYear
      sMonthKey = "MONTH:" & sYear & "-" & sMonth
      
      ' Add Year
      If Not TreeViewFilters.Exist(sYearKey) Then
        TreeViewFilters.Add(sYearKey, sYear, Picture["icon:/16/calendar"], "ROOT:DATES")
      Endif
      
      ' Add Month
      If Not TreeViewFilters.Exist(sMonthKey) Then
        TreeViewFilters.Add(sMonthKey, Format(Date(Val(sYear), Val(sMonth), 1), "mmmm"), Picture["icon:/16/calendar"], sYearKey)
      Endif
      
      ' Add Day
      TreeViewFilters.Add("DATE:" & sDate, sDay, Picture["icon:/16/calendar"], sMonthKey)
    Next
  Endif
  
End

Public Sub Form_Drop() '' Handles dragging and dropping files into the form.
  
  Dim aFilesDrop As String[]
  Dim sFileDrop As String
  Dim sNamesErr As String
  
  $LogMessage = New LogMessage($Titulo, "Form_Drop", "Drag and drop files")
  $Logger.Debug($LogMessage)
  
  ' aFilesDrop = Split(Drag.Paste("text/uri-list"), "\n")
  aFilesDrop = Drag.Paste("text/uri-list")
  For Each sFileDrop In aFilesDrop
    If sFileDrop = "" Then Continue
    $LogMessage = New LogMessage($Titulo, "Form_Drop", "file: [" & File.BaseName(sFileDrop) & "." & File.Ext(sFileDrop) & "]")
    $Logger.Debug($LogMessage)
    If LCase(File.Ext(sFileDrop)) = "jpg" Or LCase(File.Ext(sFileDrop)) = "png" Then
    Else
      sNamesErr = sNamesErr & File.BaseName(sFileDrop) & "." & File.Ext(sFileDrop)
    Endif
  Next
  
  If sNamesErr = "" Then
    ImportProcess(aFilesDrop)
  Else
    Message.Error(("Some of the files you are trying to import are not valid"))
  Endif
  
End

