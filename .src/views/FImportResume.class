' Gambas class file

Private $Log4Gambas As Log4Gambas3
Private $Configuration As Configuration
Private $Summary As ImportSummary

Public Sub _new(oSummary As ImportSummary, oLogger As Log4Gambas3, oConfiguration As Configuration)
  
  $Summary = oSummary
  $Log4Gambas = oLogger
  $Configuration = oConfiguration
  
  If $Summary <> Null Then
    LabelTotalAmount.Text = Str($Summary.Total)
    LabelSuccessful.Text = Str($Summary.OkCount)
    LabelFailed.Text = Str($Summary.FailCount)
  Else
    LabelTotalAmount.Text = "0"
    LabelSuccessful.Text = "0"
    LabelFailed.Text = "0"
  Endif
  
End

Public Sub Run() As Boolean
  
  Return Not Me.ShowModal()
  
End

Public Sub BtnOK_Click()
  
  Me.Close(True)
  
End

Public Sub BtnCancel_Click()
  
  Me.Close
  
End

Public Sub Form_Open()
  
End
