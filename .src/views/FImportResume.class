' Gambas class file

Public Sub _new(amout As Integer)
  
  LabelTotalAmount.Text = "" & Str(amout)
  LabelSuccessful.Text = ""
  LabelFailed.Text = ""
  
End

Public Sub Run() As Boolean
  
  Return Not Me.ShowModal()
  
End

Public Sub btnOK_Click()
  
  Me.Close(True)
  
End

Public Sub btnCancel_Click()
  
  Me.Close
  
End

Public Sub Form_Open()
  
End
