' Gambas class file

'
'
' Business logic handler class
'
'
Private $PhotoService As PhotoService
Private $Logger As LoggerPort
Private $Titulo As String = "[FImportDialog] "
Private $LogMessage As LogMessage
Private $FilesDrop As String[]
Private $IdAlbum As Integer
Private $Fmain As Fmain

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(cFmain As Fmain, cPhotoService As PhotoService, oLogger As LoggerPort, aFilesDrop As String[])

  $PhotoService = cPhotoService
  $Logger = oLogger
  $FilesDrop = aFilesDrop
  $Fmain = cFmain

  $LogMessage = New LogMessage($Titulo, "_new", ("Creating dialog window and album list"))
  $Logger.Info($LogMessage)

  ListEditorPhotos.ReadOnly = True
  ListEditorPhotos.List = aFilesDrop
  ListEditorPhotos.Unique = True

  PanelAssociateAlbum.Visible = False
  PanelAssociateAlbum.Y = 4
  PanelAssociateAlbum.X = 182
  ListEditorAvailableAlbums.Wrap = True

  FindAlbums()

End

Public Sub BtnOK_Click()

  Dim iResp As Integer
  Dim aAl As AlbumEntity[]
  Dim iId As Integer
  Dim oSummary As ImportSummary

  If ListEditorPhotos.List.Count = 0 Then
    Message.Warning(("You must select photos to process"))
    Return
  End If
  iResp = Message.Question(("Are you sure you want to import the selected photos into the album with the chosen options?"), ("Yes"), ("No"))

  If iResp = 2 Then
    Return
  Else
    $LogMessage = New LogMessage($Titulo, "BtnOK_Click", ("Starting photo import processing"))
  $Logger.Info($LogMessage)
    oSummary = $PhotoService.ImportPhotos(ListEditorPhotos.List, Null, Null, $IdAlbum)
  Endif

  $Fmain.LastImportSummary = oSummary

  Me.Close(Enumeration.DLG_OK)

Catch
  $LogMessage = New LogMessage($Titulo, "BtnOK_Click", ("A problem occurred while importing the images") & " [" & Error.Text & "]")
  $Logger.Error($LogMessage)
  Message.Error(("A problem occurred while importing the images") & " [" & Error.Text & "]")

End

Public Sub BtnCancel_Click()

  Me.Close

End

Public Sub ButtonAddAlbum_Click()

  Dim iCuenta As Integer

  If TextBoxAlbum.Text <> "" Then
    For Each sItem As String In ListEditorAvailableAlbums.List
      If sItem = TextBoxAlbum.Text Then
        iCuenta += 1
      Endif
    Next
    If iCuenta = 0 Then
      ListEditorAvailableAlbums_Add()
      ListEditorAvailableAlbums.Index = ListEditorAvailableAlbums.Count - 1
    Endif
  Else
    Message.Warning(("You must add an album to continue"))
    TextBoxAlbum.SetFocus
  Endif

End

Public Sub ButtonBoxFilter_Click()

  $LogMessage = New LogMessage($Titulo, "ButtonBoxFilter_Click", "Filter click with text [" & ButtonBoxFilter.Text & "]")
  $Logger.Debug($LogMessage)
  TextAreaAlbumDescription.Text = ""
  FindAlbums(ButtonBoxFilter.Text)

End

Public Sub CheckBoxEnableAlbum_Click()

  $LogMessage = New LogMessage($Titulo, "CheckBoxEnableAlbum_Click", ("Checkbox click to associate album ") & "[" & Str(CheckBoxEnableAlbum.Value) & "]")
  $Logger.Debug($LogMessage)
  If CheckBoxEnableAlbum.Value Then
    PanelList.Enabled = False
    VBoxButtons.Enabled = False
    PanelAssociateAlbum.Visible = True

  Else
    PanelAssociateAlbum.Visible = False
    PanelList.Enabled = True
    VBoxButtons.Enabled = True

  Endif

End

Public Sub BtnOkAlbum_Click()

  Dim sItem As String
  Dim iCuenta As Integer
  Dim oAlbums As AlbumEntity[]

  If TextBoxAlbum.Text = "" Or ListEditorAvailableAlbums.Text = "" Then
    Message.Warning(("You must select an album to continue or add new one"))
    ListEditorAvailableAlbums.SetFocus()
    Return
  Else
    If TextBoxAlbum.Text <> "" Then

      If TextBoxAlbum.Text = ListEditorAvailableAlbums.Text Then
        oAlbums = ListEditorAvailableAlbums.Tag
        $IdAlbum = oAlbums[ListEditorAvailableAlbums.Index].Id
      Else
        Message.Warning(("You must select an album to continue or add new one"))
        ListEditorAvailableAlbums.SetFocus()
        Return

      Endif

    Endif
  Endif

  PanelAssociateAlbum.Visible = False
  PanelList.Enabled = True
  VBoxButtons.Enabled = True

  $LogMessage = New LogMessage($Titulo, "BtnOkAlbum_Click", ("Select an album to associate") & " [" & TextBoxAlbum.Text & "]")
  $Logger.Debug($LogMessage)

  LabelAlbumNameSelected.Text = TextBoxAlbum.Text
  LabelAlbumDescriptionSelected.Text = TextAreaAlbumDescription.Text

End

Public Sub BtnCancelAlbum_Click()

  $LogMessage = New LogMessage($Titulo, "BtnCancelAlbum_Click", ("Cancel album association, revert changes"))
  $Logger.Debug($LogMessage)
  CheckBoxEnableAlbum.Value = False

End

Public Sub ListEditorAvailableAlbums_Add()

  Dim cAlbum As AlbumEntity
  Dim aAlbums As AlbumEntity[]

  $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Add", ("Attempting to add a new album"))
  $Logger.Debug($LogMessage)
  If TextBoxAlbum.Text = "" Then
    Message.Warning(("You must enter an album name to continue"))
    TextBoxAlbum.SetFocus()
    Return
  Endif

  aAlbums = ListEditorAvailableAlbums.Tag
  For Each cAlbum In aAlbums
    If cAlbum.Name = TextBoxAlbum.Text Then
      Return
    Endif
  Next

  $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Add", ("New album: " & "{" & TextBoxAlbum.Text & "}{" & TextAreaAlbumDescription.Text & "}"))
  $Logger.Debug($LogMessage)
  If $PhotoService.AddAlbum(TextBoxAlbum.Text, TextAreaAlbumDescription.Text) Then
    $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Add", ("New album added successfully, loading it into the list"))
  $Logger.Debug($LogMessage)
    FindAlbums()

  Else
    $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Add", ("Failed to add new album"))
  $Logger.Error($LogMessage)
    Message.Error(("Error while adding a new album"))

  Endif

Catch
  $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Add", ("Problems creating an album"))
  $Logger.Error($LogMessage)
  Message.Error(("Problems creating an album"))

End

Public Sub ListEditorPhotos_Add()

  Dim vImg As Variant

  Dialog.Title = "Select a file"
  Dialog.Filter = ["*.png; *.jpg", "Image files"]
  Dialog.FilterIndex = 0
  Dialog.Path = Desktop.GetDirectory("PICTURES")
  If Dialog.OpenFile(True) Then
    Return ' Process canceled by the user
  Endif

  $LogMessage = New LogMessage($Titulo, "ListEditorPhotos_Add", ("Adding new photos"))
  $Logger.Debug($LogMessage)

  For Each vImg In Dialog.Paths
    $LogMessage = New LogMessage($Titulo, "ListEditorPhotos_Add", ("Adding a new photo") & "[" & vImg & "]")
  $Logger.Debug($LogMessage)
    ListEditorPhotos.Add(vImg)
  Next

End

Public Sub ListEditorPhotos_Select()

  PictureBoxPreview.Image = Image.Load(ListEditorPhotos.Text)

End

Public Sub ListEditorAvailableAlbums_Select()

  Dim aAlbums As AlbumEntity[]
  Dim cAlb As AlbumEntity

  If ListEditorAvailableAlbums.Index = -1 Then
    $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Select", ("Detected deletion of an album") & "[" & ListEditorAvailableAlbums.Text & "]")
  $Logger.Debug($LogMessage)

    aAlbums = ListEditorAvailableAlbums.Tag
    For Each cAlb In aAlbums
      If cAlb.name = ListEditorAvailableAlbums.Text Then
        $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Select", ("Deletion data matches, sending id") & " [" & cAlb.Id & "] [" & ListEditorAvailableAlbums.Text & "]")
  $Logger.Debug($LogMessage)
        If $PhotoService.RemoveAlbum(cAlb.Id) Then
          TextBoxAlbum.Text = ""
          TextAreaAlbumDescription.Text = ""
          FindAlbums()
        Endif
      Endif
    Next

    Return
  Endif

  aAlbums = ListEditorAvailableAlbums.Tag

  TextBoxAlbum.Text = aAlbums[ListEditorAvailableAlbums.Index].Name
  TextAreaAlbumDescription.Text = aAlbums[ListEditorAvailableAlbums.Index].Description
  $IdAlbum = aAlbums[ListEditorAvailableAlbums.Index].Id

  $LogMessage = New LogMessage($Titulo, "ListEditorAvailabeAlbums_Select", ("Album selection") & "[" & TextBoxAlbum.Text & "][" & Str($IdAlbum) & "]")
  $Logger.Debug($LogMessage)

End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub FindAlbums(Optional text As String)

  Dim aAlbums As AlbumEntity[]
  Dim cAlbum As AlbumEntity

  $LogMessage = New LogMessage($Titulo, "FindAlbums", "Searching for album [" & text & "]")
  $Logger.Debug($LogMessage)
  aAlbums = $PhotoService.FindAlbums(text, 0, Constants.USE_SOFT_FALSE)

  ListEditorAvailableAlbums.Clear
  ListEditorAvailableAlbums.Index = -1
  ListEditorAvailableAlbums.Tag = aAlbums
  For Each cAlbum In aAlbums

    ListEditorAvailableAlbums.Add(cAlbum.Name)

  Next

End
