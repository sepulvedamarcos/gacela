' Gambas class file

'
'
' Business logic handler class
'
'
Private $PhotoService As PhotoService
Private $Log4Gambas As Log4Gambas3
Private $Titulo As String = "[FImportDialog] "
Private $FilesDrop As String[]
Private $TextCheckFalse As String = ("Import photos into an album")
Private $TextCheckTrue As String = ("Import photos into the album")
Private $IdAlbum As Integer '' Selected album id
Private $ImportSummary As ImportSummary

Property Read ImportSummary As ImportSummary

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(cPhotoService As PhotoService, oLogger As Log4Gambas3, aFilesDrop As String[])
  $PhotoService = cPhotoService
  $Log4Gambas = oLogger
  $FilesDrop = aFilesDrop
  
  $Log4Gambas.Info(LogPrefix("_new") & ("Creating dialog window and album list"))
  
  ListEditorPhotos.ReadOnly = True
  ListEditorPhotos.List = aFilesDrop
  ListEditorPhotos.Unique = True
  
  PanelAssociateAlbum.Visible = False
  PanelAssociateAlbum.Y = 4
  PanelAssociateAlbum.X = 182
  ListEditorAvailabeAlbums.ReadOnly = True
  ListEditorAvailabeAlbums.Wrap = True
  ListEditorAvailabeAlbums.Unique = True
  
  CheckBoxEnableAlbum.Text = $TextCheckFalse
  
  FindAlbums()
  
End

Public Sub Run() As Boolean
  
  $Log4Gambas.Debug(LogPrefix("Run") & "Run method")
  Return Not Me.ShowModal()
  
End

Public Sub BtnOK_Click()
  
  Dim iResp As Integer
  Dim aAl As AlbumEntity[]
  Dim iId As Integer
  Dim oSummary As ImportSummary
  
  If ListEditorPhotos.List.Count = 0 Then
    Message.Warning(("You must select photos to process"))
    Return
  Else 
    iResp = Message.Question(("Are you sure you want to import the selected photos into the album with the chosen options?"), ("Yes"), ("No"))
    
    If iResp = 2 Then
      Return
      
    Else
      $Log4Gambas.Info(LogPrefix("BtnOK_Click") & ("Starting photo import processing"))
      oSummary = $PhotoService.ImportPhotos(ListEditorPhotos.List, Null, Null, $IdAlbum)
      $ImportSummary = oSummary
    Endif
  Endif
  
  Me.Close(Enumeration.DLG_OK)
  
Catch
  $Log4Gambas.Error(("A problem occurred while importing the images") & " [" & Error.Text & "]")
  Message.Error(("A problem occurred while importing the images") & " [" & Error.Text & "]")
  
End

Private Function ImportSummary_Read() As ImportSummary
  
  Return $ImportSummary
  
End

Public Sub BtnCancel_Click()
  
  Me.Close
  
End

Public Sub ButtonBoxFilterFilter()
  
  $Log4Gambas.Debug(LogPrefix("ButtonBoxFilterFilter") & "Filter escribe [" & ButtonBoxFilter.Text & "]")
  TextAreaAlbumDescription.Text = ""
  FindAlbums(ButtonBoxFilter.Text)
  
End

Public Sub ButtonBoxFilter_Click()
  
  $Log4Gambas.Debug(LogPrefix("ButtonBoxFilter_Click") & "Filter click with text [" & ButtonBoxFilter.Text & "]")
  TextAreaAlbumDescription.Text = ""
  FindAlbums(ButtonBoxFilter.Text)
  
End

Public Sub CheckBoxEnableAlbum_Click()
  
  $Log4Gambas.Debug(LogPrefix("CheckBoxEnableAlbum_Click") & ("Checkbox click to associate album ") & "[" & Str(CheckBoxEnableAlbum.Value) & "]")
  If CheckBoxEnableAlbum.Value Then
    PanelList.Enabled = False
    VBoxButtons.Enabled = False
    PanelAssociateAlbum.Visible = True
    CheckBoxEnableAlbum.Text = $TextCheckFalse
    
  Else
    PanelAssociateAlbum.Visible = False
    PanelList.Enabled = True
    VBoxButtons.Enabled = True
    CheckBoxEnableAlbum.Text = $TextCheckTrue
    
  Endif
  
End

Public Sub BtnOkAlbum_Click()
  
  Dim sItem As String
  Dim iCuenta As Integer
  
  If TextBoxAlbum.Text = "" Or ListEditorAvailabeAlbums.List.Count = 0 Then
    Message.Warning(("You must select an album to continue"))
    ListEditorAvailabeAlbums.SetFocus()
    Return
  Else
    If TextBoxAlbum.Text <> "" Then 
      For Each sItem In ListEditorAvailabeAlbums.List
        If sItem = TextBoxAlbum.Text Then 
          iCuenta += 1
        Endif
      Next
      If iCuenta = 0 Then
        ListEditorAvailabeAlbums_Add()
      Endif
    Endif
  Endif
  
  PanelAssociateAlbum.Visible = False
  PanelList.Enabled = True
  VBoxButtons.Enabled = True
  
  $Log4Gambas.Debug(LogPrefix("BtnOkAlbum_Click") & ("Select an album to associate") & " [" & TextBoxAlbum.Text & "]")
  CheckBoxEnableAlbum.Text = $TextCheckTrue & " [" & TextBoxAlbum.Text & "]"
  LabelAlbumDescriptionSelected.Text = TextAreaAlbumDescription.Text
  
End

Public Sub BtnCancelAlbum_Click()
  
  $Log4Gambas.Debug(LogPrefix("BtnCancelAlbum_Click") & ("Cancel album association, revert changes"))
  CheckBoxEnableAlbum.Value = False
  CheckBoxEnableAlbum.Text = $TextCheckFalse
  
End

Public Sub ListEditorAvailabeAlbums_Add()
  
  Dim cAlbum As AlbumEntity
  Dim aAlbums As AlbumEntity[]
  
  $Log4Gambas.Debug(LogPrefix("ListEditorAvailabeAlbums_Add") & ("Attempting to add a new album"))
  If TextBoxAlbum.Text = "" Then 
    Message.Warning(("You must enter an album name to continue"))
    TextBoxAlbum.SetFocus()
    Return 
  Endif
  
  aAlbums = ListEditorAvailabeAlbums.Tag
  For Each cAlbum In aAlbums
    If cAlbum.Name = TextBoxAlbum.Text Then 
      Return 
    Endif
  Next
  
  $Log4Gambas.Debug(LogPrefix("ListEditorAvailabeAlbums_Add") & ("New album: " & "{" & TextBoxAlbum.Text & "}{" & TextAreaAlbumDescription.Text & "}"))
  If $PhotoService.AddAlbum(TextBoxAlbum.Text, TextAreaAlbumDescription.Text) Then
    $Log4Gambas.Debug(LogPrefix("ListEditorAvailabeAlbums_Add") & ("New album added successfully, loading it into the list"))
    FindAlbums()
    
  Else
    $Log4Gambas.Error(LogPrefix("ListEditorAvailabeAlbums_Add") & ("Failed to add new album"))
    Message.Error(("Error while adding a new album"))
    
  Endif
  
Catch
  $Log4Gambas.Error(LogPrefix("ListEditorAvailabeAlbums_Add") & ("Problems creating an album"))
  Message.Error(("Problems creating an album"))
  
End

Public Sub ListEditorPhotos_Add()
  
  Dim vImg As Variant
  
  Dialog.Title = "Select a file"
  Dialog.Filter = ["*.png; *.jpg", "Image files"]
  Dialog.FilterIndex = 0
  Dialog.Path = Desktop.GetDirectory("PICTURES")
  If Dialog.OpenFile(True) Then
    Return ' Process canceled by the user
  Endif
  
  $Log4Gambas.Debug(LogPrefix("ListEditorPhotos_Add") & ("Adding new photos"))
  
  For Each vImg In Dialog.Paths
    $Log4Gambas.Debug(LogPrefix("ListEditorPhotos_Add") & ("Adding a new photo") & "[" & vImg & "]")
    ListEditorPhotos.Add(vImg)
  Next
  
End

Public Sub ListEditorPhotos_Select()
  
  PictureBoxPreview.Image = Image.Load(ListEditorPhotos.Text)
  
End

Public Sub ListEditorAvailabeAlbums_Select()
  
  Dim aAlbums As AlbumEntity[]
  Dim cAlb As AlbumEntity
  
  If ListEditorAvailabeAlbums.Index = -1 Then
    $Log4Gambas.Debug(LogPrefix("ListEditorAvailabeAlbums_Select") & ("Detected deletion of an album") & "[" & ListEditorAvailabeAlbums.Text & "]")
    
    aAlbums = ListEditorAvailabeAlbums.Tag
    For Each cAlb In aAlbums
      If cAlb.name = ListEditorAvailabeAlbums.Text Then 
        $Log4Gambas.Debug(LogPrefix("ListEditorAvailabeAlbums_Select") & ("Deletion data matches, sending id") & " [" & cAlb.Id & "] [" & ListEditorAvailabeAlbums.Text & "]")
        If $PhotoService.RemoveAlbum(cAlb.Id) Then
          TextBoxAlbum.Text = ""
          TextAreaAlbumDescription.Text = ""
          FindAlbums()
        Endif
      Endif
    Next
    
    Return
  Endif
  
  aAlbums = ListEditorAvailabeAlbums.Tag
  
  TextBoxAlbum.Text = aAlbums[ListEditorAvailabeAlbums.Index].Name
  TextAreaAlbumDescription.Text = aAlbums[ListEditorAvailabeAlbums.Index].Description
  $IdAlbum = aAlbums[ListEditorAvailabeAlbums.Index].Id
  
  $Log4Gambas.Debug(LogPrefix("ListEditorAvailabeAlbums_Select") & ("Album selection") & "[" & TextBoxAlbum.Text & "][" & Str($IdAlbum) & "]")
  
End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub FindAlbums(Optional text As String)
  
  Dim aAlbums As AlbumEntity[]
  Dim cAlbum As AlbumEntity
  
  $Log4Gambas.Debug(LogPrefix("FindAlbums") & "Searching for album [" & text & "]")
  aAlbums = $PhotoService.FindAlbums(text, 0, Constants.USE_SOFT_FALSE)
  
  ListEditorAvailabeAlbums.Clear
  ListEditorAvailabeAlbums.Index = -1
  ListEditorAvailabeAlbums.Tag = aAlbums
  For Each cAlbum In aAlbums
    
    ListEditorAvailabeAlbums.Add(cAlbum.Name)
    
  Next
  
End

Private Function LogPrefix(methodName As String) As String
  
  Return $Titulo & "[" & methodName & "] "
  
End
