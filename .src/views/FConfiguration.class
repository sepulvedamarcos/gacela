' Gambas class file

Private $Configuration As Configuration
Private $Logger As LoggerPort

Public Sub _new(oLogger As LoggerPort, oConfiguration As Configuration)
  
  $Logger = oLogger
  $Configuration = oConfiguration
  
  ComboBoxOutput.List = $Logger.GetOutputs()
  ComboBoxLevel.List = $Logger.GetLevels()
  
End

Public Sub Form_Open()
  
  SwitchButtonDeleteOriginal.Value = $Configuration.DeleteOriginals
  SpinBoxMaxFileDeleted.Value = $Configuration.DeletedMaxCount
  SpinBoxDeleteMaxSize.Value = $Configuration.DeletedMaxSizeMB
  
  ComboBoxLevel.Index = $Configuration.LogLevel
  ComboBoxOutput.Index = $Configuration.LogOutput
  DirBoxFilePath.Value = $Configuration.LogPath
  SpinBoxFileSize.Value = $Configuration.LogSize
  SpinBoxBackupFiles.Value = $Configuration.LogFiles

  SwitchButtonShowSummaryDialog.value = $Configuration.ImportShowSummary
  
End


Public Sub ButtonAccept_Click()
  
  $Configuration.DeleteOriginals = SwitchButtonDeleteOriginal.Value
  $Configuration.DeletedMaxCount = SpinBoxMaxFileDeleted.Value
  $Configuration.DeletedMaxSizeMB = SpinBoxDeleteMaxSize.Value
  
  $Configuration.LogLevel = ComboBoxLevel.Index
  $Configuration.LogOutput = ComboBoxOutput.Index
  $Configuration.LogPath = DirBoxFilePath.Value
  $Configuration.LogSize = SpinBoxFileSize.Value
  $Configuration.LogFiles = SpinBoxBackupFiles.Value
  
  $Configuration.ImportShowSummary = SwitchButtonShowSummaryDialog.Value

  Me.Close
  
End

Public Sub ButtonExit_Click()
  
  Me.Close
  
End
