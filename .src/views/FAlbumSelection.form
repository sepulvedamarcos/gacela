# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,88,118)
  Expand = True
  Text = ("Select albums")
  Resizable = False
  Arrangement = Arrange.Vertical
  Spacing = True
  Margin = True
  Padding = 4
  { VBoxListAlbums VBox
    MoveScaled(1,1,86,57)
    Expand = True
    { ButtonBoxFilter ButtonBox
      MoveScaled(1,1,72,4)
      Placeholder = ("Search Album")
      Button = False
      ClearButton = True
      Filter = True
    }
    { LabelTitle Label
      MoveScaled(1,6,72,4)
      Text = ("Choose one or more albums")
    }
    { TableViewAlbums TableView
      MoveScaled(1,10,61,20)
      Expand = True
      Mode = Select.Multiple
    }
    { VBoxButtons VBox
      MoveScaled(1,48,84,8)
      { Separator1 Separator
        MoveScaled(0,0,72,2)
      }
      { HBoxButtons HBox
        MoveScaled(0,2,82,5)
        Spacing = True
        Padding = 4
        { ButtonNewAlbum Button
          MoveScaled(1,0,18,4)
          Text = ("New Album")
        }
        { Button3 Button
          MoveScaled(19,0,18,4)
          Text = ("Remove Album")
        }
        { Spring1 Spring
          MoveScaled(38,0,4,4)
        }
        { BtnOK Button
          MoveScaled(45,0,18,4)
          Text = ("OK")
        }
        { BtnCancel Button
          MoveScaled(63,0,18,4)
          Text = ("Cancel")
        }
      }
    }
  }
  { VBoxManageAlbum VBox
    MoveScaled(1,59,86,57)
    Expand = True
    { Label3 Label
      MoveScaled(1,1,21,6)
      Text = ("Create new album")
    }
    { FrameManageAlbum VBox
      MoveScaled(1,8,84,24)
      Expand = True
      { Label2 Label
        MoveScaled(1,3,47,3)
        Text = ("Album name")
      }
      { TextBoxAlbum TextBox
        MoveScaled(1,6,48,4)
      }
      { Label1 Label
        MoveScaled(1,10,47,3)
        Text = ("Album Description")
      }
      { TextAreaAlbumDescription TextArea
        MoveScaled(1,13,82,8)
      }
    }
    { VBoxButtons2 VBox
      MoveScaled(1,47,84,8)
      { Separator2 Separator
        MoveScaled(0,0,72,2)
      }
      { HBoxButtons2 HBox
        MoveScaled(0,2,82,5)
        Spacing = True
        Padding = 4
        { Spring2 Spring
          MoveScaled(3,0,4,4)
        }
        { BtnOKNew Button
          MoveScaled(26,0,18,4)
          Text = ("OK")
        }
        { BtnCancelNew Button
          MoveScaled(47,0,18,4)
          Text = ("Cancel")
        }
      }
    }
  }
}
