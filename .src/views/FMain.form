# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,137,87)
  Drop = True
  Expand = True
  Arrangement = Arrange.Vertical
  { MainMenu Menu
    Text = ("File")
    Radio = True
    { MainMenu_PrivateCollection Menu
      Text = ("Private collection")
      Picture = Picture["icon:/medium/folder-home"]
      Radio = True
    }
    { MainMenu_ShareCollection Menu
      Text = ("Shared collection")
      Picture = Picture["icon:/medium/user-group"]
      Radio = True
    }
    { Menu1 Menu
    }
    { MainMenu_ImportImages Menu
      Text = ("Import images")
    }
    { Menu2 Menu
    }
    { MainMenu_Exit Menu
      Text = ("Exit")
      Picture = Picture["icon:/medium/quit"]
    }
  }
  { ViewMenu Menu
    Text = ("View")
  }
  { OptionsMenu Menu
    Text = ("Options")
    { ToolbarConfigurationMenu Menu
      Text = ("Toolbar configuration")
    }
    { OptionsMenu_Configuration Menu
      Text = ("Gazelle configurations")
      Picture = Picture["icon:/medium/options"]
    }
    { OptionsMenu_About Menu
      Text = ("About gazelle")
    }
  }
  { CollectionToolMenu Menu
    Text = ("CollectionTool")
    Visible = False
    { CollectionToolMenu_Private Menu
      Text = ("Private collection")
      Radio = True
    }
    { CollectionToolMenu_Share Menu
      Text = ("Shared collection")
      Radio = True
    }
  }
  { HBox4 HBox
    MoveScaled(0,0,137,8)
    Spacing = True
    Padding = 2
    { MenuButtonCollection MenuButton
      MoveScaled(1,0,16,8)
      Arrow = False
      Menu = "CollectionToolMenu"
    }
    { ToolButton1 ToolButton
      MoveScaled(18,0,12,8)
      Text = ("Shared")
      Border = True
    }
    { ToolButtonImport ToolButton
      MoveScaled(31,0,8,8)
    }
    { Spring1 Spring
      MoveScaled(115,1,4,5)
      Direction = Direction.LeftToRight
    }
    { ToolButtonConfiguration ToolButton
      MoveScaled(127,0,8,8)
      Picture = Picture["icons/64x64/package_settings.png"]
    }
  }
  { HBox1 HBox
    MoveScaled(0,8,137,70)
    Expand = True
    Spacing = True
    { PanelIzquierdo Panel
      MoveScaled(0,0,27,70)
      Background = Color.ButtonBackground
      Arrangement = Arrange.Row
      Spacing = True
      Padding = 4
      { ExpanderAlbum Expander
        MoveScaled(0,2,25,27)
        Font = Font["Poppins,16"]
        Expand = True
        Border = False
        Text = ("Albums")
        { CheckBox1 CheckBox
          MoveScaled(2,2,16,4)
          Font = Font["Poppins,-1"]
          Text = ("ererer")
        }
        { CheckBox2 CheckBox
          MoveScaled(2,6,16,4)
          Font = Font["Poppins,+1"]
          Text = ("asdad")
        }
        { Button5 Button
          MoveScaled(3,12,16,4)
        }
      }
      { ExpanderTags Expander
        MoveScaled(1,47,24,21)
        Font = Font["Poppins,16"]
        Expand = True
        Text = ("Tags")
      }
    }
    { PanelDerecho Panel
      MoveScaled(32,2,97,65)
      Expand = True
      Arrangement = Arrange.Vertical
      { PanelBusqueda Panel
        MoveScaled(1,1,90,7)
        Arrangement = Arrange.Horizontal
        Padding = 8
        { MenuButton1 MenuButton
          MoveScaled(25,1,20,5)
          Text = (",mn,mn,nm")
          Picture = Picture["icon:/medium/find"]
          Menu = "buscar"
        }
        { ButtonBox1 ButtonBox
          MoveScaled(46,1,43,5)
          Expand = True
          PopupMenu = "buscar"
          Direction = Direction.LeftToRight
          Picture = Picture["icon:/medium/find"]
          ClearButton = True
        }
      }
      { HBox2 Panel
        MoveScaled(1,8,90,6)
        Arrangement = Arrange.Horizontal
        { HBox3 HBox
          MoveScaled(1,0,8,6)
          Background = Color.LightBackground
          Expand = True
        }
        { Panel1 Panel
          MoveScaled(40,0,50,6)
          { ButtonZoomIn Button
            MoveScaled(40,1,4,4)
            Picture = Picture["icon:/medium/zoom-in"]
          }
          { ButtonZoomOut Button
            MoveScaled(44,1,4,4)
            Picture = Picture["icon:/medium/zoom-out"]
          }
          { SpinBoxPaginas SpinBox
            MoveScaled(22,1,9,4)
          }
          { Button1 Button
            MoveScaled(14,1,4,4)
            Picture = Picture["icon:/medium/start"]
          }
          { Button2 Button
            MoveScaled(35,1,4,4)
            Picture = Picture["icon:/medium/end"]
          }
          { Button3 Button
            MoveScaled(31,1,4,4)
            Picture = Picture["icon:/medium/forward"]
          }
          { Button4 Button
            MoveScaled(18,1,4,4)
            Picture = Picture["icon:/medium/rewind"]
          }
        }
      }
      { !PanelGalleryContent ScrollView
        MoveScaled(1,16,90,27)
        #Public = True
        Expand = True
        Arrangement = Arrange.Row
        Spacing = True
        Margin = True
        Padding = 4
        Border = False
        ScrollBar = Scroll.Vertical
        Shadow = True
      }
    }
  }
  { HBox5 Panel
    MoveScaled(0,78,137,5)
    Arrangement = Arrange.Horizontal
    { Label1 Label
      MoveScaled(2,1,34,3)
      Expand = True
      Border = Border.Etched
      Text = ("Hello word, this is the Status bar!!")
      Trim = True
    }
  }
}
