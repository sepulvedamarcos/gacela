# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,137,87)
  Drop = True
  Text = ("Gacela")
  Arrangement = Arrange.Vertical
  { MainMenu Menu
    Text = ("File")
    Radio = True
    { Menu1 Menu
      Text = ("Send to trash folder")
    }
    { Menu7 Menu
      Text = ("Delete permanently")
      Visible = False
    }
    { Menu6 Menu
    }
    { MainMenu_ExportImages Menu
      Text = ("Export Images")
    }
    { MainMenu_ImportImages Menu
      Text = ("Import images")
    }
    { Menu2 Menu
    }
    { MainMenu_Exit Menu
      Text = ("Exit")
      Picture = Picture["icon:/medium/quit"]
    }
  }
  { MainMenuView Menu
    Text = ("View")
    { ViewGallery_PrivateCollection Menu
      Text = ("Private gallery")
      Picture = Picture["icon:/medium/folder-home"]
      Radio = True
    }
    { ViewGallery_ShareCollection Menu
      Text = ("Shared gallery")
      Picture = Picture["icon:/medium/user-group"]
      Radio = True
    }
    { Menu5 Menu
    }
    { Menu8 Menu
      Text = ("View deleted files")
    }
  }
  { OptionsMenu Menu
    Text = ("Options")
    { Menu9 Menu
      Text = ("Albums")
    }
    { Menu10 Menu
      Text = ("Tags")
    }
    { Menu11 Menu
    }
    { ToolbarConfigurationMenu Menu
      Text = ("Toolbar configuration")
    }
    { OptionsMenu_Configuration Menu
      Text = ("Gacela settings")
      Picture = Picture["icon:/medium/options"]
    }
  }
  { Menu4 Menu
    Text = ("?")
    { HelpMenu_About Menu
      Text = ("About Gacela")
    }
  }
  { CollectionToolMenu Menu
    Text = ("Gallery")
    Visible = False
    { CollectionToolMenu_Private Menu
      Text = ("Private gallery")
      Picture = Picture["icon:/medium/folder-home"]
      Radio = True
    }
    { CollectionToolMenu_Share Menu
      Text = ("Shared gallery")
      Picture = Picture["icon:/medium/user-group"]
      Radio = True
    }
  }
  { HBox4 HBox
    MoveScaled(0,0,137,8)
    Spacing = True
    Padding = 2
    { ToolButtonImport ToolButton
      MoveScaled(0,0,8,8)
      ToolTip = ("Import images")
      Picture = Picture["icon:/32/upload"]
      Border = True
    }
    { ToolButtonExport ToolButton
      MoveScaled(8,0,8,8)
      ToolTip = ("Export images")
      Picture = Picture["icon:/32/download"]
      Border = True
    }
    { Panel2 Panel
      MoveScaled(16,0,2,8)
    }
    { ToolButton1 ToolButton
      MoveScaled(18,0,8,8)
      Picture = Picture["icon:/32/trash"]
      Border = True
    }
    { Spring1 Spring
      MoveScaled(106,1,4,5)
      Direction = Direction.LeftToRight
    }
    { ToolButtonConfiguration ToolButton
      MoveScaled(121,0,8,8)
      ToolTip = ("Gacela settings")
      Picture = Picture["icons/64x64/package_settings.png"]
      Border = True
    }
    { ToolButtonExit ToolButton
      MoveScaled(129,0,8,8)
      ToolTip = ("Exit")
      Picture = Picture["icon:/medium/logout"]
      Border = True
    }
  }
  { HBox1 HBox
    MoveScaled(0,8,137,70)
    Expand = True
    { PanelIzquierdo Panel
      MoveScaled(0,0,27,70)
      Arrangement = Arrange.Vertical
      { Panel3 Panel
        MoveScaled(0,3,26,63)
        Background = Color.Pink
        Expand = True
        Arrangement = Arrange.Row
        Margin = True
        Padding = 4
        { ExpanderAlbum Expander
          MoveScaled(2,2,21,4)
          Expand = True
          Arrangement = Arrange.Fill
          Border = False
          Text = ("Albums")
        }
        { ExpanderTags Expander
          MoveScaled(2,12,24,18)
          Expand = True
          Arrangement = Arrange.Fill
          Text = ("Tags")
        }
      }
    }
    { PanelDerecho Panel
      MoveScaled(29,1,97,65)
      Expand = True
      Arrangement = Arrange.Vertical
      { PanelBusqueda Panel
        MoveScaled(1,1,90,7)
        Arrangement = Arrange.Horizontal
        Padding = 8
        { MenuButton1 MenuButton
          MoveScaled(25,1,20,5)
          Text = ("Search")
          Picture = Picture["icon:/medium/find"]
          Menu = "buscar"
        }
        { ButtonBox1 ButtonBox
          MoveScaled(46,1,43,5)
          Expand = True
          PopupMenu = "buscar"
          Direction = Direction.LeftToRight
          Picture = Picture["icon:/medium/find"]
          ClearButton = True
        }
      }
      { HBox2 Panel
        MoveScaled(1,8,90,6)
        Arrangement = Arrange.Horizontal
        { HBox3 HBox
          MoveScaled(1,0,8,6)
          Background = Color.LightBackground
          Expand = True
        }
        { Panel1 Panel
          MoveScaled(40,0,50,6)
          { ButtonZoomIn Button
            MoveScaled(40,1,4,4)
            Picture = Picture["icon:/medium/zoom-in"]
          }
          { ButtonZoomOut Button
            MoveScaled(44,1,4,4)
            Picture = Picture["icon:/medium/zoom-out"]
          }
          { SpinBoxPaginas SpinBox
            MoveScaled(22,1,9,4)
          }
          { Button1 Button
            MoveScaled(14,1,4,4)
            Picture = Picture["icon:/medium/start"]
          }
          { Button2 Button
            MoveScaled(35,1,4,4)
            Picture = Picture["icon:/medium/end"]
          }
          { Button3 Button
            MoveScaled(31,1,4,4)
            Picture = Picture["icon:/medium/forward"]
          }
          { Button4 Button
            MoveScaled(18,1,4,4)
            Picture = Picture["icon:/medium/rewind"]
          }
        }
      }
      { !PanelGalleryContent ScrollView
        MoveScaled(1,16,90,36)
        #Public = True
        Background = Color.SelectedBackground
        Expand = True
        Arrangement = Arrange.Row
        Spacing = True
        Margin = True
        Padding = 4
        Border = False
        ScrollBar = Scroll.Vertical
        Shadow = True
      }
    }
  }
  { HBox5 Panel
    MoveScaled(0,78,137,5)
    Arrangement = Arrange.Horizontal
    { MenuButtonCollection MenuButton
      MoveScaled(0,0,25,5)
      Text = ("Shared gallery")
      Arrow = False
      Menu = "CollectionToolMenu"
    }
    { LabelStatusBar Label
      MoveScaled(25,0,58,5)
      Expand = True
      Padding = 4
      Spacing = True
      Border = Border.Etched
      Text = ("Status bar")
      Trim = True
    }
    { ToolButtonTrash ToolButton
      MoveScaled(132,0,5,5)
      ToolTip = ("View deleted files")
      Picture = Picture["icons/22x22/user-trash-full.png"]
      Border = True
    }
  }
}
