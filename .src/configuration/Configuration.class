' Gambas class file

'
' Class Configuration
' 
'
Private $Settings As Settings                                                 '' Settings file handler
Private $SettingPath As String                                                '' Settings file path
Private $IsFirstRun As Boolean = False                                        '' First run indicator
Private $WhichGallery As Integer = Enumeration.GalleryType_Private            '' Active gallery type
Private $AppPath As String                                                    '' Application files path
Private $Log4gambas As New Log4Gambas3                                        '' Logger instance
Private $OsTheme As Integer                                                   '' Current OS theme
Private $AppTheme As Integer                                                  '' Application theme
Private $IsSharedEnabled As Boolean                                           '' Shared gallery directory enabled
Private $Titulo As String = "[Configuration] "

Private $LogLevel As Integer
Private $LogOutput As Integer
Private $LogPath As String                                                    '' Log file path
Private $LogSize As Integer
Private $LogFiles As Integer
Private $DeletedMaxSizeMB As Integer
Private $DeletedMaxCount As Integer
Private $ImportShowSummary As Boolean

Property Read WhichGallery As Integer                                         '' Which gallery is active
Property Read IsFirstRun As Boolean                                           '' First execution indicator
Property Read GalleryPath As String                                           '' Gallery path
Property Read IsSharedGalleryAvailable As Boolean                             '' Shared gallery is available
Property DeleteOriginals As Boolean                                           '' Delete originals after import
Property LogLevel As Integer
Property LogOutput As Integer
Property LogPath As String
Property LogSize As Integer
Property LogFiles As Integer
Property DeletedMaxSizeMB As Integer
Property DeletedMaxCount As Integer
Property ImportShowSummary As Boolean

'============================================
'
'      Public methods
'
'============================================

Public Sub _new()
  
  $SettingPath = User.Home &/ Constants.GACELA_SETTING_DIRECTORY
  $LogPath = User.Home &/ Constants.GACELA_LOG_DIRECTORY
  $OsTheme = FindOSTheme()
  
  $Settings = New Settings($SettingPath &/ Constants.CONFIG_NAME)
  If $Settings.Count = 0 Then
    $Log4gambas.Info(LogPrefix("_new") & ("First launch detected. The application will be configured in private mode."))
    $IsFirstRun = True
    FirstInitializeSettings()
    FirstInitializeLogger()
  Endif
  
  $IsSharedEnabled = DetectShareEnabled()
  
Catch
  $Log4gambas.Error(LogPrefix("_new") & ("Error initializing configuration: ") & Error.Text)
  Error.Raise(LogPrefix("_new") & ("Error initializing configuration: ") & Error.Text)
  
End

Public Sub InitializeEnvironment()
  
  $Log4gambas.info(LogPrefix("InitializeEnvironment") & "Initializing environment")
  
  If $Settings[Constants.GLOBAL_GALLERY_TYPE, Null] = Null Then
    If $Settings["Global/LibraryType", Null] <> Null Then
      $Settings[Constants.GLOBAL_GALLERY_TYPE] = $Settings["Global/LibraryType"]
      $Settings.Save()
    Else
      Error.Raise(LogPrefix("InitializeEnvironment") & "Problems loading initial configuration")
    Endif
  Endif
  
  If $Settings[Constants.GLOBAL_SHARED_GALLERY_ENABLED, Null] = Null Then
    If $Settings["Global/Shared", Null] <> Null Then
      $Settings[Constants.GLOBAL_SHARED_GALLERY_ENABLED] = $Settings["Global/Shared"]
      $Settings.Save()
    Endif
  Endif
  
  If $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB, Null] = Null Then
    $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB] = 2048
    $Settings.Save()
  Endif
  
  If $Settings[Constants.GLOBAL_DELETED_MAX_COUNT, Null] = Null Then
    $Settings[Constants.GLOBAL_DELETED_MAX_COUNT] = 10000
    $Settings.Save()
  Endif
  
  If $Settings[Constants.IMPORT_SHOW_SUMMARY, Null] = Null Then
    $Settings[Constants.IMPORT_SHOW_SUMMARY] = True
    $Settings.Save()
  Endif
  
  $WhichGallery = $Settings[Constants.GLOBAL_GALLERY_TYPE]
  $AppTheme = $Settings[Constants.GLOBAL_APPLICATION_THEME, Enumeration.APP_THEME_OS]
  $DeletedMaxSizeMB = $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB, 2048]
  $DeletedMaxCount = $Settings[Constants.GLOBAL_DELETED_MAX_COUNT, 10000]
  $ImportShowSummary = $Settings[Constants.IMPORT_SHOW_SUMMARY, True]
  
End

Public Function InitializeLogger() As Log4Gambas3
  
  $Log4gambas.Info(LogPrefix("InitializeLogger") & ("Creating ini file with Log4Gambas3 data"))
  
  $Log4gambas.SetAppName(Application.Name)
  $Log4gambas.SetMinLevel($Settings[Constants.LOG4GAMBAS_LEVEL, $Log4gambas.LEVEL_DEBUG])
  $Log4gambas.SetOutput($Settings[Constants.LOG4GAMBAS_OUTPUT, $Log4gambas.OUTPUT_BOTH])
  $Log4gambas.SetLogFile($Settings[Constants.LOG4GAMBAS_LOGFILE, $Log4gambas.GetLogFile()])
  $Log4gambas.SetMaxFileSize($Settings[Constants.LOG4GAMBAS_MAXFILESIZE, $Log4gambas.GetMaxFileSize()])
  $Log4gambas.SetMaxFiles($Settings[Constants.LOG4GAMBAS_MAXFILES, $Log4gambas.GetMaxFiles()])
  
  Return $Log4gambas
  
End

Public Sub SetWhichGallery()
  
  If Enumeration.GalleryType_Private = $Settings[Constants.GLOBAL_GALLERY_TYPE] Then
    $Settings[Constants.GLOBAL_GALLERY_TYPE] = Enumeration.GalleryType_Shared
  Else 
    $Settings[Constants.GLOBAL_GALLERY_TYPE] = Enumeration.GalleryType_Private
  Endif
  $Settings.Save()
  $WhichGallery = $Settings[Constants.GLOBAL_GALLERY_TYPE]
  
End

'================================================
'
'         Private methods
'
'================================================
Private Sub FirstInitializeSettings() '' Initial configuration setup
  
  $Log4gambas.info(LogPrefix("FirstInitializeSettings") & ("Creating ini file with initial data"))
  
  If Not Exist($SettingPath &/ Constants.CONFIG_NAME) Then
    If Not Exist($SettingPath) Then
      Mkdir $SettingPath
    Endif
  Endif
  
  $Settings[Constants.GLOBAL_VERSION] = Application.Version
  $Settings[Constants.GLOBAL_GALLERY_TYPE] = Enumeration.GalleryType_Private
  $Settings[Constants.GLOBAL_GALLERY_TYPE] = Me.WhichGallery
  $Settings[Constants.GLOBAL_APPLICATION_THEME] = $OsTheme
  $Settings[Constants.IMPORT_DELETE_ORIGINALS] = False
  $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB] = 2048
  $Settings[Constants.GLOBAL_DELETED_MAX_COUNT] = 10000
  $Settings[Constants.IMPORT_SHOW_SUMMARY] = True
  $Settings.Save()
  
Catch
  $Log4gambas.Error(LogPrefix("FirstInitializeSettings") & ("Error while creating settings directory") & Error.Text)
  Error.Raise(LogPrefix("FirstInitializeSettings") & ("Error while creating settings directory") & Error.Text)
  
End

Private Function FirstInitializeLogger() As Log4Gambas3
  
  $Log4gambas.info(LogPrefix("FirstInitializeLogger") & ("Creating logger with initial data"))
  
  If Not Exist($LogPath) Then
    Mkdir $LogPath
  Endif
  
  $Settings[Constants.LOG4GAMBAS_LEVEL] = $Log4gambas.GetMinLevel()
  $Settings[Constants.LOG4GAMBAS_OUTPUT] = $Log4gambas.OUTPUT_BOTH
  $Settings[Constants.LOG4GAMBAS_LOGFILE] = $LogPath
  $Settings[Constants.LOG4GAMBAS_MAXFILESIZE] = $Log4gambas.GetMaxFileSize()
  $Settings[Constants.LOG4GAMBAS_MAXFILES] = $Log4gambas.GetMaxFiles()
  $Settings.Save()
  
End

Private Function FindOSTheme() As Integer
  
  Dim iBgColor As Integer = Color.Background
  Dim fBrightness As Float
  Dim vR, vG, iB As Integer
  
  ' Extract RGB components
  vR = Color[iBgColor].Red
  vG = Color[iBgColor].Green
  iB = Color[iBgColor].Blue
  
  ' Compute brightness (luminance)
  fBrightness = (vR * 0.299 + vG * 0.587 + iB * 0.114)
  
  ' If brightness is below 128, use dark theme
  If fBrightness < 128 Then
    Return Enumeration.APP_THEME_DARK
  Else
    Return Enumeration.APP_THEME_LIGHT
  Endif
  
  Return 0
  
End

Private Function DetectShareEnabled() As Boolean
  
  Dim sGroupAvailable As String
  Dim aGroup As Array
  Dim aUsers As Array
  Dim bEncontrado As Boolean
  Dim cell As String
  
  ' Verify the group exists
  $Log4gambas.Debug(LogPrefix("DetectShareEnabled") & ("Checking group existence") & " " & Constants.GRUPO_GACELA)
  Shell "getent group " & Constants.GRUPO_GACELA To sGroupAvailable
  If sGroupAvailable = "" Then
    Return False
  Endif
  
  ' Verify the user is in the group
  aGroup = Split(sGroupAvailable, ":")
  aUsers = Split(aGroup[aGroup.Count - 1], ",")
  For Each cell In aUsers
    If Replace(cell, "\n", "") = User.name Then
      bEncontrado = True
    Endif
  Next
  If Not bEncontrado Then
    Return False
  Endif
  
  ' Verify the directory exists
  If Not Exist(Constants.GACELA_SHARED_GALLERY_DIRECTORY) Then
    Return False
  Endif
  
  ' Verify write permissions
  If Exist(Constants.GACELA_SHARED_GALLERY_DIRECTORY) Then
    Try File.Save(Constants.GACELA_SHARED_GALLERY_DIRECTORY &/ ".test", "test")
    If Error Then Return False
    Try Kill Constants.GACELA_SHARED_GALLERY_DIRECTORY &/ ".test"
  Endif
  
  $Settings[Constants.GLOBAL_SHARED_GALLERY_ENABLED] = True
  $Settings.Save()
  
  Return True
  
Catch 
  $Log4gambas.Error(LogPrefix("DetectShareEnabled") & ("Error detecting whether the shared directory is active") & " " & Error.Text)
  Error.Propagate
  
End

' =======================================================
'
'       Methods for public properties
'
' =======================================================
Function IsFirstRun_Read() As Boolean
  
  Return $IsFirstRun
  
End

Function WhichGallery_Read() As Integer
  
  Return $WhichGallery
  
End

Function GalleryPath_Read() As String
  
  If $WhichGallery = Enumeration.GalleryType_Private Then
    Return User.Home &/ Constants.GACELA_GALLERY_DIRECTORY
  Else
    Return Constants.GACELA_SHARED_GALLERY_DIRECTORY
  Endif
  
End

Function IsSharedGalleryAvailable_Read() As Boolean
  
  Return $IsSharedEnabled
  
End

Function DeleteOriginals_Read() As Boolean
  
  Return $Settings[Constants.IMPORT_DELETE_ORIGINALS, False]
  
End

Sub DeleteOriginals_Write(value As Boolean)
  
  $Settings[Constants.IMPORT_DELETE_ORIGINALS] = Value
  $Settings.Save()
  
End

Private Function LogLevel_Read() As Integer
  
  Return $Settings[Constants.LOG4GAMBAS_LEVEL]
  
End

Private Sub LogLevel_Write(Value As Integer)
  
  $Settings[Constants.LOG4GAMBAS_LEVEL] = Value
  $Settings.Save()
  
  $Log4gambas.SetMinLevel($Settings[Constants.LOG4GAMBAS_LEVEL, $Log4gambas.LEVEL_DEBUG])
  
End

Private Function LogOutput_Read() As Integer
  
  Return $Settings[Constants.LOG4GAMBAS_OUTPUT]
  
End

Private Sub LogOutput_Write(Value As Integer)
  
  $Settings[Constants.LOG4GAMBAS_OUTPUT] = Value
  $Settings.Save()
  
  $Log4gambas.SetOutput($Settings[Constants.LOG4GAMBAS_OUTPUT, $Log4gambas.OUTPUT_BOTH])
  
End

Private Function LogSize_Read() As Integer
  
  Return $Settings[Constants.LOG4GAMBAS_MAXFILESIZE] / 1024 / 1024
  
End

Private Sub LogSize_Write(Value As Integer)
  
  $Log4gambas.SetMaxFileSize(Value * 1024 * 1024)
  
  $Settings[Constants.LOG4GAMBAS_MAXFILESIZE] = $Log4gambas.GetMaxFileSize()
  $Settings.Save()
  
  
End

Private Function LogFiles_Read() As Integer
  
  Return $Settings[Constants.LOG4GAMBAS_MAXFILES]
  
End

Private Sub LogFiles_Write(Value As Integer)
  
  $Settings[Constants.LOG4GAMBAS_MAXFILES] = Value
  $Settings.Save()
  
  $Log4gambas.SetMaxFiles($Settings[Constants.LOG4GAMBAS_MAXFILES, $Log4gambas.GetMaxFiles()])
  
End

Private Function LogPath_Read() As String
  
  Return $Settings[Constants.LOG4GAMBAS_LOGFILE]
  
End

Private Sub LogPath_Write(Value As String)
  
  $Settings[Constants.LOG4GAMBAS_LOGFILE] = Value
  $Settings.Save()
  
  $Log4gambas.SetLogFile($Settings[Constants.LOG4GAMBAS_LOGFILE, $Log4gambas.GetLogFile()])
  
End

Private Function DeletedMaxSizeMB_Read() As Integer
  
  $DeletedMaxSizeMB = $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB, 2048]
  Return $DeletedMaxSizeMB
  
End

Private Sub DeletedMaxSizeMB_Write(Value As Integer)
  
  $DeletedMaxSizeMB = Value
  $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB] = Value
  $Settings.Save()
  
End

Private Function DeletedMaxCount_Read() As Integer
  
  $DeletedMaxCount = $Settings[Constants.GLOBAL_DELETED_MAX_COUNT, 1000]
  Return $DeletedMaxCount
  
End

Private Sub DeletedMaxCount_Write(Value As Integer)
  
  $DeletedMaxCount = Value
  $Settings[Constants.GLOBAL_DELETED_MAX_COUNT] = Value
  $Settings.Save()
  
End

Private Function ImportShowSummary_Read() As Boolean
  
  $ImportShowSummary = $Settings[Constants.IMPORT_SHOW_SUMMARY, True]
  Return $ImportShowSummary
  
End

Private Sub ImportShowSummary_Write(Value As Boolean)
  
  $ImportShowSummary = Value
  $Settings[Constants.IMPORT_SHOW_SUMMARY] = Value
  $Settings.Save()
  
End

Private Function LogPrefix(methodName As String) As String
  
  Return $Titulo & "[" & methodName & "] "
  
End
