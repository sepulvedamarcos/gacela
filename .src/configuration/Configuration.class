' Gambas class file

'
' Class Configuration
'
'
Private $Settings As Settings                                                 '' Settings file handler
Private $SettingPath As String                                                '' Settings file path
Private $IsFirstRun As Boolean = False                                        '' First run indicator
Private $WhichGallery As Integer = Enumeration.GalleryType_Private            '' Active gallery type
Private $AppPath As String                                                    '' Application files path
Private $Logger As LoggerPort                                                 '' Logger instance
Private $OsTheme As Integer                                                   '' Current OS theme
Private $AppTheme As Integer                                                  '' Application theme
Private $IsSharedEnabled As Boolean                                           '' Shared gallery directory enabled
Private $Titulo As String = "Configuration"
Private $LogMessage As LogMessage
Private $LogLevel As Integer
Private $LogOutput As Integer
Private $LogPath As String                                                    '' Log file path
Private $LogSize As Integer
Private $LogFiles As Integer
Private $DeletedMaxSizeMB As Integer
Private $DeletedMaxCount As Integer
Private $ImportShowSummary As Boolean
Private $MoveToTrashSummary As Boolean
Private $ShowMainToolbar As Boolean
Private $ShowMainStatusbar As Boolean
Private $DontShowAgainMoveTrash As Boolean
Private $DontShowAgainImportImages As Boolean

Property Read WhichGallery As Integer                                         '' Which gallery is active
Property Read IsFirstRun As Boolean                                           '' First execution indicator
Property Read GalleryPath As String                                           '' Gallery path
Property Read IsSharedGalleryAvailable As Boolean                             '' Shared gallery is available
Property Read DatabaseProvider As String
Property Read StorageProvider As String
Property DeleteOriginals As Boolean                                           '' Delete originals images after import
Property LogLevel As Integer
Property LogOutput As Integer
Property LogPath As String
Property LogSize As Integer
Property LogFiles As Integer
Property DeletedMaxSizeMB As Integer
Property DeletedMaxCount As Integer
Property ImportShowSummary As Boolean
Property MoveToTrashSummary As Boolean                                      '' Indicate dialog summary is show it
Property ShowMainToolbar As Boolean
Property ShowMainStatusBar As Boolean
Property DontShowAgainMoveTrash As Boolean
Property DontShowAgainImportImages As Boolean

'============================================
'
'      Public methods
'
'============================================

Public Sub _new()
  
  $SettingPath = User.Home &/ Constants.GACELA_SETTING_DIRECTORY
  $LogPath = User.Home &/ Constants.GACELA_LOG_DIRECTORY
  $OsTheme = FindOSTheme()
  
  $Settings = New Settings($SettingPath &/ Constants.CONFIG_NAME)
  $Logger = LoggerFactory.Create($Settings)
  If $Settings.Count = 0 Then
    $LogMessage = New LogMessage($Titulo, "_new", ("First launch detected. The application will be configured in private mode."))
    $Logger.Info($LogMessage)
    $IsFirstRun = True
    FirstInitializeSettings()
    FirstInitializeLogger()
  Endif
  
  MigrateLoggerSettings()
  
  $IsSharedEnabled = DetectShareEnabled()
  
Catch
  $LogMessage = New LogMessage($Titulo, "_new", ("Error initializing configuration: ") & Error.Text)
  $Logger.Error($LogMessage)
  Error.Raise($LogMessage.ToText())
  
End

Public Sub InitializeEnvironment()
  
  $LogMessage = New LogMessage($Titulo, "InitializeEnvironment", "Initializing environment")
  $Logger.Info($LogMessage)
  
  If $Settings[Constants.GLOBAL_GALLERY_TYPE, Null] = Null Then
    If $Settings["Global/LibraryType", Null] <> Null Then
      $Settings[Constants.GLOBAL_GALLERY_TYPE] = $Settings["Global/LibraryType"]
      $Settings.Save()
    Else
      $LogMessage = New LogMessage($Titulo, "InitializeEnvironment", "Problems loading initial configuration")
      Error.Raise($LogMessage.ToText())
    Endif
  Endif
  
  If $Settings[Constants.GLOBAL_SHARED_GALLERY_ENABLED, Null] = Null Then
    If $Settings["Global/Shared", Null] <> Null Then
      $Settings[Constants.GLOBAL_SHARED_GALLERY_ENABLED] = $Settings["Global/Shared"]
    Endif
  Endif
  
  If $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB, Null] = Null Then
    $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB] = 2048
  Endif
  
  If $Settings[Constants.GLOBAL_DELETED_MAX_COUNT, Null] = Null Then
    $Settings[Constants.GLOBAL_DELETED_MAX_COUNT] = 10000
  Endif
  
  If $Settings[Constants.IMPORT_SHOW_SUMMARY, Null] = Null Then
    $Settings[Constants.IMPORT_SHOW_SUMMARY] = True
  Endif
  
  If $Settings[Constants.MOVETRASH_SHOW_SUMMARY, Null] = Null Then
    $Settings[Constants.MOVETRASH_SHOW_SUMMARY] = True
  Endif
  
  If $Settings[Constants.GLOBAL_SHOWMAINTOOLBAR, Null] = Null Then
    $Settings[Constants.GLOBAL_SHOWMAINTOOLBAR] = True
  Endif
  
  If $Settings[Constants.GLOBAL_SHOWMAINSTATUSBAR, Null] = Null Then
    $Settings[Constants.GLOBAL_SHOWMAINSTATUSBAR] = True
  Endif
  
  If $Settings[Constants.GLOBAL_DATABASE_PROVIDER, Null] = Null Then
    $Settings[Constants.GLOBAL_DATABASE_PROVIDER] = Constants.DATABASE_PROVIDER_SQLITE
  Endif
  
  If $Settings[Constants.GLOBAL_STORAGE_PROVIDER, Null] = Null Then
    $Settings[Constants.GLOBAL_STORAGE_PROVIDER] = Constants.STORAGE_PROVIDER_LOCAL
  Endif
  
  If $Settings[Constants.DONTSHOWAGAIN_MOVETRASH, Null] = Null Then
    $Settings[Constants.DONTSHOWAGAIN_MOVETRASH] = True
  Endif
  
  If $Settings[Constants.DONTSHOWAGAIN_IMPORT, Null] = Null Then
    $Settings[Constants.DONTSHOWAGAIN_IMPORT] = True
  Endif
  
  $WhichGallery = $Settings[Constants.GLOBAL_GALLERY_TYPE]
  $AppTheme = $Settings[Constants.GLOBAL_APPLICATION_THEME, Enumeration.APP_THEME_OS]
  $DeletedMaxSizeMB = $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB, 2048]
  $DeletedMaxCount = $Settings[Constants.GLOBAL_DELETED_MAX_COUNT, 10000]
  $ImportShowSummary = $Settings[Constants.IMPORT_SHOW_SUMMARY, True]
  $MoveToTrashSummary = $Settings[Constants.MOVETRASH_SHOW_SUMMARY, True]
  $ShowMainToolbar = $Settings[Constants.GLOBAL_SHOWMAINTOOLBAR, True]
  $ShowMainStatusbar = $Settings[Constants.GLOBAL_SHOWMAINSTATUSBAR, True]
  $DontShowAgainMoveTrash = $Settings[Constants.DONTSHOWAGAIN_MOVETRASH, True]
  $DontShowAgainImportImages = $Settings[Constants.DONTSHOWAGAIN_IMPORT, True]
  
  $Settings.Save()
  
End

Private Function DatabaseProvider_Read() As String
  
  Return LCase($Settings[Constants.GLOBAL_DATABASE_PROVIDER, Constants.DATABASE_PROVIDER_SQLITE])
  
End

Private Function StorageProvider_Read() As String
  
  Return LCase($Settings[Constants.GLOBAL_STORAGE_PROVIDER, Constants.STORAGE_PROVIDER_LOCAL])
  
End

Public Function InitializeLogger() As LoggerPort
  
  $LogMessage = New LogMessage($Titulo, "InitializeLogger", ("Creating logger with configured data"))
  $Logger.Info($LogMessage)
  
  $Logger.SetAppName(Application.Name)
  $Logger.SetMinLevel($Settings[Constants.LOGGER_LEVEL, $Logger.GetDefaultLevelDebug()])
  $Logger.SetOutput($Settings[Constants.LOGGER_OUTPUT, $Logger.GetDefaultOutputBoth()])
  $Logger.SetLogFile($Settings[Constants.LOGGER_LOGFILE, $Logger.GetLogFile()])
  $Logger.SetMaxFileSize($Settings[Constants.LOGGER_MAXFILESIZE, $Logger.GetMaxFileSize()])
  $Logger.SetMaxFiles($Settings[Constants.LOGGER_MAXFILES, $Logger.GetMaxFiles()])
  
  Return $Logger
  
End

Public Sub SetWhichGallery()
  
  If Enumeration.GalleryType_Private = $Settings[Constants.GLOBAL_GALLERY_TYPE] Then
    $Settings[Constants.GLOBAL_GALLERY_TYPE] = Enumeration.GalleryType_Shared
  Else 
    $Settings[Constants.GLOBAL_GALLERY_TYPE] = Enumeration.GalleryType_Private
  Endif
  $Settings.Save()
  $WhichGallery = $Settings[Constants.GLOBAL_GALLERY_TYPE]
  
End

'================================================
'
'         Private methods
'
'================================================
Private Sub FirstInitializeSettings() '' Initial configuration setup
  
  $LogMessage = New LogMessage($Titulo, "FirstInitializeSettings", ("Creating ini file with initial data"))
  $Logger.Info($LogMessage)
  
  If Not Exist($SettingPath &/ Constants.CONFIG_NAME) Then
    If Not Exist($SettingPath) Then
      Mkdir $SettingPath
    Endif
  Endif
  
  $Settings[Constants.GLOBAL_VERSION] = Application.Version
  $Settings[Constants.GLOBAL_GALLERY_TYPE] = Enumeration.GalleryType_Private
  $Settings[Constants.GLOBAL_GALLERY_TYPE] = Me.WhichGallery
  $Settings[Constants.GLOBAL_APPLICATION_THEME] = $OsTheme
  $Settings[Constants.IMPORT_DELETE_ORIGINALS] = False
  $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB] = 2048
  $Settings[Constants.GLOBAL_DELETED_MAX_COUNT] = 10000
  $Settings[Constants.IMPORT_SHOW_SUMMARY] = True
  $Settings[Constants.MOVETRASH_SHOW_SUMMARY] = True
  $Settings[Constants.GLOBAL_SHOWMAINTOOLBAR] = True
  $Settings[Constants.GLOBAL_SHOWMAINSTATUSBAR] = True
  $Settings[Constants.DONTSHOWAGAIN_MOVETRASH] = True
  $Settings[Constants.DONTSHOWAGAIN_IMPORT] = True
  
  $Settings.Save()
  
Catch
  $LogMessage = New LogMessage($Titulo, "FirstInitializeSettings", ("Error while creating settings directory") & Error.Text)
  $Logger.Error($LogMessage)
  Error.Raise($LogMessage.ToText())
  
End

Private Function FirstInitializeLogger() As LoggerPort
  
  $LogMessage = New LogMessage($Titulo, "FirstInitializeLogger", ("Creating logger with initial data"))
  $Logger.Info($LogMessage)
  
  If Not Exist($LogPath) Then
    Mkdir $LogPath
  Endif
  
  $Settings[Constants.LOGGER_LEVEL] = $Logger.GetMinLevel()
  $Settings[Constants.LOGGER_OUTPUT] = $Logger.GetDefaultOutputBoth()
  $Settings[Constants.LOGGER_LOGFILE] = $LogPath
  $Settings[Constants.LOGGER_MAXFILESIZE] = $Logger.GetMaxFileSize()
  $Settings[Constants.LOGGER_MAXFILES] = $Logger.GetMaxFiles()
  $Settings.Save()
  
End

Private Sub MigrateLoggerSettings()
  
  Dim bChanged As Boolean
  
  bChanged = MigrateSetting(Constants.LOGGER_PROVIDER, "Log4Gambas/Provider", "log4gambas") Or bChanged
  bChanged = MigrateSetting(Constants.LOGGER_LEVEL, "Log4Gambas/Level", $Logger.GetDefaultLevelDebug()) Or bChanged
  bChanged = MigrateSetting(Constants.LOGGER_OUTPUT, "Log4Gambas/Output", $Logger.GetDefaultOutputBoth()) Or bChanged
  bChanged = MigrateSetting(Constants.LOGGER_LOGFILE, "Log4Gambas/LogFile", $LogPath) Or bChanged
  bChanged = MigrateSetting(Constants.LOGGER_MAXFILESIZE, "Log4Gambas/MaxFilesSize", $Logger.GetMaxFileSize()) Or bChanged
  bChanged = MigrateSetting(Constants.LOGGER_MAXFILES, "Log4Gambas/MaxFiles", $Logger.GetMaxFiles()) Or bChanged
  
  If bChanged Then
    $Settings.Save()
  Endif
  
End

Private Function MigrateSetting(sNewKey As String, sLegacyKey As String, vDefaultValue As Variant) As Boolean
  
  If $Settings[sNewKey, Null] <> Null Then
    Return False
  Endif
  
  If $Settings[sLegacyKey, Null] <> Null Then
    $Settings[sNewKey] = $Settings[sLegacyKey]
  Else
    $Settings[sNewKey] = vDefaultValue
  Endif
  
  Return True
  
End

Private Function FindOSTheme() As Integer
  
  Dim iBgColor As Integer = Color.Background
  Dim fBrightness As Float
  Dim vR, vG, iB As Integer
  
  ' Extract RGB components
  vR = Color[iBgColor].Red
  vG = Color[iBgColor].Green
  iB = Color[iBgColor].Blue
  
  ' Compute brightness (luminance)
  fBrightness = (vR * 0.299 + vG * 0.587 + iB * 0.114)
  
  ' If brightness is below 128, use dark theme
  If fBrightness < 128 Then
    Return Enumeration.APP_THEME_DARK
  Else
    Return Enumeration.APP_THEME_LIGHT
  Endif
  
  Return 0
  
End

Private Function DetectShareEnabled() As Boolean
  
  Dim sGroupAvailable As String
  Dim aGroup As Array
  Dim aUsers As Array
  Dim bEncontrado As Boolean
  Dim cell As String
  
  ' Verify the group exists
  $LogMessage = New LogMessage($Titulo, "DetectShareEnabled", ("Checking group existence") & " " & Constants.GRUPO_GACELA)
  $Logger.Debug($LogMessage)
  Shell "getent group " & Constants.GRUPO_GACELA To sGroupAvailable
  If sGroupAvailable = "" Then
    Return False
  Endif
  
  ' Verify the user is in the group
  aGroup = Split(sGroupAvailable, ":")
  aUsers = Split(aGroup[aGroup.Count - 1], ",")
  For Each cell In aUsers
    If Replace(cell, "\n", "") = User.name Then
      bEncontrado = True
    Endif
  Next
  If Not bEncontrado Then
    Return False
  Endif
  
  ' Verify the directory exists
  If Not Exist(Constants.GACELA_SHARED_GALLERY_DIRECTORY) Then
    Return False
  Endif
  
  ' Verify write permissions
  If Exist(Constants.GACELA_SHARED_GALLERY_DIRECTORY) Then
    Try File.Save(Constants.GACELA_SHARED_GALLERY_DIRECTORY &/ ".test", "test")
    If Error Then Return False
    Try Kill Constants.GACELA_SHARED_GALLERY_DIRECTORY &/ ".test"
  Endif
  
  $Settings[Constants.GLOBAL_SHARED_GALLERY_ENABLED] = True
  $Settings.Save()
  
  Return True
  
Catch 
  $LogMessage = New LogMessage($Titulo, "DetectShareEnabled", ("Error detecting whether the shared directory is active") & " " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

' =======================================================
'
'       Methods for public properties
'
' =======================================================
Function IsFirstRun_Read() As Boolean
  
  Return $IsFirstRun
  
End

Function WhichGallery_Read() As Integer
  
  Return $WhichGallery
  
End

Function GalleryPath_Read() As String
  
  If $WhichGallery = Enumeration.GalleryType_Private Then
    Return User.Home &/ Constants.GACELA_GALLERY_DIRECTORY
  Else
    Return Constants.GACELA_SHARED_GALLERY_DIRECTORY
  Endif
  
End

Function IsSharedGalleryAvailable_Read() As Boolean
  
  Return $IsSharedEnabled
  
End

Function DeleteOriginals_Read() As Boolean
  
  Return $Settings[Constants.IMPORT_DELETE_ORIGINALS, False]
  
End

Sub DeleteOriginals_Write(value As Boolean)
  
  $Settings[Constants.IMPORT_DELETE_ORIGINALS] = Value
  $Settings.Save()
  
End

Private Function LogLevel_Read() As Integer
  
  Return $Settings[Constants.LOGGER_LEVEL, $Logger.GetDefaultLevelDebug()]
  
End

Private Sub LogLevel_Write(Value As Integer)
  
  $Settings[Constants.LOGGER_LEVEL] = Value
  $Settings.Save()
  
  $Logger.SetMinLevel($Settings[Constants.LOGGER_LEVEL, $Logger.GetDefaultLevelDebug()])
  
End

Private Function LogOutput_Read() As Integer
  
  Return $Settings[Constants.LOGGER_OUTPUT, $Logger.GetDefaultOutputBoth()]
  
End

Private Sub LogOutput_Write(Value As Integer)
  
  $Settings[Constants.LOGGER_OUTPUT] = Value
  $Settings.Save()
  
  $Logger.SetOutput($Settings[Constants.LOGGER_OUTPUT, $Logger.GetDefaultOutputBoth()])
  
End

Private Function LogSize_Read() As Integer
  
  Return $Settings[Constants.LOGGER_MAXFILESIZE, $Logger.GetMaxFileSize()] / 1024 / 1024
  
End

Private Sub LogSize_Write(Value As Integer)
  
  $Logger.SetMaxFileSize(Value * 1024 * 1024)
  
  $Settings[Constants.LOGGER_MAXFILESIZE] = $Logger.GetMaxFileSize()
  $Settings.Save()
  
End

Private Function LogFiles_Read() As Integer
  
  Return $Settings[Constants.LOGGER_MAXFILES, $Logger.GetMaxFiles()]
  
End

Private Sub LogFiles_Write(Value As Integer)
  
  $Settings[Constants.LOGGER_MAXFILES] = Value
  $Settings.Save()
  
  $Logger.SetMaxFiles($Settings[Constants.LOGGER_MAXFILES, $Logger.GetMaxFiles()])
  
End

Private Function LogPath_Read() As String
  
  Return $Settings[Constants.LOGGER_LOGFILE, $Logger.GetLogFile()]
  
End

Private Sub LogPath_Write(Value As String)
  
  $Settings[Constants.LOGGER_LOGFILE] = Value
  $Settings.Save()
  
  $Logger.SetLogFile($Settings[Constants.LOGGER_LOGFILE, $Logger.GetLogFile()])
  
End

Private Function DeletedMaxSizeMB_Read() As Integer
  
  $DeletedMaxSizeMB = $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB, 2048]
  Return $DeletedMaxSizeMB
  
End

Private Sub DeletedMaxSizeMB_Write(Value As Integer)
  
  $DeletedMaxSizeMB = Value
  $Settings[Constants.GLOBAL_DELETED_MAX_SIZE_MB] = Value
  $Settings.Save()
  
End

Private Function DeletedMaxCount_Read() As Integer
  
  $DeletedMaxCount = $Settings[Constants.GLOBAL_DELETED_MAX_COUNT, 1000]
  Return $DeletedMaxCount
  
End

Private Sub DeletedMaxCount_Write(Value As Integer)
  
  $DeletedMaxCount = Value
  $Settings[Constants.GLOBAL_DELETED_MAX_COUNT] = Value
  $Settings.Save()
  
End

Private Function ImportShowSummary_Read() As Boolean
  
  $ImportShowSummary = $Settings[Constants.IMPORT_SHOW_SUMMARY, True]
  Return $ImportShowSummary
  
End

Private Sub ImportShowSummary_Write(Value As Boolean)
  
  $ImportShowSummary = Value
  $Settings[Constants.IMPORT_SHOW_SUMMARY] = Value
  $Settings.Save()
  
End

Private Function MoveToTrashSummary_Read() As Boolean
  
