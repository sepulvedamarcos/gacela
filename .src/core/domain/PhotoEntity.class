' Gambas class file

'
' Gambas class file - PhotoEntity
' Domain model for representing a photo in Gacela
'
'  Remember that variable names should not match class names, even in lowercase, because Gambas treats them as the same.

' Private model properties
Private $Id As Integer = 0
Private $FileName As String = ""
Private $WidthPixels As Integer = 0
Private $HeightPixels As Integer = 0
Private $CreationDate As Date
Private $ImportDate As Date
Private $Description As String = ""
Private $Stars As Integer = 0
Private $ImportUser As String = ""
Private $ImagePath As String = ""
Private $OriginalPath As String = ""
Private $Hash256 As String = ""
Private $Thumbnail As String
Private $LastSyncDate As Date
Private $SyncStatus As Integer = "0"
Private $IsSoftDeleted As Boolean = False
Private $SoftDeleteDate As Date
Private $SoftDeleteBy As String = ""
Private $SoftDeleteAuto As Date
Private $IsLocked As Boolean = False
Private $LockedBy As String = ""
Private $LockedReason As String = ""
Private $LockedDate As Date
' =============================================
'
'            PUBLIC PROPERTIES
'
'==============================================
Property Id As Integer                    '' Unique photo ID
Property FileName As String               '' Original file name
Property WidthPixels As Integer           '' Width in pixels
Property HeightPixels As Integer          '' Height in pixels
Property CreationDate As Date             '' Photo creation date (from EXIF metadata)
Property ImportDate As Date               '' Import date into Gacela
Property Description As String            '' Photo description
Property Stars As Integer                 '' Photo star rating
Property ImportUser As String             '' User who imported the photo
Property ImagePath As String              '' Path to the physical image
Property OriginalPath As String           '' Original source path
Property Hash256 As String                '' Hash of the image used for uniqueness
Property Thumbnail As String              '' Thumbnail
Property LastSyncDate As Date             '' Last sync date
Property SyncStatus As Integer             '' Sync status
Property IsSoftDeleted As Boolean            '' Indicates if it was deleted
Property SoftDeleteDate As Date           '' Deletion date
Property SoftDeleteBy As String           '' User who performed the deletion
Property SoftDeleteAuto As Date           '' Date when it will be removed from the trash
Property IsLocked As Boolean              '' Indicates if the image is locked for deletion
Property LockedBy As String               '' User who locked the image
Property LockedReason As String           '' Reason for image lock
Property LockedDate As Date               '' Date to locked
Property Read HasThumbnail As Boolean     '' Indicates if it has a thumbnail
'=================================================
'
'        Getters and Setters
'
'=================================================

Private Function Id_Read() As Integer

  Return $Id

End

Private Sub Id_Write(iValue As Integer)

  $Id = iValue

End

Private Function FileName_Read() As String

  Return $FileName

End

Private Sub FileName_Write(sValue As String)

  $FileName = sValue

End

Private Function WidthPixels_Read() As Integer

  Return $WidthPixels

End

Private Sub WidthPixels_Write(iValue As Integer)

  $WidthPixels = iValue

End

Private Function HeightPixels_Read() As Integer

  Return $HeightPixels

End

Private Sub HeightPixels_Write(iValue As Integer)

  $HeightPixels = iValue

End

Private Function CreationDate_Read() As Date

  Return $CreationDate

End

Private Sub CreationDate_Write(value As Date)

  $CreationDate = value

End

Private Function ImportDate_Read() As Date

  Return $ImportDate

End

Private Sub ImportDate_Write(value As Date)

  $ImportDate = value

End

Private Function LastSyncDate_Read() As Date

  Return $LastSyncDate

End

Private Sub LastSyncDate_Write(LastSync As Date)

  $LastSyncDate = LastSync

End

Private Function Description_Read() As String

  Return $Description

End

Private Sub Description_Write(sValue As String)

  $Description = sValue

End

Private Function ImportUser_Read() As String

  Return $ImportUser

End

Private Function OriginalPath_Read() As String
  
  Return $OriginalPath
  
End

Private Sub OriginalPath_Write(sValue As String)
  
  $OriginalPath = sValue
  
End

Private Sub ImportUser_Write(sValue As String)

  $ImportUser = sValue

End

Private Function IsSoftDeleted_Read() As Boolean

  Return $IsSoftDeleted

End

Private Sub IsSoftDeleted_Write(bIsSoftDeleted As Boolean)

  $IsSoftDeleted = bIsSoftDeleted

End

Private Function Thumbnail_Read() As String

  Return $Thumbnail

End

Private Sub Thumbnail_Write(sValue As String)

  $Thumbnail = sValue

End

Private Function HasThumbnail_Read() As Boolean

  Return $Thumbnail <> Null And $Thumbnail.Len > 0

End

Private Function Stars_Read() As Integer

  Return $Stars

End

Private Sub Stars_Write(iValue As Integer)

  $Stars = iValue

End

Private Function ImagePath_Read() As String

  Return $ImagePath

End

Private Sub ImagePath_Write(sValue As String)

  $ImagePath = sValue

End

Private Function Hash256_Read() As String

  Return $Hash256

End

Private Sub Hash256_Write(sValue As String)

  $Hash256 = sValue

End

Private Function SyncStatus_Read() As Integer

  Return $SyncStatus

End

Private Sub SyncStatus_Write(iValue As Integer)

  $SyncStatus = iValue

End

Private Function SoftDeleteDate_Read() As Date

  Return $SoftDeleteDate

End

Private Sub SoftDeleteDate_Write(Value As Date)

  $SoftDeleteDate = value

End

Private Function SoftDeleteBy_Read() As String

  Return $SoftDeleteBy

End

Private Sub SoftDeleteBy_Write(sValue As String)

  $SoftDeleteBy = sValue

End

Private Function SoftDeleteAuto_Read() As Date

  Return $SoftDeleteAuto

End

Private Sub SoftDeleteAuto_Write(Value As Date)

  $SoftDeleteAuto = value

End

Private Function IsLocked_Read() As Boolean

  Return $IsLocked

End

Private Sub IsLocked_Write(bIsLocked As Boolean)

  $IsLocked = bIsLocked

End

Private Function LockedBy_Read() As String

  Return $LockedBy

End

Private Sub LockedBy_Write(sValue As String)

  $LockedBy = sValue

End

Private Function LockedReason_Read() As String

  Return $LockedReason

End

Private Sub LockedReason_Write(sValue As String)

  $LockedReason = sValue

End

Private Function LockedDate_Read() As Date

  Return $LockedDate

End

Private Sub LockedDate_Write(Value As Date)

  $LockedDate = Value

End
