' Gambas class file

Private $FilePath As String
Private $FileName As String
Private $Status As Integer
Private $Reason As String
Private $Message As String

Property FilePath As String                                                '' Absolute path of the file processed
Property FileName As String                                                '' Simple name of the file processed
Property Status As Integer                                                 '' Success or Failure status code
Property Reason As String                                                  '' Short reason for failure
Property Message As String                                                 '' Detailed description of the result

Public Sub _new(Optional sFileName As String = "", Optional iStatus As Integer = 0, Optional sMessage As String = "")
  
  $FileName = sFileName
  $Status = iStatus
  $Message = sMessage
  
End

Private Function FilePath_Read() As String
  
  Return $FilePath
  
End

Private Sub FilePath_Write(sValue As String)
  
  $FilePath = sValue
  
End

Private Function FileName_Read() As String
  
  Return $FileName
  
End

Private Sub FileName_Write(sValue As String)
  
  $FileName = sValue
  
End

Private Function Status_Read() As Integer
  
  Return $Status
  
End

Private Sub Status_Write(iValue As Integer)
  
  $Status = iValue
  
End

Private Function Reason_Read() As String
  
  Return $Reason
  
End

Private Sub Reason_Write(sValue As String)
  
  $Reason = sValue
  
End

Private Function Message_Read() As String
  
  Return $Message
  
End

Private Sub Message_Write(sValue As String)
  
  $Message = sValue
  
End
