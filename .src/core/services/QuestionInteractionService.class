' Gambas class file

' QuestionInteractionService.class

Private $Logger As LoggerPort
Private $ShouldNotShowAgain As Boolean = False
Private $Titulo As String = "QuestionInteractionService"
Private $LogMessage As LogMessage

Property ShouldNotShowAgain As Boolean

Public Sub _new(cLogger As LoggerPort)
  
  $Logger = cLogger
  
End

' Determina si el sistema debe realizar la pregunta al usuario (Regla de Negocio)
Public Function ShouldAsk(cConfiguration As Configuration, sConfigKey As String) As Boolean
  
  Select Case sConfigKey
    Case Constants.ASKBEFORE_MOVETRASH
      Return cConfiguration.ShouldAskBeforeMoveTrash
    Case Constants.ASKBEFORE_IMPORT
      Return cConfiguration.ShouldAskBeforeImport
    Case Constants.ASKBEFORE_LOCK
      Return cConfiguration.ShouldAskBeforeLock
    Case Else
      Return True ' Por defecto preguntamos si no conocemos la clave
  End Select
  
End

' Centraliza la persistencia de la decisión del usuario (DRY)
Public Sub SaveUserDecision(cConfiguration As Configuration, sConfigKey As String, shouldNotShowAgain As Boolean)
  
  If Not shouldNotShowAgain Then Return ' Si no marcó el flag, no hacemos nada
  
  $LogMessage = New LogMessage($Titulo, "SaveUserDecision", "User decided to not show again for: " & sConfigKey)
  $Logger.Info($LogMessage)
  
  ' Si el usuario marcó "No volver a mostrar", seteamos el ASKBEFORE en False
  Select Case sConfigKey
    Case Constants.ASKBEFORE_MOVETRASH
      cConfiguration.ShouldAskBeforeMoveTrash = False
    Case Constants.ASKBEFORE_IMPORT
      cConfiguration.ShouldAskBeforeImport = False
    Case Constants.ASKBEFORE_LOCK
      cConfiguration.ShouldAskBeforeLock = False
  End Select
  
End

Private Function ShouldNotShowAgain_Read() As Boolean
  Return $ShouldNotShowAgain
End

Private Sub ShouldNotShowAgain_Write(Value As Boolean)
  $ShouldNotShowAgain = Value
End
