' Gambas class file

Private $SelectedEntities As PhotoEntity[]

Event SelectionChanged(iCount As Integer, hasSelection As Boolean)        '' Fired when selection count or state changes
Event LockChanged(oPhoto As PhotoEntity, isLocked As Boolean)            '' Fired when a lock toggle is requested
Event DeleteRequested(oPhoto As PhotoEntity)                            '' Fired when a permanent delete is requested

Property Read SelectedCount As Integer                                     '' Current number of selected items

Public Sub _new()                                                          '' Initializes a new selection session
  
  $SelectedEntities = New PhotoEntity[]
  
End

Public Sub ToggleLock(oPhoto As PhotoEntity)                               '' Requests a lock/unlock toggle for a photo
  
  If oPhoto = Null Then Return
  Raise LockChanged(oPhoto, Not oPhoto.IsLocked)
  
End

Public Sub DeletePermanently(oPhoto As PhotoEntity)                         '' Requests a permanent deletion for a photo
  
  If oPhoto = Null Then Return
  Raise DeleteRequested(oPhoto)
  
End

Public Function HasSelection() As Boolean                                  '' Returns true if at least one item is selected
  
  Return $SelectedEntities.Count > 0
  
End

Public Function IsSelected(iPhotoId As Integer) As Boolean                 '' Checks if a specific photo ID is currently selected
  
  Return FindIndexById(iPhotoId) >= 0
  
End

Public Function GetSelectedEntities() As PhotoEntity[]                    '' Returns a copy of the list of selected entities
  
  Dim oResponse As New PhotoEntity[]
  
  For Each oPhoto As PhotoEntity In $SelectedEntities
    oResponse.Add(oPhoto)
  Next
  
  Return oResponse
  
End

Public Function GetSelectedIds() As Integer[]                             '' Returns a list of IDs of the selected entities
  
  Dim aIds As New Integer[]
  Dim oPhoto As PhotoEntity
  
  For Each oPhoto In $SelectedEntities
    aIds.Add(oPhoto.Id)
  Next
  
  Return aIds
  
End

Public Sub Select(oPhoto As PhotoEntity)                                   '' Adds a photo entity to the selection
  
  If oPhoto = Null Then Return
  If FindIndexById(oPhoto.Id) >= 0 Then Return
  
  $SelectedEntities.Add(oPhoto)
  RaiseSelectionChanged()
  
End

Public Sub Unselect(oPhoto As PhotoEntity)                                 '' Removes a photo entity from the selection
  
  Dim iIndex As Integer
  
  If oPhoto = Null Then Return
  
  iIndex = FindIndexById(oPhoto.Id)
  If iIndex < 0 Then Return
  
  $SelectedEntities.Remove(iIndex)
  RaiseSelectionChanged()
  
End

Public Sub Clear()                                                         '' Clears all selected items
  
  $SelectedEntities = New PhotoEntity[]
  RaiseSelectionChanged()
  
End

Private Function FindIndexById(iPhotoId As Integer) As Integer
  
  Dim iIndex As Integer
  
  For iIndex = 0 To $SelectedEntities.Max
    If $SelectedEntities[iIndex].Id = iPhotoId Then Return iIndex
  Next
  
  Return -1
  
End

Private Function SelectedCount_Read() As Integer
  
  Return $SelectedEntities.Count
  
End

Private Sub RaiseSelectionChanged()
  
  Raise SelectionChanged($SelectedEntities.Count, HasSelection())

End
