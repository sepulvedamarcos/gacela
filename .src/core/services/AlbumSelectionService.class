' Gambas class file

Private $SelectedEntities As AlbumEntity[]  '' list of album entities selected

Property Read SelectedCount As Integer '' indicate how items selected

Public Sub _new()
  
  $SelectedEntities = New AlbumEntity[]
  
End

Public Function HasSelection() As Boolean
  
  Return $SelectedEntities.Count > 0
  
End

Public Function GetSelectedAlbumEntities() As AlbumEntity[]
  
  Dim oResponse As New AlbumEntity[]
  
  For Each oAlbum As AlbumEntity In $SelectedEntities
    oResponse.Add(oAlbum)
  Next
  
  Return oResponse
  
End

Public Sub AddAlbumSelected(oAlbum As AlbumEntity)
  
  If oAlbum = Null Then Return
  
  For Each oCurrentAlbum As AlbumEntity In $SelectedEntities
    If oCurrentAlbum.Id = oAlbum.Id Then Return
  Next
  
  $SelectedEntities.Add(oAlbum)
  
End

Public Sub Clear()
  
  $SelectedEntities = New AlbumEntity[]
  
End

Private Function SelectedCount_Read() As Integer
  
  Return $SelectedEntities.Count
  
End
