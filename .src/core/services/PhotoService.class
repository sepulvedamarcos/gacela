Public Function MarkPhotoForDeletion(photoId As Integer, Optional deletedBy As String, Optional deletedAuto As Boolean = False) As Boolean
  
  ' TODO: move file to deleted directory and enforce limits before DB update.
  If deletedBy = "" Then deletedBy = User.Name
  
  Return $PhotoRepository.MarkPhotoAsDeleted(photoId, deletedBy, deletedAuto)
  
Catch
  $Log4gambas.Error($Titulo & "Problems marking photo for deletion")
  Error.Propagate
  
End

Public Function PermanentlyDeletePhoto(photoId As Integer) As Boolean
  
  ' TODO: delete physical file and related rows before DB purge.
  Return $PhotoRepository.PermanentlyDeletePhoto(photoId)
  
Catch
  $Log4gambas.Error($Titulo & "Problems permanently deleting photo")
  Error.Propagate
  
End

Public Sub InsertSeedData()
  
  $Log4gambas.Info($Titulo & ("Initial load inserting test data into photos table..."))
  
  Dim sSeedPath1 As String
  Dim sSeedPath2 As String
  
  sSeedPath1 = Constants.PHOTO_SEED_1
  sSeedPath2 = Constants.PHOTO_SEED_2
  
  If Not SavePhoto(sSeedPath1, "Sample image 1") Then Error.Raise("Error inserting photo 1")
  Wait 0.5
  If Not SavePhoto(sSeedPath2, "Sample image 2") Then Error.Raise("Error inserting photo 2")
  
  $Log4gambas.Info($Titulo & ("Test data inserted successfully"))
  
Catch
  $Log4gambas.Error($Titulo & ("Error inserting test photo") & ", " & Error.Text)
  
End

Public Sub ToggleGallery(iGallery As Integer)
  
  Dim bIsNewDb As Boolean
  
  If Not ($Configuration.WhichGallery = iGallery) Then
    $Configuration.SetWhichGallery()
    $PhotoRepository.SwitchGallery()
  Endif
  
  bIsNewDb = $PhotoRepository.IsNewDatabase()
  If $Configuration.IsFirstRun Or bIsNewDb Then
    InsertSeedData()
  Endif
  
 Catch
   $Log4gambas.Error(("Error changing gallery"))
   Error.Propagate
  
End

Public Sub ImportPhotos(imagesPath As String[], Optional albumNam As String, Optional albumDes As String, Optional albumId As Integer = 0) As String[]
  
  Dim sPhoto As String
  Dim iI As Integer
  Dim bDeleteOriginals As Boolean
  Dim oAlbumEntity As New AlbumEntity
  Dim oPhotoSummary As New String[]
  Dim sResp As String
  
  If albumId = 0 Then
    If albumNam <> "" Then
      oAlbumEntity.Name = albumNam
      oAlbumEntity.Description = albumDes
      oAlbumEntity.CreationUser = User.Name
      albumId = $PhotoRepository.CreateAlbum(oAlbumEntity)
    End If
    
  End If
  
  bDeleteOriginals = $Configuration.DeleteOriginals
  
  For Each sPhoto In imagesPath
    iI += 1
    $Log4gambas.Debug($Titulo & "Archivo a procesar " & sPhoto)
    sResp = SavePhoto(sPhoto, "", albumId, iI, bDeleteOriginals)
    If sResp <> "" Then
      $Log4gambas.Debug($Titulo & "Image has an import error: " & sPhoto)
      oPhotoSummary.Add("NOK" & File.BaseName(sPhoto) & "." & File.Ext(sPhoto))
    Else 
      $Log4gambas.Debug($Titulo & "Image saved successfully: " & sPhoto)
      oPhotoSummary.Add("OK" & File.BaseName(sPhoto) & "." & File.Ext(sPhoto))
    End If
    
  Next
  
  Return oPhotoSummary
  
Catch
  $Log4gambas.Error("Error inserting photo " & Error.Text)
  
End

Public Function GetPhotoIterator() As PhotoIterator
  
  Return New PhotoIterator($PhotoRepository, $Log4gambas)
  
End

Public Function FindAlbums(Optional text As String, Optional id As Integer = 0, Optional useSoftDelete As Integer = -1) As AlbumEntity[]
  
  $Log4gambas.Debug($Titulo & "Search albums: [" & text & "] use softdelete [" & useSoftDelete & "]")
  
  Return $PhotoRepository.FindAlbums(text, id, useSoftDelete)
  
End

Public Function AddAlbum(name As String, description As String) As Boolean
  
  Dim oAlbum As New AlbumEntity
  Dim iKey As Integer
  
  oAlbum.Name = name
  oAlbum.Description = description
  oAlbum.CreationUser = User.Name
  
  $Log4gambas.Debug($Titulo & ("Creating album entity to persist"))
  iKey = $PhotoRepository.CreateAlbum(oAlbum)
  If iKey Then
    Return True
  Endif
  
  Return False
  
Catch
  $Log4gambas.Error($Titulo & ("Problems creating an album"))
  Error.Propagate
  
End

Public Function RemoveAlbum(id As Integer) As Boolean
  
  Dim iKey As Integer
  
  $Log4gambas.Debug($Titulo & ("Deleting album entity") & Str(id))
  iKey = $PhotoRepository.DeleteAlbum(id)
  
  If iKey Then 
    Return True
  Endif
  
  Return False
  
Catch
  $Log4gambas.Error($Titulo & ("Problems deleting an album"))
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================

Private Function SaveImageIO(originalImage As String) As String
  
  Dim sFilename As String = File.BaseName(originalImage) & "." & File.Ext(originalImage)
  Dim sNewPath As String = $Configuration.GalleryPath &/ Format(Now, "yyyymmdd")
  
  $Log4gambas.Debug($Titulo & ("Validating image existence and destination directory"))
  If Not Exist(sNewPath) Then
    Mkdir sNewPath
  Endif
  
  $Log4gambas.Debug($Titulo & ("Attempting to copy image into directory"))
  Copy originalImage To sNewPath &/ sFilename
  $Log4gambas.Debug($Titulo & ("Image copy completed successfully in directory"))
  
  Return sNewPath
  
Catch
  $Log4gambas.Error($Titulo & ("Problem while saving image") & " [" & sFilename & "] : " & Error.Text)
  Error.Propagate
  
End

Private Function DeleteImageIO(originalImage As String) As Boolean
  
  $Log4gambas.Debug($Titulo & ("Attempting to delete image in directory"))
  Kill originalImage
  $Log4gambas.Debug($Titulo & ("Image deletion completed successfully in directory"))
  
Catch
  $Log4gambas.Error($Titulo & ("Problem deleting original image") & " [" & originalImage & "] : " & Error.Text)
  Error.Propagate
  
End

Private Function Hash256Calculate(originalImage As String) As String
  
  Dim sHash256 As String
  
  $Log4gambas.Debug($Titulo & "Calculating Hash256")
  sHash256 = Hash.Sha256(originalImage)
  
  Return sHash256
  
Catch
  $Log4gambas.Error($Titulo & "Problem calculating Hash256 for photo " & originalImage)
  Error.Propagate
  
End

Private Function ValidateFileExist(sFilename As String) As Boolean
  
  Dim sPath As String = $Configuration.GalleryPath
  
  $Log4gambas.Debug($Titulo & ("Validating physical file existence during import ") & sPath &/ Format(Now, "yyyymmdd") &/ sFilename)
  If Exist(sPath &/ Format(Now, "yyyymmdd") &/ sFilename) Then
    $Log4gambas.Debug($Titulo & ("Physical file exists during import") & sPath &/ Format(Now, "yyyymmdd") &/ sFilename)
    Return True
    
  Endif
  
  $Log4gambas.Debug($Titulo & ("Physical file does not exist during import") & sPath &/ Format(Now, "yyyymmdd") &/ sFilename)
  Return False
  
Catch
  $Log4gambas.Error($Titulo & ("Problem validating file existence") & "[" & sFilename & "] : " & Error.Text)
  Error.Propagate
  
End

Private Function CreateThumbnail(oOriginalPhoto As Image, imagenPath As String) As String
  
  Dim oThumbnailImage As Image
  Dim sTempThumbFile As String
  Dim sThumbnailString As String = ""
  ' Dim THUMBNAIL_MIN_BENEFIT As Float = 1.5      ' Generar si reduce al menos 50%
  ' TODO: Create a calculation to decide when to generate a thumbnail
  
  $Log4gambas.Debug($Titulo & "Image size " & oOriginalPhoto.Width & " x " & oOriginalPhoto.Height)
  
  If oOriginalPhoto.Width <= 255 Or oOriginalPhoto.Height <= 255 Then
    $Log4gambas.Debug($Titulo & "Image is below the acceptable range; skipping thumbnail")
  Else
    oThumbnailImage = oOriginalPhoto.Stretch(320, -1)
    sTempThumbFile = Temp() & "." & File.Ext(imagenPath)
    sThumbnailString = oThumbnailImage.ToString(File.Ext(imagenPath), 100)
    File.Save(sTempThumbFile, sThumbnailString)
    sThumbnailString = File.Load(sTempThumbFile)
  Endif
  Try Kill sTempThumbFile
  
  Return sThumbnailString
  
Catch
  $Log4gambas.Error($Titulo & "Problem creating thumbnail for " & File.BaseName(imagenPath) & "." & File.Ext(imagenPath))
  Error.Propagate
  
End

Private Function SavePhoto(sImagenPath As String, sDescription As String, Optional iAlbumId As Integer, Optional iIndex As Integer, Optional bDeletePhoto As Boolean = False) As String
  
  Dim oPhotoE As New PhotoEntity
  Dim oPhotoAlbumE As PhotoAlbumEntity
  Dim oOriginalPhoto As Image
  Dim sImageString As String
  Dim sHash256 As String
  Dim sFilename As String = File.BaseName(sImagenPath) & "." & File.Ext(sImagenPath)
  Dim sNewPath As String
  Dim sResp As String
  Dim sDate As String
  Dim dDate As Date
  
  oOriginalPhoto = Image.Load(sImagenPath)
  sImageString = File.Load(sImagenPath)
  
  $Log4gambas.Debug($Titulo & ("Checking physical file existence during import"))
  If ValidateFileExist(sFilename) Then
    Return ("The file already exists")
  End If
  
  sHash256 = Hash256Calculate(sImageString)
  $Log4gambas.Debug($Titulo & ("Checking file existence by Hash256 in the DB"))
  If $PhotoRepository.ValidateHash256Exist(sHash256) Then
    Return ("The file already exists")
  End If
  
  $Log4gambas.Debug($Titulo & ("Saving image to the import directory"))
  sNewPath = SaveImageIO(sImagenPath)
  
  $Log4gambas.Debug($Titulo & ("Evaluating condition to delete original image"))
  If bDeletePhoto Then
    $Log4gambas.Debug($Titulo & ("Condition true, delete original image"))
    DeleteImageIO(sImagenPath)
  Endif
  
  sDate = $ImageMetadata.GetExifDateTimeOriginal(sNewPath &/ sFilename)
  $Log4gambas.Debug($Titulo & ("Shell return normalize string ") & ": " & sDate)
  dDate = CDate(sDate)
  With oPhotoE
    .FileName = sFilename
    .WidthPixels = oOriginalPhoto.Width
    .HeightPixels = oOriginalPhoto.Height
    .CreationDate = dDate
    .ImportDate = Now()
    .Description = sDescription
    .Stars = 0
    .ImportUser = User.Name
    .ImagePath = sNewPath
    .OriginalPath = sImagenPath
    .Hash256 = sHash256
    .Thumbnail = CreateThumbnail(oOriginalPhoto, sImagenPath)
  End With
  
  If iAlbumId <> 0 Then
    oPhotoAlbumE = New PhotoAlbumEntity
    oPhotoAlbumE.AlbumId = iAlbumId
    oPhotoAlbumE.OrderInAlbum = iIndex
    oPhotoAlbumE.AddedUser = User.Name
  Endif
  
  If Not $PhotoRepository.CreatePhoto(oPhotoE, oPhotoAlbumE) Then
    Return ("Error while saving the photo to the database")
  Endif
  
  Return True 
  
Catch
  If Exist(sNewPath &/ sFilename) Then
    Kill sNewPath &/ sFilename
  Endif
  $Log4gambas.Error($Titulo & ("Error importing photo: ") & Error.Text)
  Error.Propagate
  
End
