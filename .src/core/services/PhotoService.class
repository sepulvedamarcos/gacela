Public Sub InsertSeedData()
  
  $Log4gambas.Info(LogPrefix("InsertSeedData") & ("Initial load inserting test data into photos table..."))
  
  Dim sSeedPath1 As String
  Dim sSeedPath2 As String
  
  sSeedPath1 = Constants.PHOTO_SEED_1
  sSeedPath2 = Constants.PHOTO_SEED_2
  
  If Not SavePhoto(sSeedPath1, "Sample image 1") Then Error.Raise("Error inserting photo 1")
  Wait 0.5
  If Not SavePhoto(sSeedPath2, "Sample image 2") Then Error.Raise("Error inserting photo 2")
  
  $Log4gambas.Info(LogPrefix("InsertSeedData") & ("Test data inserted successfully"))
  
Catch
  $Log4gambas.Error(LogPrefix("InsertSeedData") & ("Error inserting test photo") & ", " & Error.Text)
  
End

Public Sub ToggleGallery(iGallery As Integer)
  
  Dim bIsNewDb As Boolean
  
  If Not ($Configuration.WhichGallery = iGallery) Then
    $Configuration.SetWhichGallery()
    $PhotoRepository.SwitchGallery()
  Endif
  
  bIsNewDb = $PhotoRepository.IsNewDatabase()
  If $Configuration.IsFirstRun Or bIsNewDb Then
    InsertSeedData()
  Endif
  
Catch
  $Log4gambas.Error(LogPrefix("ToggleGallery") & ("Error changing gallery"))
  Error.Propagate
  
End

Public Function ImportPhotos(imagesPath As String[], Optional albumNam As String, Optional albumDes As String, Optional albumId As Integer = 0) As ImportSummary
  
  Dim sPhoto As String
  Dim iI As Integer
  Dim bDeleteOriginals As Boolean
  Dim oAlbumEntity As New AlbumEntity
  Dim oSummary As New ImportSummary
  Dim iResp As Integer
  Dim oItem As ImportSummaryItem
  Dim sFileName As String
  Dim sReason As String
  Dim sMessage As String
  
  If albumId = 0 Then
    If albumNam <> "" Then
      oAlbumEntity.Name = albumNam
      oAlbumEntity.Description = albumDes
      oAlbumEntity.CreationUser = User.Name
      albumId = $PhotoRepository.CreateAlbum(oAlbumEntity)
    End If
    
  End If
  
  bDeleteOriginals = $Configuration.DeleteOriginals
  
  For Each sPhoto In imagesPath
    iI += 1
    $Log4gambas.Debug(LogPrefix("ImportPhotos") & "File to process" & ": " & sPhoto)
    iResp = SavePhoto(sPhoto, "", albumId, iI, bDeleteOriginals)
    sFileName = File.BaseName(sPhoto) & "." & File.Ext(sPhoto)
    oItem = New ImportSummaryItem
    oItem.FilePath = sPhoto
    oItem.FileName = sFileName
    If iResp > Enumeration.RESPONSE_OK Then
      $Log4gambas.Debug(LogPrefix("ImportPhotos") & ("Image has an import error") & ": " & sPhoto)
      If iResp = Enumeration.RESPONSE_FILEEXIST Then
        sReason = ("duplicate")
        sMessage = Constants.RESPONSE_FILEEXIST
      Else If iResp = Enumeration.RESPONSE_DBERROR Then
        sMessage = Constants.RESPONSE_DBERROR
        sReason = ("db_error")
      Else
        sReason = ("error")
        sMessage = Constants.RESPONSE_ERROR
      End If
      oItem.Status = ImportSummary.STATUS_FAIL
      oItem.Reason = sReason
      oItem.Message = sMessage
    Else
      $Log4gambas.Debug(LogPrefix("ImportPhotos") & ("Image saved successfully") & ": " & sPhoto)
      oItem.Status = ImportSummary.STATUS_OK
      oItem.Reason = ("imported")
      oItem.Message = Constants.RESPONSE_OK
    End If
    
    oSummary.AddItem(oItem)
    
  Next
  
  Return oSummary
  
Catch
  $Log4gambas.Error(LogPrefix("ImportPhotos") & "Error inserting photo " & Error.Text)
  Error.Propagate
  
End

Public Function FindAlbums(Optional text As String, Optional id As Integer = 0, Optional useSoftDelete As Integer = -1) As AlbumEntity[]
  
  $Log4gambas.Debug(LogPrefix("FindAlbums") & "Search albums: [" & text & "] use softdelete [" & useSoftDelete & "]")
  
  Return $PhotoRepository.FindAlbums(text, id, useSoftDelete)
  
End

Public Function AddAlbum(name As String, description As String) As Boolean
  
  Dim oAlbum As New AlbumEntity
  Dim iKey As Integer
  
  oAlbum.Name = name
  oAlbum.Description = description
  oAlbum.CreationUser = User.Name
  
  $Log4gambas.Debug(LogPrefix("AddAlbum") & ("Creating album entity to persist"))
  iKey = $PhotoRepository.CreateAlbum(oAlbum)
  If iKey Then
    Return True
  Endif
  
  Return False
  
Catch
  $Log4gambas.Error(LogPrefix("AddAlbum") & ("Problems creating an album"))
  Error.Propagate
  
End

Public Function RemoveAlbum(id As Integer) As Boolean
  
  Dim iKey As Integer
  
  $Log4gambas.Debug(LogPrefix("RemoveAlbum") & ("Deleting album entity") & Str(id))
  iKey = $PhotoRepository.DeleteAlbum(id)
  
  If iKey Then 
    Return True
  Endif
  
  Return False
  
Catch
  $Log4gambas.Error(LogPrefix("RemoveAlbum") & ("Problems deleting an album"))
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================

Private Function SaveImageIO(originalImage As String, sNewPath As String, sFilename As String) As String
  
  $Log4gambas.Debug(LogPrefix("SaveImageIO") & ("Validating image existence and destination directory"))
  If Not Exist(sNewPath) Then
    Mkdir sNewPath
  Endif
  
  $Log4gambas.Debug(LogPrefix("SaveImageIO") & ("Attempting to copy image into directory"))
  Copy originalImage To sNewPath &/ sFilename
  $Log4gambas.Debug(LogPrefix("SaveImageIO") & ("Image copy completed successfully in directory"))
  
  Return sNewPath
  
Catch
  $Log4gambas.Error(LogPrefix("SaveImageIO") & ("Problem while saving image") & " [" & sFilename & "] : " & Error.Text)
  Error.Propagate
  
End

Private Function DeleteImageIO(originalImage As String) As Boolean
  
  $Log4gambas.Debug(LogPrefix("DeleteImageIO") & ("Attempting to delete image in directory"))
  Kill originalImage
  $Log4gambas.Debug(LogPrefix("DeleteImageIO") & ("Image deletion completed successfully in directory"))
  
Catch
  $Log4gambas.Error(LogPrefix("DeleteImageIO") & ("Problem deleting original image") & " [" & originalImage & "] : " & Error.Text)
  Error.Propagate
  
End

Private Function Hash256Calculate(originalImage As String) As String
  
  Dim sHash256 As String
  
  $Log4gambas.Debug(LogPrefix("Hash256Calculate") & "Calculating Hash256")
  sHash256 = Hash.Sha256(originalImage)
  
  Return sHash256
  
Catch
  $Log4gambas.Error(LogPrefix("Hash256Calculate") & "Problem calculating Hash256 for photo " & originalImage)
  Error.Propagate
  
End

Private Function ValidateFileExist(sPath As String, sFilename As String) As Boolean
  
  $Log4gambas.Debug(LogPrefix("ValidateFileExist") & ("Validating physical file existence during import ") & sPath &/ sFilename)
  If Exist(sPath &/ sFilename) Then
    $Log4gambas.Debug(LogPrefix("ValidateFileExist") & ("Physical file exists during import") & sPath &/ sFilename)
    Return True
    
  Endif
  
  $Log4gambas.Debug(LogPrefix("ValidateFileExist") & ("Physical file does not exist during import") & sPath &/ sFilename)
  Return False
  
Catch
  $Log4gambas.Error(LogPrefix("ValidateFileExist") & ("Problem validating file existence") & "[" & sFilename & "] : " & Error.Text)
  Error.Propagate
  
End

Private Function CreateThumbnail(oOriginalPhoto As Image, imagenPath As String) As String
  
  Dim oThumbnailImage As Image
  Dim sTempThumbFile As String
  Dim sThumbnailString As String = ""
  ' Dim THUMBNAIL_MIN_BENEFIT As Float = 1.5      ' Generar si reduce al menos 50%
  ' TODO: Create a calculation to decide when to generate a thumbnail
  
  $Log4gambas.Debug(LogPrefix("CreateThumbnail") & "Image size " & oOriginalPhoto.Width & " x " & oOriginalPhoto.Height)
  
  If oOriginalPhoto.Width <= 255 Or oOriginalPhoto.Height <= 255 Then
    $Log4gambas.Debug(LogPrefix("CreateThumbnail") & "Image is below the acceptable range; skipping thumbnail")
  Else
    oThumbnailImage = oOriginalPhoto.Stretch(320, -1)
    sTempThumbFile = Temp() & "." & File.Ext(imagenPath)
    sThumbnailString = oThumbnailImage.ToString(File.Ext(imagenPath), 100)
    File.Save(sTempThumbFile, sThumbnailString)
    sThumbnailString = File.Load(sTempThumbFile)
  Endif
  Try Kill sTempThumbFile
  
  Return sThumbnailString
  
Catch
  $Log4gambas.Error(LogPrefix("CreateThumbnail") & "Problem creating thumbnail for " & File.BaseName(imagenPath) & "." & File.Ext(imagenPath))
  Error.Propagate
  
End

Private Function SavePhoto(sImagenPath As String, sDescription As String, Optional iAlbumId As Integer, Optional iIndex As Integer, Optional bDeletePhoto As Boolean = False) As Integer
  
  Dim oPhotoE As New PhotoEntity
  Dim oPhotoAlbumE As PhotoAlbumEntity
  Dim oOriginalPhoto As Image
  Dim sImageString As String
  Dim sHash256 As String
  Dim sFilename As String
  Dim sNewPath As String
  Dim sResp As String
  Dim sDate As String
  Dim dDate As Date
  Dim sBaseName As String
  Dim sExt As String
  Dim iSeq As Integer
  
  oOriginalPhoto = Image.Load(sImagenPath)
  sImageString = File.Load(sImagenPath)
  
  sExt = Lower(File.Ext(sImagenPath))
  sNewPath = $Configuration.GalleryPath &/ Format(Now, "yyyymmdd")
  sDate = $ImageMetadata.GetExifDateTimeOriginal(sImagenPath)
  If sDate <> "" Then
    dDate = CDate(sDate)
  Else
    dDate = Now()
  Endif
  
  sBaseName = Format(dDate, "yyyymmddhhmmss")
  sFilename = sBaseName & "." & sExt
  iSeq = 1
  While ValidateFileExist(sNewPath, sFilename)
    sFilename = sBaseName & "_" & Format(iSeq, "000") & "." & sExt
    iSeq += 1
  Wend
  
  sHash256 = Hash256Calculate(sImageString)
  $Log4gambas.Debug(LogPrefix("SavePhoto") & ("Checking file existence by Hash256 in the DB"))
  If $PhotoRepository.ValidateHash256Exist(sHash256) Then
    Return Enumeration.RESPONSE_FILEEXIST
  End If
  
  $Log4gambas.Debug(LogPrefix("SavePhoto") & ("Saving image to the import directory"))
  sNewPath = SaveImageIO(sImagenPath, sNewPath, sFilename)
  
  $Log4gambas.Debug(LogPrefix("SavePhoto") & ("Photo creation date from EXIF or fallback ") & ": " & Format(dDate, "yyyy-mm-dd hh:nn:ss"))
  With oPhotoE
    .FileName = sFilename
    .WidthPixels = oOriginalPhoto.Width
    .HeightPixels = oOriginalPhoto.Height
    .CreationDate = dDate
    .ImportDate = Now()
    .Description = sDescription
    .Stars = 0
    .ImportUser = User.Name
    .ImagePath = sNewPath
    .OriginalPath = sImagenPath
    .Hash256 = sHash256
    .Thumbnail = CreateThumbnail(oOriginalPhoto, sImagenPath)
  End With
  
  If iAlbumId <> 0 Then
    oPhotoAlbumE = New PhotoAlbumEntity
    oPhotoAlbumE.AlbumId = iAlbumId
    oPhotoAlbumE.OrderInAlbum = iIndex
    oPhotoAlbumE.AddedUser = User.Name
  Endif
  
  If Not $PhotoRepository.CreatePhoto(oPhotoE, oPhotoAlbumE) Then
    Return Enumeration.RESPONSE_DBERROR
  Endif
  
  $Log4gambas.Debug(LogPrefix("SavePhoto") & ("Evaluating condition to delete original image"))
  If bDeletePhoto Then
    $Log4gambas.Debug(LogPrefix("SavePhoto") & ("Condition true, delete original image"))
    DeleteImageIO(sImagenPath)
  Endif
  
  Return Enumeration.RESPONSE_OK
  
Catch
  If Exist(sNewPath &/ sFilename) Then
    Kill sNewPath &/ sFilename
  Endif
  $Log4gambas.Error(LogPrefix("SavePhoto") & ("Error importing photo: ") & Error.Text)
  Error.Propagate
  
End

Private Function LogPrefix(methodName As String) As String
  
  Return $Titulo & "[" & methodName & "] "
  
End
