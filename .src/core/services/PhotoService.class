Public Function LoadFirstPage() As PhotoEntity[]
  
  $Iterator.Reset
  Return $Iterator.LoadNextBatch()
  
End

Public Function LoadNextPage() As PhotoEntity[]
  
  ' $cIterator.Reset
  Return $Iterator.LoadNextBatch()
  
End

Public Sub SetAlbumFilter(albumId As Integer)
  
  $Iterator.SetFilterAlbum(albumId)
  
End

