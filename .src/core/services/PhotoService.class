'
'          Private methods
'
' ==================================================

Private Function SaveImageIO(sOriginalImage As String, sNewPath As String, sFilename As String) As String[] ' Return type changed to String[]
  
  Dim sFullNewPath As String = sNewPath &/ sFilename
  
  $LogMessage = New LogMessage($Titulo, "SaveImageIO", ("Validating image existence and destination directory"))
  $Logger.Debug($LogMessage)
  
  ' Ensure destination directory exists
  If Not $FileStorage.Exists(sNewPath) Then 
    Try $FileStorage.EnsureDirectory(sNewPath)
    If Error Then
      $LogMessage = New LogMessage($Titulo, "SaveImageIO", ("Problem creating directory ") & sNewPath & ": " & Error.Text)
      $Logger.Error($LogMessage)
      Return ["ERROR", "Could not create destination directory: " & Error.Text]
    Endif
  Endif
  
  ' Check if physical file already exists at destination
  If $FileStorage.Exists(sFullNewPath) Then
    $LogMessage = New LogMessage($Titulo, "SaveImageIO", ("Physical file already exists at destination: ") & sFullNewPath)
    $Logger.Debug($LogMessage)
    ' Return SKIPPED status and the existing path
    Return ["SKIPPED_PHYSICAL_EXISTS", sFullNewPath]
  Endif
  
  $LogMessage = New LogMessage($Titulo, "SaveImageIO", ("Attempting to copy image from ") & sOriginalImage & " to " & sFullNewPath)
  $Logger.Debug($LogMessage)
  
  Try $FileStorage.SaveFile(sOriginalImage, sFullNewPath)
  
  If Error Then
    $LogMessage = New LogMessage($Titulo, "SaveImageIO", ("Problem while saving image") & " [" & sFullNewPath & "] : " & Error.Text)
    $Logger.Error($LogMessage)
    Return ["ERROR", "Problem while saving image: " & Error.Text]
  Else
    $LogMessage = New LogMessage($Titulo, "SaveImageIO", ("Image copy completed successfully to ") & sFullNewPath)
    $Logger.Debug($LogMessage)
    Return ["SUCCESS", sFullNewPath]
  Endif
  
End

Private Function DeleteImageIO(sOriginalImage As String) As Boolean
  
  $LogMessage = New LogMessage($Titulo, "DeleteImageIO", ("Attempting to delete image in directory"))
  $Logger.Debug($LogMessage)
  $FileStorage.DeleteFile(sOriginalImage)
  $LogMessage = New LogMessage($Titulo, "DeleteImageIO", ("Image deletion completed successfully in directory"))
  $Logger.Debug($LogMessage)
  
Catch
  $LogMessage = New LogMessage($Titulo, "DeleteImageIO", ("Problem deleting original image") & " [" & sOriginalImage & "] : " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Private Function Hash256Calculate(sOriginalImage As String) As String
  
  Dim sHash256 As String
  
  $LogMessage = New LogMessage($Titulo, "Hash256Calculate", "Calculating Hash256")
  $Logger.Debug($LogMessage)
  sHash256 = Hash.Sha256(sOriginalImage)
  
  Return sHash256
  
Catch
  $LogMessage = New LogMessage($Titulo, "Hash256Calculate", "Problem calculating Hash256 for photo " & sOriginalImage)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End
