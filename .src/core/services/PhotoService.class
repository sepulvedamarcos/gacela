' Gambas class file

'
'
' Business logic handler class
'
'
Private $Log4gambas As Log4Gambas3
Private $PhotoRepository As PhotoRepository
Private $Configuration As Configuration
Private $Iterator As PhotoIterator
Private $Titulo As String = "[PhotoService] "
Private $ImageMetadata As ImageMetadataAdapter

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(oLog4gambas As Log4Gambas3, cPhotoRepository As PhotoRepository, cConfiguration As Configuration)
  
  $Log4gambas = oLog4gambas
  $PhotoRepository = cPhotoRepository
  $Configuration = cConfiguration
  $Iterator = New PhotoIterator($PhotoRepository, $Log4gambas)
  $ImageMetadata = New ImageMetadataAdapter($Log4gambas)
  
  Dim bIsNewDb As Boolean
  bIsNewDb = $PhotoRepository.IsNewDatabase()
  If $Configuration.IsFirstRun Or bIsNewDb Then
    InsertSeedData()
  Endif
  
End

Public Function GetAllPhotos() As PhotoEntity[]
  
  Dim aPhotosEntity As PhotoEntity[]
  
  $Log4gambas.Debug($Titulo & ("Fetching all photos"))
  Try aPhotosEntity = $PhotoRepository.GetPhotos()
  If Error Then
    $Log4gambas.Error(("Error reading photos: ") & Error.Text)
    error.Propagate
  Endif
  
  Return aPhotosEntity
  
End

Public Function LoadFirstPage() As PhotoEntity[]
  
  $Iterator.Reset
  Return $Iterator.LoadNextBatch()
  
End

Public Function LoadNextPage() As PhotoEntity[]
  
  ' $cIterator.Reset
  Return $Iterator.LoadNextBatch()
  
End

