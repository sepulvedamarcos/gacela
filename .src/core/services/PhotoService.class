Private Function CreateThumbnail(oOriginalPhoto As Image, sImagenPath As String) As String
  
  Dim oThumbnailImage As Image
  Dim sTempThumbFile As String
  Dim sThumbnailString As String = ""
  
  $LogMessage = New LogMessage($Titulo, "CreateThumbnail", "Image size " & oOriginalPhoto.Width & " x " & oOriginalPhoto.Height)
  $Logger.Debug($LogMessage)
  
  If oOriginalPhoto.Width <= 255 Or oOriginalPhoto.Height <= 255 Then
    $LogMessage = New LogMessage($Titulo, "CreateThumbnail", "Image is below the acceptable range; skipping thumbnail")
    $Logger.Debug($LogMessage)
  Else
    oThumbnailImage = oOriginalPhoto.Stretch(320, -1)
    sTempThumbFile = Temp() & "." & File.Ext(sImagenPath)
    sThumbnailString = oThumbnailImage.ToString(File.Ext(sImagenPath), 100)
    File.Save(sTempThumbFile, sThumbnailString)
    sThumbnailString = File.Load(sTempThumbFile)
  Endif
  Try Kill sTempThumbFile
  
  Return sThumbnailString
  
Catch
  $LogMessage = New LogMessage($Titulo, "CreateThumbnail", "Problem creating thumbnail for " & File.BaseName(sImagenPath) & "." & File.Ext(sImagenPath))
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Private Function SavePhoto(sImagenPath As String, sDescription As String, Optional iAlbumId As Integer, Optional iIndex As Integer, Optional bShouldDeletePhoto As Boolean = False) As Integer
  
  Dim oPhotoE As New PhotoEntity
  Dim oPhotoAlbumE As PhotoAlbumEntity
  Dim oOriginalPhoto As Image
  Dim sImageString As String
  Dim sHash256 As String
  Dim sFilename As String
  Dim sInternalFileName As String
  Dim sNewPath As String
  Dim aResult As String[] ' Added to hold the result from SaveImageIO
  Dim dDate As Date
  Dim sExt As String
  
  ' --- Load original image and get hash ---
  Try oOriginalPhoto = Image.Load(sImagenPath)
  If Error Then
    $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Error loading original image: ") & sImagenPath & ": " & Error.Text)
    $Logger.Error($LogMessage)
    Return Enumeration.RESPONSE_ERROR
  Endif
  
  Try sImageString = File.Load(sImagenPath)
  If Error Then
    $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Error reading original image file: ") & sImagenPath & ": " & Error.Text)
    $Logger.Error($LogMessage)
    Return Enumeration.RESPONSE_ERROR
  Endif
  
  sExt = Lower(File.Ext(sImagenPath))
  sFilename = File.Name(sImagenPath)
  
  sHash256 = Hash256Calculate(sImageString)
  $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Checking file existence by Hash256 in the DB For image: ") & sFilename)
  $Logger.Debug($LogMessage)
  If $PhotoRepository.ValidateHash256Exist(sHash256) Then
    $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Image hash already exists in DB: ") & sFilename)
    $Logger.Debug($LogMessage)
    Return Enumeration.RESPONSE_FILEEXIST ' Hash already exists in DB
  End If
  
  ' --- Prepare destination path ---
  sInternalFileName = sHash256 & "." & sExt
  sNewPath = $Configuration.GalleryPath &/ Format(Now, "yyyymmdd")
  
  ' --- Call SaveImageIO to handle physical file operation ---
  aResult = SaveImageIO(sImagenPath, sNewPath, sInternalFileName)
  
  ' --- Interpret the result from SaveImageIO ---
  Select Case aResult[0]
    Case "SUCCESS" ' File was copied successfully
      sNewPath = aResult[1] ' Get the new path
      $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Image file copied successfully: ") & sNewPath)
      $Logger.Debug($LogMessage)
      ' Proceed to create DB record
      
    Case "SKIPPED_PHYSICAL_EXISTS" ' Physical file already exists, but hash was not in DB
      sNewPath = aResult[1] ' Get the existing path
      $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Image file already existed physically: ") & sNewPath & ".Proceeding To Create DB record.")
      $Logger.Debug($LogMessage)
      ' Proceed to create DB record, as file is in place and hash is new
      
    Case "ERROR" ' Error during file copy
      $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Error during file copy: ") & aResult[1])
      $Logger.Error($LogMessage)
      Return Enumeration.RESPONSE_ERROR ' Propagate the error
      
    Case Else ' Unexpected status
      $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Unexpected status from SaveImageIO:") & aResult[0])
      $Logger.Error($LogMessage)
      Return Enumeration.RESPONSE_ERROR
  End Select
  
  ' --- Extract EXIF date or fallback ---
  dDate = $ImageMetadata.GetExifDateTimeOriginal(sImagenPath)
  $LogMessage = New LogMessage($Titulo, "SavePhoto", "EXIF Date: " & CFloat(dDate))
  $Logger.Debug($LogMessage)
  If CFloat(dDate) = 0 Then
    dDate = Stat(sImagenPath).LastModified
  Endif
  
  ' Ultimate fallback if Stat fails
  If dDate = 0 Then dDate = Now()
  
  $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Photo creation date from EXIF or fallback") & ": " & Format(dDate, " yyyy - mm - dd hh:nn: ss "))
  $Logger.Debug($LogMessage)
  
  ' --- Populate PhotoEntity ---
  With oPhotoE
    .FileName = sFilename
    .WidthPixels = oOriginalPhoto.Width
    .HeightPixels = oOriginalPhoto.Height
    .CreationDate = dDate
    .ImportDate = Now()
    .Description = sDescription
    .Stars = 0
    .ImportUser = User.Name
    .ImagePath = sNewPath ' Use the path returned by SaveImageIO (either new or existing)
    .OriginalPath = sImagenPath
    .Hash256 = sHash256
    .Thumbnail = CreateThumbnail(oOriginalPhoto, sImagenPath)
  End With
  
  ' --- Link to Album if specified ---
  If iAlbumId <> 0 Then
    oPhotoAlbumE = New PhotoAlbumEntity
    oPhotoAlbumE.AlbumId = iAlbumId
    oPhotoAlbumE.OrderInAlbum = iIndex
    oPhotoAlbumE.AddedUser = User.Name
  Endif
  
  ' --- Create DB record ---
  If Not $PhotoRepository.CreatePhoto(oPhotoE, oPhotoAlbumE) Then
    ' If DB creation fails, and the file was newly copied (not skipped), we have an orphaned file.
    ' This logic needs to be robust. For now, we log the DB error.
    $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Failed to create DB record for image:") & sFilename & ".File might be orphaned.")
    $Logger.Error($LogMessage)
    Return Enumeration.RESPONSE_DBERROR
  Endif
  
  ' --- Delete original image if requested and copy was successful ---
  $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Evaluating condition to delete original image "))
  $Logger.Debug($LogMessage)
  If bShouldDeletePhoto Then
    $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Condition true, delete original image "))
    $Logger.Debug($LogMessage)
    ' Delete original image only if copy was successful (SUCCESS or SKIPPED) and delete originals Is Enabled
    If aResult[0] = "SUCCESS" Or aResult[0] = "SKIPPED_PHYSICAL_EXISTS" Then
      DeleteImageIO(sImagenPath)
    Endif
  Endif
  
  Return Enumeration.RESPONSE_OK
  
Catch
  
  $LogMessage = New LogMessage($Titulo, "SavePhoto", ("Unexpected error during photo import process: ") & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate ' Propagate error to caller (e.g. ImportPhotos)
  Return Enumeration.RESPONSE_ERROR ' Ensure a return value in case of no propagation
  
End

Public Function PermanentlyDelete(aSelectedImages As PhotoEntity[]) As Summary  '' Deletes photo entities physically from the trash folder and removes their DB records.
  
  Dim oSummary As New Summary
  Dim oItem As SummaryItem
  Dim oPhoto As PhotoEntity
  Dim sTrashPath As String = User.Home &/ Constants.GACELA_TRASH_DIRECTORY
  Dim iTotal As Integer = aSelectedImages.Count
  Dim iCount As Integer = 0
  Dim sFileName As String
  Dim sFullTrashPath As String
  
  $ShouldCancel = False
  
  For Each oPhoto In aSelectedImages
    If $ShouldCancel Then Break
    
    iCount += 1
    Raise Progress(iCount / iTotal, ("Deleting permanently: ") & oPhoto.FileName)
    
    oItem = New SummaryItem(oPhoto.FileName)
    oItem.FilePath = oPhoto.ImagePath
    
    ' 1. Check if photo is in Trash (soft-deleted)
    If Not oPhoto.IsSoftDeleted Then
      oItem.Status = Summary.STATUS_FAIL
      oItem.Reason = ("not_in_trash")
      oItem.Message = ("Cannot delete: image is not in trash")
      oSummary.AddItem(oItem)
      Continue
    Endif
    
    ' 2. Check Ownership in Shared Gallery
    If $Configuration.WhichGallery = Enumeration.GalleryType_Shared Then
      If oPhoto.SoftDeleteBy <> User.Name Then
        oItem.Status = Summary.STATUS_FAIL
        oItem.Reason = ("not_owner")
        oItem.Message = ("Cannot delete: only the user who trashed it can delete it permanently")
        oSummary.AddItem(oItem)
        Continue
      Endif
    Endif
    
    ' 3. Physical File Deletion from Trash
    sFileName = File.Name(oPhoto.ImagePath)
    sFullTrashPath = sTrashPath &/ sFileName
    
    If $FileStorage.Exists(sFullTrashPath) Then
      Try $FileStorage.DeleteFile(sFullTrashPath)
      If Error Then
        oItem.Status = Summary.STATUS_FAIL
        oItem.Reason = Error.Text
        oItem.Message = ("Error deleting file physically from trash")
        $LogMessage = New LogMessage($Titulo, "PermanentlyDelete", ("Error deleting physical file: ") & sFullTrashPath & ": " & Error.Text)
        $Logger.Error($LogMessage)
        oSummary.AddItem(oItem)
        Continue
      Endif
    Endif
    
    ' 4. DB Record Deletion
    If $PhotoRepository.PermanentlyDeletePhoto(oPhoto.Id) Then
      oItem.Status = Summary.STATUS_OK
      oItem.Message = ("Deleted permanently")
    Else
      oItem.Status = Summary.STATUS_FAIL
      oItem.Reason = ("db_error")
      oItem.Message = ("Error deleting record from database")
    Endif
    
    oSummary.AddItem(oItem)
    Wait 0.05
  Next
  
  Return oSummary
  
Catch
  $LogMessage = New LogMessage($Titulo, "PermanentlyDelete", "Error in permanent delete: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End
