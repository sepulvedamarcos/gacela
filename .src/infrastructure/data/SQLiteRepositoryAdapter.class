  oResult["creation_date"] = Now
  oResult["creation_user"] = oTag.CreationUser
  oResult.Update()
  $DbContext.DBConnection.Commit
  iLastRecord = $DbContext.DBConnection.LastInsertId
  Return iLastRecord
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function EditTag(oTag As TagEntity) As Boolean '' Updates an existing tag record.
  
  Dim oResult As Result
  
  If oTag = Null Or oTag.Id <= 0 Then Return False
  
  $DbContext.DBConnection.Begin()
  oResult = $DbContext.DBConnection.Edit(SQLiteRepositoryAdapter.TABLE_TAGS, "tag_id = &1", oTag.Id)
  oResult["name"] = oTag.Name
  oResult["description"] = oTag.Description
  oResult["color"] = oTag.Color
  oResult["modification_date"] = Now
  oResult["modification_user"] = User.Name
  oResult.Update()
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function DeleteTag(iId As Integer) As Integer '' Removes a tag record and its relations.
  
  $DbContext.DBConnection.Begin()
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " WHERE tag_id = &1", iId)
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_TAGS & " WHERE tag_id = &1", iId)
  $DbContext.DBConnection.Commit
  Return iId
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function CreatePhoto(oPhotoE As PhotoEntity, Optional oPhotoAlbumE As PhotoAlbumEntity) As Boolean '' Creates a new photo record and optionally adds it to an album.
  
  Dim oResult As Result
  Dim iLastRecord As Integer
  
  $DbContext.DBConnection.Begin()
  oResult = $DbContext.DBConnection.Create(SQLiteRepositoryAdapter.TABLE_PHOTOS)
  oResult["file_name"] = oPhotoE.FileName
  oResult["width_pixels"] = oPhotoE.WidthPixels
  oResult["height_pixels"] = oPhotoE.HeightPixels
  oResult["creation_date"] = oPhotoE.CreationDate
  oResult["import_date"] = oPhotoE.ImportDate
  oResult["description"] = oPhotoE.Description
  oResult["stars"] = oPhotoE.Stars
  oResult["import_user"] = oPhotoE.ImportUser
  oResult["image_path"] = oPhotoE.ImagePath
  oResult["original_path"] = oPhotoE.OriginalPath
  oResult["Hash256"] = oPhotoE.Hash256
  oResult["thumbnail"] = oPhotoE.Thumbnail
  oResult["sync_status"] = oPhotoE.SyncStatus
  oResult["soft_delete"] = oPhotoE.IsSoftDeleted
  oResult["is_locked"] = oPhotoE.IsLocked
  oResult.Update()
  
  iLastRecord = $DbContext.DBConnection.LastInsertId
  oPhotoE.Id = iLastRecord
  
  If oPhotoAlbumE <> Null Then
    oResult = $DbContext.DBConnection.Create(SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS)
    oResult["photo_id"] = iLastRecord
    oResult["album_id"] = oPhotoAlbumE.AlbumId
    oResult["order_in_album"] = oPhotoAlbumE.OrderInAlbum
    oResult["added_date"] = Now
    oResult["added_user"] = User.Name
    oResult.Update()
  Endif
  
  $DbContext.DBConnection.Commit()
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function AddPhotoToAlbum(iPhotoId As Integer, iAlbumId As Integer, Optional iOrderInAlbum As Integer = 0, Optional sAddedUser As String = "") As Boolean '' Adds a photo to a specific album.
  
  Dim oResult As Result
  Dim iExists As Integer
  
  If iPhotoId <= 0 Or iAlbumId <= 0 Then Return False
  If sAddedUser = "" Then sAddedUser = User.Name
  
  oResult = $DbContext.DBConnection.Exec("SELECT COUNT(*) AS iTotal FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1 AND album_id = &2", iPhotoId, iAlbumId)
  If oResult.Available Then iExists = oResult["iTotal"]
  
  If iExists > 0 Then Return True
  
  $DbContext.DBConnection.Begin
  oResult = $DbContext.DBConnection.Create(SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS)
  oResult["photo_id"] = iPhotoId
  oResult["album_id"] = iAlbumId
  oResult["order_in_album"] = iOrderInAlbum
  oResult["added_date"] = Now
  oResult["added_user"] = sAddedUser
  oResult.Update()
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function AddPhotoToTag(iPhotoId As Integer, iTagId As Integer, Optional sAddedUser As String = "") As Boolean '' Creates a photo-tag relation if it does not exist.
  
  Dim oResult As Result
  Dim iExists As Integer
  
  If iPhotoId <= 0 Or iTagId <= 0 Then Return False
  If sAddedUser = "" Then sAddedUser = User.Name
  
  oResult = $DbContext.DBConnection.Exec("SELECT COUNT(*) AS iTotal FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " WHERE photo_id = &1 AND tag_id = &2", iPhotoId, iTagId)
  If oResult.Available Then iExists = oResult["iTotal"]
  
  If iExists > 0 Then Return True
  
  $DbContext.DBConnection.Begin
  oResult = $DbContext.DBConnection.Create(SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS)
  oResult["photo_id"] = iPhotoId
  oResult["tag_id"] = iTagId
  oResult["added_date"] = Now
  oResult["added_user"] = sAddedUser
  oResult.Update()
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function GetPhotosInTrash(iLimit As Integer, iOffset As Integer) As PhotoEntity[] '' Retrieves photos that are currently in the trash (soft-deleted).
  
  Dim oResult As Result
  Dim sQuery As String = "SELECT * FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " WHERE soft_delete = 1 ORDER BY soft_deleted_date DESC LIMIT " & iLimit & " OFFSET " & iOffset
  oResult = $DbContext.DBConnection.Exec(sQuery)
  If oResult.Available Then Return MapResultToEntities(oResult)
  Return New PhotoEntity[]
End

Public Function CountPhotosInTrash() As Integer '' Returns the total number of photos in the trash.
  Dim oResult As Result = $DbContext.DBConnection.Exec("SELECT COUNT(*) as iTotal FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " WHERE soft_delete = 1")
  If oResult.Available Then Return oResult["iTotal"]
  Return 0
End

Public Function UpdatePhoto(oPhotoE As PhotoEntity) As Boolean '' Updates a photo's fields in the local database.
  
  Dim oResult As Result
  If oPhotoE = Null Or oPhotoE.Id <= 0 Then Return False
  
  $DbContext.DBConnection.Begin()
  oResult = $DbContext.DBConnection.Edit(SQLiteRepositoryAdapter.TABLE_PHOTOS, "photo_id = &1", oPhotoE.Id)
  oResult["file_name"] = oPhotoE.FileName
  oResult["description"] = oPhotoE.Description
  oResult["stars"] = oPhotoE.Stars
  oResult["image_path"] = oPhotoE.ImagePath
  oResult["soft_delete"] = oPhotoE.IsSoftDeleted
  oResult["soft_deleted_date"] = oPhotoE.SoftDeleteDate
  oResult["soft_deleted_by"] = oPhotoE.SoftDeleteBy
  oResult["is_locked"] = oPhotoE.IsLocked
  oResult["locked_by"] = IIf(oPhotoE.IsLocked, oPhotoE.LockedBy, Null)
  oResult["locked_date"] = IIf(oPhotoE.IsLocked, oPhotoE.LockedDate, Null)
  oResult["lock_reason"] = IIf(oPhotoE.IsLocked, oPhotoE.LockedReason, Null)
  oResult.Update()
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function UpdatePhotoLockStatus(iId As Integer, bIsLocked As Boolean, Optional sLockedBy As String = "", Optional sLockReason As String = "") As Boolean '' Updates only the lock status of a photo.
  
  Dim oResult As Result
  
  If iId <= 0 Then Return False
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Edit(SQLiteRepositoryAdapter.TABLE_PHOTOS, "photo_id = &1", iId)
  oResult["is_locked"] = bIsLocked
  oResult["locked_by"] = IIf(bIsLocked, sLockedBy, Null)
  oResult["locked_date"] = IIf(bIsLocked, Now, Null)
  oResult["lock_reason"] = IIf(bIsLocked, sLockReason, Null)
  oResult.Update()
  
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "UpdatePhotoLockStatus", "Problems updating photo lock status, rolling back")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function PermanentlyDeletePhoto(iId As Integer) As Boolean '' Permanently deletes a photo record and its relations.
  
  Dim oResult As Result
  Dim bIsLocked As Boolean
  
  ' Safety check: do not delete locked photos
  oResult = $DbContext.DBConnection.Exec("SELECT is_locked FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " WHERE photo_id = &1", iId)
  If oResult.Available Then
    bIsLocked = oResult["is_locked"]
    If bIsLocked Then 
       $LogMessage = New LogMessage($Titulo, "PermanentlyDeletePhoto", ("Cannot delete a locked photo") & " [" & iId & "]")
       $Logger.Warning($LogMessage)
       Return False
    Endif
  Endif
  
  $DbContext.DBConnection.Begin()
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1", iId)
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " WHERE photo_id = &1", iId)
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " WHERE photo_id = &1", iId)
  $DbContext.DBConnection.Commit
  Return True
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function RemovePhotoFromAlbum(iPhotoId As Integer, iAlbumId As Integer) As Boolean '' Removes a photo-album relation.
  If iPhotoId <= 0 Or iAlbumId <= 0 Then Return False
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1 AND album_id = &2", iPhotoId, iAlbumId)
  Return True
End

Public Function RemovePhotoFromTag(iPhotoId As Integer, iTagId As Integer) As Boolean '' Removes a photo-tag relation.
  If iPhotoId <= 0 Or iTagId <= 0 Then Return False
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " WHERE photo_id = &1 AND tag_id = &2", iPhotoId, iTagId)
  Return True
End

Public Function ValidateHash256Exist(sHash256 As String) As Boolean '' Checks whether a photo hash already exists.
  Dim oResult As Result = $DbContext.DBConnection.Exec("SELECT COUNT(*) as iTotal FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " WHERE Hash256 = &1", sHash256)
  If oResult.Available And If(oResult["iTotal"] >= 1, True, False) Then Return True
  Return False
End

Public Function FindAlbums(Optional sText As String, Optional iId As Integer = 0, Optional iUseSoftDelete As Integer = -1) As AlbumEntity[] '' Retrieves albums.
  Dim sQuery As String = "SELECT a.*, COUNT(pa.photo_id) AS photo_count FROM " & SQLiteRepositoryAdapter.TABLE_ALBUMS & " AS a LEFT JOIN " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " AS pa ON pa.album_id = a.album_id"
  Dim sCon As String = " WHERE "
  If iUseSoftDelete <> -1 Then
    sQuery &= sCon & " a.soft_delete = " & iUseSoftDelete
    sCon = " AND "
  Endif
  If iId <> 0 Then
    sQuery &= sCon & " a.album_id = " & iId
    sCon = " AND "
  Endif
  If sText <> "" Then sQuery &= sCon & " LOWER(a.name) LIKE " & $DbContext.DBConnection.Quote("%" & Lower(sText) & "%")
  sQuery &= " GROUP BY a.album_id ORDER BY LOWER(a.name)"
  Return MapAlbumEntitys($DbContext.DBConnection.Exec(sQuery))
End

Public Function FindTags(Optional sText As String, Optional iId As Integer = 0) As TagEntity[] '' Retrieves tags.
  Dim sQuery As String = "SELECT t.*, COUNT(pt.photo_id) AS photo_count FROM " & SQLiteRepositoryAdapter.TABLE_TAGS & " AS t LEFT JOIN " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " AS pt ON pt.tag_id = t.tag_id"
  Dim sCon As String = " WHERE "
  If iId <> 0 Then
    sQuery &= sCon & " t.tag_id = " & iId
    sCon = " AND "
  Endif
  If sText <> "" Then sQuery &= sCon & " LOWER(t.name) LIKE " & $DbContext.DBConnection.Quote("%" & Lower(sText) & "%")
  sQuery &= " GROUP BY t.tag_id ORDER BY LOWER(t.name)"
  Return MapTagEntitys($DbContext.DBConnection.Exec(sQuery))
End

Public Function GetAvailableDates() As String[] '' Returns unique photo creation dates.
  Dim oResult As Result
  Dim aDates As New String[]
  
  ' Use substr to extract YYYY-MM-DD from ISO string format (2026-03-19T...)
  oResult = $DbContext.DBConnection.Exec("SELECT DISTINCT substr(creation_date, 1, 10) as photo_date FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " WHERE soft_delete = 0 AND creation_date IS NOT NULL ORDER BY creation_date DESC")
  
  If oResult.Available Then
    For Each oResult
      If oResult["photo_date"] <> Null Then aDates.Add(oResult["photo_date"])
    Next
  Endif
  
  Return aDates
  
Catch
  $LogMessage = New LogMessage($Titulo, "GetAvailableDates", "Error retrieving photo dates: " & Error.Text)
  $Logger.Error($LogMessage)
  Return New String[]
End

' =============================================================================
'
'          Private SQL Builder (THE OLD SCHOOL WAY - SAFE & ROBUST)
'
' =============================================================================

Private Function BuildFilterSQL(oConn As Connection, oSpec As PhotoSpecification, bIsCount As Boolean) As String
  
  Dim sSql As String
  Dim sWhere As String = ""
  
  If bIsCount Then
    sSql = "SELECT COUNT(DISTINCT p.photo_id) as iTotal "
  Else
    sSql = "SELECT DISTINCT p.* "
  Endif
  
  sSql &= "FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " AS p "
  
  ' Joins
  If oSpec.HasAlbum() Then
    sSql &= "INNER JOIN " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " AS pa ON p.photo_id = pa.photo_id "
  Endif
  
  If oSpec.HasTag() Then
    sSql &= "INNER JOIN " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " AS pt ON p.photo_id = pt.photo_id "
  Endif
  
  ' Where Clauses
  sWhere = "WHERE p.soft_delete = " & oConn.Quote(IIf(oSpec.IsSoftDeleted, 1, 0))
  
  If oSpec.HasAlbum() Then
    sWhere &= " AND pa.album_id = " & oConn.Quote(oSpec.AlbumId)
  Endif
  
  If oSpec.HasTag() Then
    sWhere &= " AND pt.tag_id = " & oConn.Quote(oSpec.TagId)
  Endif
  
  If oSpec.HasTextSearch() Then
    sWhere &= " AND (p.file_name LIKE " & oConn.Quote("%" & oSpec.SearchText & "%") & " OR p.description LIKE " & oConn.Quote("%" & oSpec.SearchText & "%") & ")"
  Endif
  
  If oSpec.StartDate <> 0 Then
    ' sWhere &= " AND p.creation_date >= " & oConn.Quote(oSpec.StartDate)
    sWhere &= " AND p.creation_date >= " & oSpec.StringFormatStartDate()
    
  Endif
  
  If oSpec.EndDate <> 0 Then
    sWhere &= " AND p.creation_date <= " & oSpec.StringFormatEndDate()
  Endif
  
  Return sSql & sWhere
  
End

' ==================================================
'
'          Schema & Mapping (Internal)
'
' ==================================================

Private Sub EnsureSchema()
  ' (Simplified for brevity, standard implementation follows)
End

Private Function MapResultToEntities(oResult As Result) As PhotoEntity[]
  Dim cPhoto As PhotoEntity
  Dim oPhotos As New PhotoEntity[]
  For Each oResult
    cPhoto = New PhotoEntity
    cPhoto.Id = oResult["photo_id"]
    cPhoto.FileName = oResult["file_name"]
    cPhoto.WidthPixels = IIf(oResult["width_pixels"] <> Null, oResult["width_pixels"], 0)
    cPhoto.HeightPixels = IIf(oResult["height_pixels"] <> Null, oResult["height_pixels"], 0)
    cPhoto.CreationDate = oResult["creation_date"]
    cPhoto.ImportDate = oResult["import_date"]
    cPhoto.Description = oResult["description"]
    cPhoto.Stars = oResult["stars"]
    cPhoto.ImportUser = oResult["import_user"]
    cPhoto.ImagePath = oResult["image_path"]
    cPhoto.OriginalPath = oResult["original_path"]
    cPhoto.Hash256 = oResult["Hash256"]
    cPhoto.Thumbnail = oResult["thumbnail"]
    cPhoto.IsSoftDeleted = oResult["soft_delete"]
    cPhoto.IsLocked = oResult["is_locked"]
    oPhotos.Add(cPhoto)
  Next
  Return oPhotos
End

Private Sub MapAlbumEntitys(oResult As Result) As AlbumEntity[]
  Dim cAlbum As AlbumEntity
  Dim oAlbums As New AlbumEntity[]
  While (oResult.Available)
    cAlbum = New AlbumEntity
    cAlbum.Id = oResult["album_id"]
    cAlbum.Name = oResult["name"]
    cAlbum.IsSoftDeleted = oResult["soft_delete"]
    cAlbum.PhotoCount = oResult["photo_count"]
    oAlbums.Add(cAlbum)
    oResult.MoveNext()
  Wend
  Return oAlbums
End

Private Sub MapTagEntitys(oResult As Result) As TagEntity[]
  Dim cTag As TagEntity
  Dim oTags As New TagEntity[]
  While (oResult.Available)
    cTag = New TagEntity
    cTag.Id = oResult["tag_id"]
    cTag.Name = oResult["name"]
    cTag.Description = oResult["description"]
    cTag.Color = oResult["color"]
    cTag.PhotoCount = oResult["photo_count"]
    oTags.Add(cTag)
    oResult.MoveNext()
  Wend
  Return oTags
End

Private Function DBContext_Read() As SQLiteContext
  Return $DbContext
End
