Private Sub CreateDBVersionTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables = Null Then
    $LogMessage = New LogMessage($Titulo, "CreateDBVersionTable", "Tables collection is not available")
    Error.Raise($LogMessage.ToText())
  Endif
  oTable = oDb.Tables.Add("DBVersion")
  If oTable = Null Then
    $LogMessage = New LogMessage($Titulo, "CreateDBVersionTable", "Cannot create table DBVersion")
    Error.Raise($LogMessage.ToText())
  Endif
  With oTable
    .Fields.Add("version", db.String, 10)
    .Update()
  End With
  
End

Private Sub EnsureDBVersion(oDb As Connection)
  
  Dim oResult As Result
  
  oResult = oDb.Exec("SELECT COUNT(*) as total FROM DBVersion")
  If oResult.Available Then
    If oResult["total"] = 0 Then
      oDb.Exec("INSERT INTO DBVersion(version) VALUES(&1)", SCHEMA_VERSION)
    Endif
  Endif
  
End

Private Sub RunMigrations(oDb As Connection)
  
  Dim sCurrentVersion As String
  
  sCurrentVersion = GetDbVersion(oDb)
  If sCurrentVersion = "1.0" Then
    Migrate_1_0_to_1_1(oDb)
    sCurrentVersion = "1.1"
  Endif
  
  If sCurrentVersion = "1.1" Then
    Migrate_1_1_to_1_2(oDb)
    sCurrentVersion = "1.2"
  Endif
  
  If sCurrentVersion = "1.2" Then
    Migrate_1_2_to_1_3(oDb)
    sCurrentVersion = "1.3"
  Endif
  
  If sCurrentVersion = "1.3" Then
    Migrate_1_3_to_1_4(oDb)
  Endif
  
End

Private Function GetDbVersion(oDb As Connection) As String
  
  Dim oResult As Result
  
  oResult = oDb.Exec("SELECT version FROM DBVersion LIMIT 1")
  If oResult.Available Then
    Return oResult["version"]
  Endif
  
  Return ""
  
End

Private Sub SetDbVersion(oDb As Connection, sVersion As String)
  
  oDb.Exec("UPDATE DBVersion SET version = &1", sVersion)
  
End

Private Sub Migrate_1_0_to_1_1(oDb As Connection)
  
  ' Placeholder for future migration logic.
  SetDbVersion(oDb, "1.1")
  
End

Private Sub Migrate_1_1_to_1_2(oDb As Connection)
  
  If Not TableHasColumn(oDb, SQLiteRepositoryAdapter.TABLE_ALBUMS, "modification_date") Then
    Try oDb.Exec("ALTER TABLE " & SQLiteRepositoryAdapter.TABLE_ALBUMS & " ADD COLUMN modification_date DATE")
    If Error Then
      $LogMessage = New LogMessage($Titulo, "Migrate_1_1_to_1_2", "Error adding modification_date column: " & Error.Text)
      $Logger.Error($LogMessage)
      Error.Propagate
    Endif
  Endif
  
  If Not TableHasColumn(oDb, SQLiteRepositoryAdapter.TABLE_ALBUMS, "modification_user") Then
    Try oDb.Exec("ALTER TABLE " & SQLiteRepositoryAdapter.TABLE_ALBUMS & " ADD COLUMN modification_user TEXT(50)")
    If Error Then
      $LogMessage = New LogMessage($Titulo, "Migrate_1_1_to_1_2", "Error adding modification_user column: " & Error.Text)
      $Logger.Error($LogMessage)
      Error.Propagate
    Endif
  Endif
  
  SetDbVersion(oDb, "1.2")
  
End

Private Sub Migrate_1_2_to_1_3(oDb As Connection)
  
  If Not TableHasColumn(oDb, SQLiteRepositoryAdapter.TABLE_TAGS, "modification_date") Then
    Try oDb.Exec("ALTER TABLE " & SQLiteRepositoryAdapter.TABLE_TAGS & " ADD COLUMN modification_date DATE")
    If Error Then
      $LogMessage = New LogMessage($Titulo, "Migrate_1_2_to_1_3", "Error adding tag modification_date column: " & Error.Text)
      $Logger.Error($LogMessage)
      Error.Propagate
    Endif
  Endif
  
  If Not TableHasColumn(oDb, SQLiteRepositoryAdapter.TABLE_TAGS, "modification_user") Then
    Try oDb.Exec("ALTER TABLE " & SQLiteRepositoryAdapter.TABLE_TAGS & " ADD COLUMN modification_user TEXT(50)")
    If Error Then
      $LogMessage = New LogMessage($Titulo, "Migrate_1_2_to_1_3", "Error adding tag modification_user column: " & Error.Text)
      $Logger.Error($LogMessage)
      Error.Propagate
    Endif
  Endif
  
  SetDbVersion(oDb, "1.3")
  
End

Private Sub Migrate_1_3_to_1_4(oDb As Connection)
  
  oDb.Begin()
  
  Try oDb.Exec("ALTER TABLE " & SQLiteRepositoryAdapter.TABLE_TAGS & " RENAME TO tags_old")
  If Error Then
    oDb.Rollback
    $LogMessage = New LogMessage($Titulo, "Migrate_1_3_to_1_4", "Error renaming tags table: " & Error.Text)
    $Logger.Error($LogMessage)
    Error.Propagate
  Endif
  
  Try oDb.Exec("CREATE TABLE " & SQLiteRepositoryAdapter.TABLE_TAGS & " (" &
    "tag_id INTEGER PRIMARY KEY, " &
    "name VARCHAR(100), " &
    "description TEXT, " &
    "color VARCHAR(12), " &
    "creation_date DATE, " &
    "creation_user VARCHAR(50), " &
    "modification_date DATE, " &
    "modification_user VARCHAR(50))")
  If Error Then
    oDb.Rollback
    $LogMessage = New LogMessage($Titulo, "Migrate_1_3_to_1_4", "Error creating migrated tags table: " & Error.Text)
    $Logger.Error($LogMessage)
    Error.Propagate
  Endif
  
  Try oDb.Exec("INSERT INTO " & SQLiteRepositoryAdapter.TABLE_TAGS &
    " (tag_id, name, description, color, creation_date, creation_user, modification_date, modification_user) " &
    "SELECT tag_id, name, description, color, creation_date, creation_user, modification_date, modification_user FROM tags_old")
  If Error Then
    oDb.Rollback
    $LogMessage = New LogMessage($Titulo, "Migrate_1_3_to_1_4", "Error copying tag data: " & Error.Text)
    $Logger.Error($LogMessage)
    Error.Propagate
  Endif
  
  Try oDb.Exec("DROP TABLE tags_old")
  If Error Then
    oDb.Rollback
    $LogMessage = New LogMessage($Titulo, "Migrate_1_3_to_1_4", "Error dropping old tags table: " & Error.Text)
    $Logger.Error($LogMessage)
    Error.Propagate
  Endif
  
  SetDbVersion(oDb, "1.4")
  oDb.Commit
  
End

Private Function TableHasColumn(oDb As Connection, sTableName As String, sColumnName As String) As Boolean
  
  Dim oResult As Result
  
  oResult = oDb.Exec("PRAGMA table_info(" & sTableName & ")")
  While oResult.Available
    If oResult["name"] = sColumnName Then
      Return True
    Endif
    oResult.MoveNext()
  Wend
  
  Return False
  
End

Private Function MapResultToEntities(oResult As Result) As PhotoEntity[]
  
  Dim cPhoto As PhotoEntity
  Dim oPhotos As New PhotoEntity[]
  
  For Each oResult
    cPhoto = New PhotoEntity
    cPhoto.Id = oResult["photo_id"]
    cPhoto.FileName = oResult["file_name"]
    cPhoto.WidthPixels = IIf(oResult["width_pixels"] <> Null, oResult["width_pixels"], 0)
    cPhoto.HeightPixels = IIf(oResult["height_pixels"] <> Null, oResult["height_pixels"], 0)
    cPhoto.CreationDate = oResult["creation_date"]
    cPhoto.ImportDate = oResult["import_date"]
    cPhoto.Description = oResult["description"]
    cPhoto.Stars = oResult["stars"]
    cPhoto.ImportUser = oResult["import_user"]
    cPhoto.ImagePath = oResult["image_path"]
    cPhoto.OriginalPath = oResult["original_path"]
    cPhoto.Hash256 = oResult["Hash256"]
    cPhoto.Thumbnail = oResult["thumbnail"]
    cPhoto.LastSyncDate = oResult["last_sync_date"]
    cPhoto.SyncStatus = oResult["sync_status"]
    cPhoto.IsSoftDeleted = oResult["soft_delete"]
    cPhoto.SoftDeleteDate = oResult["soft_deleted_date"]
    cPhoto.SoftDeleteBy = oResult["soft_deleted_by"]
    cPhoto.SoftDeleteAuto = oResult["soft_deleted_auto"]
    cPhoto.IsLocked = oResult["is_locked"]
    cPhoto.LockedBy = oResult["locked_by"]
    cPhoto.LockedReason = oResult["lock_reason"]
    
    oPhotos.Add(cPhoto)
  Next
  
  Return oPhotos
  
Catch
  $LogMessage = New LogMessage($Titulo, "MapResultToEntities", "Problem mapping Photo data: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Private Sub MapAlbumEntitys(oResult As Result) As AlbumEntity[] '' Map albums
  
  Dim cAlbum As AlbumEntity
  Dim oAlbums As New AlbumEntity[]
  
  While (oResult.Available)
    cAlbum = New AlbumEntity
    
    ' Map all fields
    cAlbum.Id = oResult["album_id"]
    cAlbum.Name = oResult["name"]
    cAlbum.Description = oResult["description"]
    cAlbum.CreationDate = oResult["creation_date"]
    cAlbum.CreationUser = oResult["creation_user"]
    cAlbum.ModificationDate = oResult["modification_date"]
    cAlbum.ModificationUser = oResult["modification_user"]
    cAlbum.Thumbnail = oResult["thumbnail"]
    cAlbum.IsSoftDeleted = oResult["soft_delete"]
    cAlbum.PhotoCount = oResult["photo_count"]
    oAlbums.Add(cAlbum)
    
    oResult.MoveNext()
  Wend
  
  Return oAlbums
  
Catch
  $LogMessage = New LogMessage($Titulo, "MapAlbumEntitys", "Problem mapping cAlbum data")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Private Sub MapTagEntitys(oResult As Result) As TagEntity[] '' Map tags
  
  Dim cTag As TagEntity
  Dim oTags As New TagEntity[]
  
  While (oResult.Available)
    cTag = New TagEntity
    cTag.Id = oResult["tag_id"]
    cTag.Name = oResult["name"]
    cTag.Description = oResult["description"]
    cTag.Color = oResult["color"]
    cTag.CreationDate = oResult["creation_date"]
    cTag.CreationUser = oResult["creation_user"]
    cTag.ModificationDate = oResult["modification_date"]
    cTag.ModificationUser = oResult["modification_user"]
    cTag.PhotoCount = oResult["photo_count"]
    oTags.Add(cTag)
    oResult.MoveNext()
  Wend
  
  Return oTags
  
Catch
  $LogMessage = New LogMessage($Titulo, "MapTagEntitys", "Problem mapping tag data")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Private Function DBContext_Read() As SQLiteContext
  
  Return $DbContext
  
End
