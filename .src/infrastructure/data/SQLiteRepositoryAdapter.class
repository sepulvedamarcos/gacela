  Dim oResult As Result
  Dim iLastRecord As Integer
  
  $DbContext.DBConnection.Begin()
  oResult = $DbContext.DBConnection.Create(SQLiteRepositoryAdapter.TABLE_TAGS)
  oResult["name"] = oTag.Name
  oResult["description"] = oTag.Description
