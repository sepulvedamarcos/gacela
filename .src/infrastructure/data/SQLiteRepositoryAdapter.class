  If oResult.Available Then
    iExists = oResult["iTotal"]
  Endif
  
  If iExists > 0 Then Return True
  
  $DbContext.DBConnection.Begin
  oResult = $DbContext.DBConnection.Create(SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS)
  oResult["photo_id"] = photoId
  oResult["tag_id"] = tagId
  oResult["added_date"] = Now
  oResult["added_user"] = addedUser
  oResult.Update()
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "AddPhotoToTag", "Problem adding photo to tag: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function GetPhotosInTrash(limit As Integer, offset As Integer) As PhotoEntity[] '' Retrieves photos that are currently in the trash (soft-deleted).
  
  Dim oResult As Result
  Dim sQuery As String
  
  $LogMessage = New LogMessage($Titulo, "GetPhotosInTrash", "Fetching soft-deleted photos")
  $Logger.Debug($LogMessage)
  
  sQuery = "SELECT * FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS &
    " WHERE soft_delete = 1" &
    " ORDER BY soft_deleted_date DESC" &
    " LIMIT " & limit &
    " OFFSET " & offset
  
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return MapResultToEntities(oResult)
  Endif
  Return New PhotoEntity[]
  
Catch
  $LogMessage = New LogMessage($Titulo, "GetPhotosInTrash", "Problem retrieving photos from trash: " & Error.Text)
  $Logger.Error($LogMessage)
  Return New PhotoEntity[]
End

Public Function CountPhotosInTrash() As Integer '' Returns the total number of photos in the trash.
  
  Dim oResult As Result
  Dim sQuery As String
  
  sQuery = "SELECT COUNT(*) as iTotal FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS &
    " WHERE soft_delete = 1"
    
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return oResult["iTotal"]
  Endif
  Return 0
  
Catch
  $LogMessage = New LogMessage($Titulo, "CountPhotosInTrash", "Problem counting photos in trash: " & Error.Text)
  $Logger.Error($LogMessage)
  Return 0
End

Public Function UpdatePhoto(photoE As PhotoEntity) As Boolean '' Updates a photo's fields in the local database.
  
  Dim oResult As Result
  
  If photoE = Null Then Return False
  If photoE.Id <= 0 Then Return False
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Edit(SQLiteRepositoryAdapter.TABLE_PHOTOS, "photo_id = &1", photoE.Id)
  oResult["file_name"] = photoE.FileName
  oResult["width_pixels"] = photoE.WidthPixels
  oResult["height_pixels"] = photoE.HeightPixels
  oResult["description"] = photoE.Description
  oResult["stars"] = photoE.Stars
  oResult["image_path"] = photoE.ImagePath
  oResult["original_path"] = photoE.OriginalPath
  oResult["Hash256"] = photoE.Hash256
  oResult["thumbnail"] = photoE.Thumbnail
  oResult["last_sync_date"] = photoE.LastSyncDate
  oResult["sync_status"] = photoE.SyncStatus
  oResult["soft_delete"] = photoE.IsSoftDeleted
  oResult["soft_deleted_date"] = photoE.SoftDeleteDate
  oResult["soft_deleted_by"] = photoE.SoftDeleteBy
  oResult["soft_deleted_auto"] = photoE.SoftDeleteAuto
  oResult["is_locked"] = photoE.IsLocked
  oResult["locked_by"] = photoE.LockedBy
  oResult["locked_date"] = photoE.LockedDate
  oResult["lock_reason"] = photoE.LockedReason
  oResult.Update()
  
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "UpdatePhoto", "Problems updating photo, rolling back")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function PermanentlyDeletePhoto(id As Integer) As Boolean '' Permanently deletes a photo record and its relations.
  
  $DbContext.DBConnection.Begin()
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1", id)
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " WHERE photo_id = &1", id)
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " WHERE photo_id = &1", id)
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "PermanentlyDeletePhoto", ("Problems permanently deleting photo, rolling back"))
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function RemovePhotoFromAlbum(photoId As Integer, albumId As Integer) As Boolean '' Removes a photo-album relation and soft-deletes empty albums.
  
  Dim oResult As Result
  Dim iPhotosInAlbum As Integer
  
  If photoId <= 0 Or albumId <= 0 Then Return False
  
  $DbContext.DBConnection.Begin
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1 AND album_id = &2", photoId, albumId)
  
  oResult = $DbContext.DBConnection.Exec("SELECT COUNT(*) AS iTotal FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE album_id = &1", albumId)
  If oResult.Available Then
    iPhotosInAlbum = oResult["iTotal"]
  Endif
  
  If iPhotosInAlbum = 0 Then
    oResult = $DbContext.DBConnection.Edit(SQLiteRepositoryAdapter.TABLE_ALBUMS)
    oResult["album_id"] = albumId
    oResult["soft_delete"] = True
    oResult.Update()
  Endif
  
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "RemovePhotoFromAlbum", "Problem removing photo from album: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function RemovePhotoFromTag(photoId As Integer, tagId As Integer) As Boolean '' Removes a photo-tag relation.
  
  If photoId <= 0 Or tagId <= 0 Then Return False
  
  $DbContext.DBConnection.Begin
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " WHERE photo_id = &1 AND tag_id = &2", photoId, tagId)
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "RemovePhotoFromTag", "Problem removing photo from tag: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function ValidateHash256Exist(sHash256 As String) As Boolean '' Checks whether a photo hash already exists.
  
  Dim sQuery As String
  Dim iTotal As Integer
  Dim oResult As Result
  
  $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Validating in table with Hash256") & " [" & sHash256 & "]")
  $Logger.Debug($LogMessage)
  sQuery = "SELECT COUNT(*) as iTotal FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS &
    " WHERE Hash256 = &1"
  oResult = $DbContext.DBConnection.Exec(sQuery, sHash256)
  
  If oResult.Available Then
    iTotal = oResult["iTotal"]
    If iTotal >= 1 Then
      $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Image already exists with that Hash256"))
      $Logger.Debug($LogMessage)
      Return True
    End If
  End If
  
  $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Image does not exist"))
  $Logger.Debug($LogMessage)
  Return False
  
Catch
  $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Error searching photo by Hash256"))
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function FindAlbums(Optional text As String, Optional id As Integer = 0, Optional useSoftDelete As Integer = -1) As AlbumEntity[] '' Retrieves albums and their photo counts.
  
  Dim sQuery As String
  Dim oResult As Result
  Dim sCon As String = " WHERE "
  
  sQuery = "SELECT a.*, COUNT(pa.photo_id) AS photo_count " &
    "FROM " & SQLiteRepositoryAdapter.TABLE_ALBUMS & " AS a " &
    "LEFT JOIN " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " AS pa ON pa.album_id = a.album_id"
  If useSoftDelete <> -1 Then
    sQuery &= " WHERE a.soft_delete = " & useSoftDelete
    sCon = " AND "
  Endif
  
  If id <> 0 Then
    sQuery &= sCon & " a.album_id = " & id
    sCon = " AND "
  Endif
  
  If text <> "" Then
    sQuery &= sCon & " LOWER(a.name) LIKE '%" & Lower(text) & "%'"
  Endif
  
  sQuery &= " GROUP BY a.album_id, a.name, a.description, a.creation_date, a.creation_user, a.modification_date, a.modification_user, a.thumbnail, a.soft_delete"
  sQuery &= " ORDER BY LOWER(a.name)"
  
  $LogMessage = New LogMessage($Titulo, "FindAlbums", "Query [" & sQuery & "]")
  $Logger.Debug($LogMessage)
  oResult = $DbContext.DBConnection.Exec(sQuery)
  If oResult.Available Then
    Return MapAlbumEntitys(oResult)
  Endif
  
  Return New AlbumEntity[]
  
Catch
  $LogMessage = New LogMessage($Titulo, "FindAlbums", "Problem reading albums")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function FindTags(Optional text As String, Optional id As Integer = 0) As TagEntity[] '' Retrieves tags and their photo counts.
  
  Dim sQuery As String
  Dim oResult As Result
  Dim sCon As String = " WHERE "
  
  sQuery = "SELECT t.*, COUNT(pt.photo_id) AS photo_count " &
    "FROM " & SQLiteRepositoryAdapter.TABLE_TAGS & " AS t " &
    "LEFT JOIN " & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & " AS pt ON pt.tag_id = t.tag_id"
  
  If id <> 0 Then
    sQuery &= sCon & " t.tag_id = " & id
    sCon = " AND "
  Endif
  
  If text <> "" Then
    sQuery &= sCon & " LOWER(t.name) LIKE '%" & Lower(text) & "%'"
  Endif
  
  sQuery &= " GROUP BY t.tag_id, t.name, t.description, t.color, t.creation_date, t.creation_user, t.modification_date, t.modification_user"
  sQuery &= " ORDER BY LOWER(t.name)"
  
  $LogMessage = New LogMessage($Titulo, "FindTags", "Query [" & sQuery & "]")
  $Logger.Debug($LogMessage)
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return MapTagEntitys(oResult)
  Endif
  
  Return New TagEntity[]
  
Catch
  $LogMessage = New LogMessage($Titulo, "FindTags", "Problem reading tags")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub EnsureSchema()
  
  Dim oDb As Connection
  
  oDb = $DbContext.DBConnection
  If oDb = Null Or oDb.Tables = Null Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Database connection is not ready"))
    Error.Raise($LogMessage.ToText())
  Endif
  
  $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Checking the existence of schema tables..."))
  $Logger.Debug($LogMessage)
  ' 1. Photos table (photos)
  If Not oDb.Tables.Exist(SQLiteRepositoryAdapter.TABLE_PHOTOS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & SQLiteRepositoryAdapter.TABLE_PHOTOS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreatePhotosTable(oDb)
  Endif
  ' 2. Albums table (albums)
  If Not oDb.Tables.Exist(SQLiteRepositoryAdapter.TABLE_ALBUMS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & SQLiteRepositoryAdapter.TABLE_ALBUMS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreateAlbumsTable(oDb)
  Endif
  ' 3. Tags table (tags)
  If Not oDb.Tables.Exist(SQLiteRepositoryAdapter.TABLE_TAGS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & SQLiteRepositoryAdapter.TABLE_TAGS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreateTagsTable(oDb)
  Endif
  ' 4. Photos-Albums relationship table (photo_albums)
  If Not oDb.Tables.Exist(SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreatePhotosAlbumsTable(oDb)
  Endif
  ' 5. Photos-Tags relationship table (photos_tags)
  If Not oDb.Tables.Exist(SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & SQLiteRepositoryAdapter.TABLE_PHOTOS_TAGS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreatePhotosTagsTable(oDb)
  Endif
  
  If Not oDb.Tables.Exist("DBVersion") Then
    CreateDBVersionTable(oDb)
  Endif
  EnsureDBVersion(oDb)
  RunMigrations(oDb)
  
  EnsurePhotosTableColumns(oDb)
  $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Table check and creation finished."))
  $Logger.Debug($LogMessage)
  
Catch
  $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Table check/creation failed:") & " " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Raise($LogMessage.ToText())
  
End

Private Sub CreatePhotosTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables = Null Then
    $LogMessage = New LogMessage($Titulo, "CreatePhotosTable", "Tables collection is not available")
    Error.Raise($LogMessage.ToText())
  Endif
  oTable = oDb.Tables.Add(SQLiteRepositoryAdapter.TABLE_PHOTOS)
  If oTable = Null Then
    $LogMessage = New LogMessage($Titulo, "CreatePhotosTable", "Cannot create table " & SQLiteRepositoryAdapter.TABLE_PHOTOS)
    Error.Raise($LogMessage.ToText())
  Endif
  With oTable
    .Fields.Add("photo_id", db.Serial)                 '' Record identifier
    .Fields.Add("file_name", db.String, 255)           '' Original file name
    .Fields.Add("width_pixels", db.Integer)            '' Width in pixels
    .Fields.Add("height_pixels", db.Integer)           '' Height in pixels
    .Fields.Add("creation_date", db.Date)              '' Photo creation date
    .Fields.Add("import_date", db.Date)                '' Import date into Gacela
    .Fields.Add("description", db.String)              '' Photo description
    .Fields.Add("stars", db.Integer)                   '' Star rating count
    .Fields.Add("import_user", db.String, 50)          '' Importing user
    .Fields.Add("image_path", db.String, 255)          '' Full path to original image
    .Fields.Add("original_path", db.String, 255)       '' Original source path
    .Fields.Add("Hash256", db.String, 255)             '' Image hash for existence validation
    .Fields.Add("thumbnail", db.Blob)                  '' MINIATURA (BLOB)
    .Fields.Add("last_sync_date", db.Date)             '' Last sync date (for future cloud sync)
    .Fields.Add("sync_status", db.Integer)             '' Sync status indicator
    .Fields.Add("soft_delete", db.Boolean)             '' Soft delete (garbage collector)
    .Fields.Add("soft_deleted_date", db.date)          '' Date when it was soft-deleted
    .Fields.Add("soft_deleted_by", db.String, 50)      '' User who deleted it
    .Fields.Add("soft_deleted_auto", db.Date)          '' Date when it should be physically deleted
    .Fields.Add("is_locked", db.Boolean)               '' Indicates if it is locked for deletion
    .Fields.Add("locked_by", db.String, 50)            '' User who locked the photo
    .Fields.Add("locked_date", db.date)                '' Date when it was locked
    .Fields.Add("lock_reason", db.String, 200)         '' Reason why it was locked
    .PrimaryKey = ["photo_id"]                         '' Create primary key
    .Update()
  End With
  
  $LogMessage = New LogMessage($Titulo, "CreatePhotosTable", "[" & SQLiteRepositoryAdapter.TABLE_PHOTOS & "]" & $TableCreate)
  $Logger.Debug($LogMessage)
  
End

Private Sub EnsurePhotosTableColumns(oDb As Connection)
  
  Dim oTable As Table
  Dim oResult As Result
  Dim hasOriginalPath As Boolean
  
  If Not oDb.Tables.Exist(SQLiteRepositoryAdapter.TABLE_PHOTOS) Then Return
  
  oTable = oDb.Tables[SQLiteRepositoryAdapter.TABLE_PHOTOS]
  If oTable = Null Then
    $LogMessage = New LogMessage($Titulo, "EnsurePhotosTableColumns", "Cannot open table " & SQLiteRepositoryAdapter.TABLE_PHOTOS)
    Error.Raise($LogMessage.ToText())
  Endif
  If Not oTable.Fields.Exist("original_path") Then
    Try oDb.Exec("ALTER TABLE " & SQLiteRepositoryAdapter.TABLE_PHOTOS & " ADD COLUMN original_path TEXT")
    If Error Then
      $LogMessage = New LogMessage($Titulo, "EnsurePhotosTableColumns", ("Error adding original_path column") & " " & Error.Text)
      $Logger.Error($LogMessage)
    Endif
  Endif
  
  hasOriginalPath = False
  oResult = oDb.Exec("PRAGMA table_info(" & SQLiteRepositoryAdapter.TABLE_PHOTOS & ")")
  While oResult.Available
    If oResult["name"] = "original_path" Then
      hasOriginalPath = True
      Exit
    Endif
    oResult.MoveNext()
  Wend
  
  If Not hasOriginalPath Then
    $LogMessage = New LogMessage($Titulo, "EnsurePhotosTableColumns", ("Column original_path was not created"))
    $Logger.Warning($LogMessage)
  Endif
  
End

