' Gambas class file

'
'
' Data access class for DB
'
'
Inherits PhotoRepositoryPort

Private $Logger As LoggerPort
Private $DbContext As SQLiteContext
Private $Configuration As Configuration
Private $Titulo As String = "SQLiteRepositoryAdapter"

Private $LogMessage As LogMessage
Public Const TABLE_PHOTOS As String = "photos"
Public Const TABLE_ALBUMS As String = "albums"
Public Const TABLE_TAGS As String = "tags"
Public Const TABLE_PHOTOS_ALBUMS As String = "photo_albums"
Public Const TABLE_PHOTOS_TAGS As String = "photos_tags"
Public Const SCHEMA_VERSION As String = "1.4"

' Private $TableNotExist As String = ("Table does not exist, creating ...")
' Private $TableCreate As String = ("Table created")

Property Read DBContext As SQLiteContext

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(oConfiguration As Configuration, oLogger As LoggerPort) '' Opens the SQLite context and validates schema.
  
  $Logger = oLogger
  $Configuration = oConfiguration
  $DbContext = New SQLiteContext($Configuration, $Logger)
  EnsureSchema()
  
End

Public Function SwitchGallery() As Boolean '' Switches active gallery storage and refreshes schema.
  
  $DbContext.SwitchGallery()
  EnsureSchema()
  
Catch
  Error.Propagate()
  
End

Public Function IsNewDatabase() As Boolean '' Indicates whether the current gallery database was newly created.
  
  Return $DbContext.IsNewDatabase
  
End

Public Function GetPhotos(Optional iId As Integer) As PhotoEntity[]
  
  Dim oPhotoResult As Result
  Dim sQuery As String
  
  $LogMessage = New LogMessage($Titulo, "GetPhotos", "Photo extraction")
  $Logger.Debug($LogMessage)
  
  sQuery = "soft_delete = &1"
  If iId > 0 Then
    sQuery &= " AND photo_id = " & iId
  End If
  
  oPhotoResult = $DbContext.DBConnection.Find(SQLiteRepositoryAdapter.TABLE_PHOTOS, sQuery, False)
  
  If oPhotoResult.Available Then
    Return MapResultToEntities(oPhotoResult)
  Endif
  
Catch
  $LogMessage = New LogMessage($Titulo, "GetPhotos", "Problems retrieving photos " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function FindWithFilters(oSpec As PhotoSpecification, sSortBy As String, sSortOrder As String, iLimit As Integer, iOffset As Integer) As PhotoEntity[] '' Get records with filters
  
  Dim oResult As Result
  Dim sQuery As String
  Dim sOrderBy As String = "import_date"
  Dim sOrderType As String = "desc"
  
  $LogMessage = New LogMessage($Titulo, "FindWithFilters", "Executing query with Specification")
  $Logger.Debug($LogMessage)
  
  If sSortBy <> "" Then
    sOrderBy = sSortBy
  Endif
  If sSortOrder <> "" Then
    sOrderType = sSortOrder
  Endif
  
  sQuery = BuildFilterSQL($DbContext.DBConnection, oSpec, False)
  sQuery &= " ORDER BY " & sOrderBy & " " & sOrderType
  sQuery &= " LIMIT " & iLimit & " OFFSET " & iOffset
  
  $LogMessage = New LogMessage($Titulo, "FindWithFilters", sQuery)
  $Logger.Debug($LogMessage)
  
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return MapResultToEntities(oResult)
  Endif
  Return New PhotoEntity[]
  
Catch
  $LogMessage = New LogMessage($Titulo, "FindWithFilters", "Problem in FindWithFilters: " & Error.Text)
  $Logger.Error($LogMessage)
  Return New PhotoEntity[]
  
End

Public Function CountWithFilters(oSpec As PhotoSpecification) As Integer '' Count records in the photos table
  
  Dim oResult As Result
  Dim sQuery As String
  
  $LogMessage = New LogMessage($Titulo, "CountWithFilters", "Counting photos with Specification")
  $Logger.Info($LogMessage)
  
  sQuery = BuildFilterSQL($DbContext.DBConnection, oSpec, True)
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return oResult["iTotal"]
  Endif
  
  Return 0
  
Catch
  $LogMessage = New LogMessage($Titulo, "CountWithFilters", "Problem in CountWithFilters: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function CreateAlbum(oAlbum As AlbumEntity) As Integer '' Persists a new album and returns its identifier.
  
  Dim oResult As Result
  Dim iLastRecord As Integer
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Create(SQLiteRepositoryAdapter.TABLE_ALBUMS)
  oResult["name"] = oAlbum.Name
  oResult["description"] = oAlbum.Description
  oResult["creation_date"] = Now
  oResult["creation_user"] = oAlbum.CreationUser
  oResult["thumbnail"] = ""
  oResult["soft_delete"] = False
  oResult.Update()
  
  $DbContext.DBConnection.Commit
  iLastRecord = $DbContext.DBConnection.LastInsertId
  Return iLastRecord
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
  
End

Public Function EditAlbum(oAlbum As AlbumEntity) As Boolean '' Updates editable album fields in the local database.
  
  Dim oResult As Result
  
  If oAlbum = Null Then Return False
  If oAlbum.Id <= 0 Then Return False
  
  $DbContext.DBConnection.Begin()
  oResult = $DbContext.DBConnection.Edit(SQLiteRepositoryAdapter.TABLE_ALBUMS, "album_id = &1", oAlbum.Id)
  oResult["name"] = oAlbum.Name
  oResult["description"] = oAlbum.Description
  oResult["modification_date"] = Now
  oResult["modification_user"] = User.Name
  oResult.Update()
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

Public Function DeleteAlbum(iId As Integer) As Integer '' Soft-deletes an album and removes its current relations.
  
  $DbContext.DBConnection.Begin()
  $DbContext.DBConnection.Exec("DELETE FROM " & SQLiteRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE album_id = &1", iId)
  $DbContext.DBConnection.Exec("UPDATE " & SQLiteRepositoryAdapter.TABLE_ALBUMS & " SET soft_delete = 1 WHERE album_id = &1", iId)
  $DbContext.DBConnection.Commit
  Return iId
  
Catch
  $DbContext.DBConnection.Rollback
  Error.Propagate
End

