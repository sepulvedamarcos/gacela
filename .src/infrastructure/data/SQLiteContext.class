' Gambas class file

'
' Gambas class file - SQLiteContext for Gacela
' Handles the SQLite database connection
'
'
Private $DB As Connection
Private $Logger As LoggerPort
Private $Configuration As Configuration
Private $DbGalleryDirectory As String
Private $Titulo As String = "SQLiteContext"
Private $LogMessage As LogMessage
Private $IsNewDatabaseCreated As Boolean = False

Property Read DBConnection As Connection            '' Object connection to database
Property Read IsNewDatabase As Boolean

Public Sub _new(cConfiguration As Configuration, oLogger As LoggerPort)

  $Logger = oLogger
  $Configuration = cConfiguration
  $LogMessage = New LogMessage($Titulo, "_new", ("Initializing SQLite database context"))
  $Logger.Info($LogMessage)

  SwitchGallery()

End

Public Sub SwitchGallery()

  Dim sNewGalleryPath As String

  $IsNewDatabaseCreated = False
  If $Configuration.WhichGallery = Enumeration.GalleryType_Private Then
    sNewGalleryPath = User.Home &/ Constants.GACELA_GALLERY_DIRECTORY
  Else
    sNewGalleryPath = Constants.GACELA_SHARED_GALLERY_DIRECTORY
  Endif

  If $DbGalleryDirectory = sNewGalleryPath Then
    $LogMessage = New LogMessage($Titulo, "SwitchGallery", ("Gallery path has not changed. No reconnection required."))
  $Logger.Debug($LogMessage)
    Return
  Endif

  $DbGalleryDirectory = sNewGalleryPath
  InitializeDatabase()
  $LogMessage = New LogMessage($Titulo, "SwitchGallery", ("Switching database context to:") & " " & $DbGalleryDirectory)
  $Logger.Info($LogMessage)
  ConnectDatabase()

End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub ConnectDatabase()

  $DB = New Connection
  $DB.Type = Constants.DATABASE_SQLITE3
  $DB.Host = $DbGalleryDirectory
  $DB.Name = Constants.DATABASE_NAME

  $LogMessage = New LogMessage($Titulo, "ConnectDatabase", ("Database path:") & " " & $DbGalleryDirectory)
  $Logger.Debug($LogMessage)
  $LogMessage = New LogMessage($Titulo, "ConnectDatabase", ("Database name:") & " " & Constants.DATABASE_NAME)
  $Logger.Debug($LogMessage)
  $LogMessage = New LogMessage($Titulo, "ConnectDatabase", ("Database type:") & " " & Constants.DATABASE_SQLITE3)
  $Logger.Debug($LogMessage)

  Try $DB.Open()

  If Error Then
    $LogMessage = New LogMessage($Titulo, "ConnectDatabase", ("Could not connect to the database:") & " " & Error.Text)
  $Logger.Fatal($LogMessage)
    ERROR.Propagate
  Endif

  $LogMessage = New LogMessage($Titulo, "ConnectDatabase", ("Connection established with:") & " " & $DbGalleryDirectory &/ Constants.DATABASE_NAME)
  $Logger.Debug($LogMessage)

End

Private Sub InitializeDatabase()

  $LogMessage = New LogMessage($Titulo, "InitializeDatabase", ("Checking for Gacela database"))
  $Logger.Info($LogMessage)
  If Not Exist($DbGalleryDirectory &/ Constants.DATABASE_NAME) Then
    $LogMessage = New LogMessage($Titulo, "InitializeDatabase", ("Database file does not exist. Starting creation:") & " " & $DbGalleryDirectory &/ Constants.DATABASE_NAME)
  $Logger.Debug($LogMessage)
    $IsNewDatabaseCreated = True

    CreateDatabase()
  Endif

Catch
  $LogMessage = New LogMessage($Titulo, "InitializeDatabase", ("An error occurred while initializing the database") & " " & Error.Text)
  $Logger.Error($LogMessage)
  ERROR.Propagate

End

Private Sub CreateDatabase()

  'Create a temporary connection to create the DB
  $DB = New Connection
  $DB.Type = Constants.DATABASE_SQLITE3
  $DB.Host = $DbGalleryDirectory
  $DB.Name = "" 'Clear the name so the physical DB can be created

  $DB.Open()
  If Error Then
    $LogMessage = New LogMessage($Titulo, "CreateDatabase", ("Cannot open connection to create DB:") & " " & Error.Text)
  $Logger.Fatal($LogMessage)
    ERROR.Propagate
  Endif

  If Not $DB.Databases.Exist(Constants.DATABASE_NAME) Then 'We already know the DB file does not exist; now ask via connect
    '' NOTE: This is where the database is created
    $DB.Databases.Add(Constants.DATABASE_NAME)
    Wait 0.5 ' Small pause to ensure physical file creation
    If Error Then
      $LogMessage = New LogMessage($Titulo, "CreateDatabase", ("Cannot create database:") & " " & Error.Text)
  $Logger.Fatal($LogMessage)
      $DB.Close()
      ERROR.Propagate
    Endif

    If $DB.Databases.Count = 0 Then ' Extreme fallback: create DB from a preexisting one
      Copy "clear_database" &/ Constants.DATABASE_NAME To $DbGalleryDirectory &/ Constants.DATABASE_NAME
      Wait 0.5
    Endif

  Endif
  $DB.Close()

  $LogMessage = New LogMessage($Titulo, "CreateDatabase", ("Database created successfully"))
  $Logger.Info($LogMessage)

End


' ====================================================
'
' Property to access the connection
'
' ====================================================
Private Function DBConnection_Read() As Connection

  Return $DB

End

Private Function IsNewDatabase_Read() As Boolean

  Return $IsNewDatabaseCreated

End
