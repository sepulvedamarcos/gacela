' Gambas class file

'
' Gambas class file - SQLiteContext for Gacela
' Handles the SQLite database connection
'
'
Private $DB As Connection
Private $Log4Gambas As Log4Gambas3
Private $Configuration As Configuration
Private $DbGalleryDirectory As String
Private $Titulo As String = "[SQLiteContext] "
Private $IsNewBD As Boolean = False

Property Read DBConnection As Connection            '' Object connection to database
Property Read IsNewDatabase As Boolean

Public Sub _new(cConfiguration As Configuration, oLog4gambas As Log4Gambas3)
  
  $Log4Gambas = oLog4gambas
  $Configuration = cConfiguration
  $Log4gambas.Info(LogPrefix("_new") & ("Initializing SQLite database context"))
  
  SwitchGallery()
  
End

Public Sub SwitchGallery()
  
  Dim sNewGalleryPath As String
  
  $IsNewBD = False
  If $Configuration.WhichGallery = Enumeration.GalleryType_Private Then
    sNewGalleryPath = User.Home &/ Constants.GACELA_GALLERY_DIRECTORY
  Else
    sNewGalleryPath = Constants.GACELA_SHARED_GALLERY_DIRECTORY
  Endif
  
  If $DbGalleryDirectory = sNewGalleryPath Then
    $Log4Gambas.Debug(LogPrefix("SwitchGallery") & ("Gallery path has not changed. No reconnection required."))
    Return
  Endif
  
  $DbGalleryDirectory = sNewGalleryPath
  InitializeDatabase()
  $Log4Gambas.Info(LogPrefix("SwitchGallery") & ("Switching database context to:") & " " & $DbGalleryDirectory)
  ConnectDatabase()
  
End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub ConnectDatabase()
  
  $DB = New Connection
  $DB.Type = Constants.DATABASE_SQLITE3
  $DB.Host = $DbGalleryDirectory
  $DB.Name = Constants.DATABASE_NAME
  
  $Log4Gambas.Debug(LogPrefix("ConnectDatabase") & ("Database path:") & " " & $DbGalleryDirectory)
  $Log4Gambas.Debug(LogPrefix("ConnectDatabase") & ("Database name:") & " " & Constants.DATABASE_NAME)
  $Log4Gambas.Debug(LogPrefix("ConnectDatabase") & ("Database type:") & " " & Constants.DATABASE_SQLITE3)
  
  Try $DB.Open()
  
  If Error Then
    $Log4Gambas.Fatal(LogPrefix("ConnectDatabase") & ("Could not connect to the database:") & " " & Error.Text)
    ERROR.Propagate
  Endif
  
  $Log4Gambas.Debug(LogPrefix("ConnectDatabase") & ("Connection established with:") & " " & $DbGalleryDirectory &/ Constants.DATABASE_NAME)
  
End

Private Sub InitializeDatabase()
  
  $Log4Gambas.Info(LogPrefix("InitializeDatabase") & ("Checking for Gacela database"))
  If Not Exist($DbGalleryDirectory &/ Constants.DATABASE_NAME) Then
    $Log4Gambas.Debug(LogPrefix("InitializeDatabase") & ("Database file does not exist. Starting creation:") & " " & $DbGalleryDirectory &/ Constants.DATABASE_NAME)
    $IsNewBD = True
    
    CreateDatabase()
  Endif
  
Catch
  $Log4Gambas.Error(LogPrefix("InitializeDatabase") & ("An error occurred while initializing the database") & " " & Error.Text)
  ERROR.Propagate 
  
End

Private Sub CreateDatabase()
  
  'Create a temporary connection to create the DB
  $DB = New Connection
  $DB.Type = Constants.DATABASE_SQLITE3
  $DB.Host = $DbGalleryDirectory
  $DB.Name = "" 'Clear the name so the physical DB can be created
  
  $DB.Open()
  If Error Then
    $Log4Gambas.Fatal(LogPrefix("CreateDatabase") & ("Cannot open connection to create DB:") & " " & Error.Text)
    ERROR.Propagate
  Endif
  
  If Not $DB.Databases.Exist(Constants.DATABASE_NAME) Then 'We already know the DB file does not exist; now ask via connect
    '' NOTE: This is where the database is created
    $DB.Databases.Add(Constants.DATABASE_NAME)
    Wait 0.5 ' Small pause to ensure physical file creation
    If Error Then
      $Log4Gambas.Fatal(LogPrefix("CreateDatabase") & ("Cannot create database:") & " " & Error.Text)
      $DB.Close()
      ERROR.Propagate
    Endif
    
    If $DB.Databases.Count = 0 Then ' Extreme fallback: create DB from a preexisting one
      Copy "clear_database" &/ Constants.DATABASE_NAME To $DbGalleryDirectory &/ Constants.DATABASE_NAME
      Wait 0.5
    Endif
    
  Endif
  $DB.Close()
  
  $Log4Gambas.Info(LogPrefix("CreateDatabase") & ("Database created successfully"))
  
End


' ====================================================
'
' Property to access the connection
'
' ====================================================
Private Function DBConnection_Read() As Connection
  
  Return $DB
  
End

Private Function IsNewDatabase_Read() As Boolean
  
  Return $IsNewBD
  
End

Private Function LogPrefix(methodName As String) As String
  
  Return $Titulo & "[" & methodName & "] "
  
End
