' Gambas class file

'
' Gambas class file - SQLiteContext for Gacela
' Handles the SQLite database connection and schema
'
'
Public Const SCHEMA_VERSION As String = "1.1"

Private $DB As Connection
Private $Log4Gambas As Log4Gambas3
Private $Configuration As Configuration
Private $DbGalleryDirectory As String
Private $Titulo As String = "[SQLiteContext] "
Private $IsNewBD As Boolean = False

Private $TableNotExist As String = ("Table does not exist, creating ...")
Private $TableCreate As String = ("Table created")

Property Read DBConnection As Connection            '' Object connection to database
Property Read IsNewDatabase As Boolean

Public Sub _new(cConfiguration As Configuration, oLog4gambas As Log4Gambas3)
  
  $Log4Gambas = oLog4gambas
  $Configuration = cConfiguration
  $Log4gambas.Info($Titulo & ("Initializing SQLite database context"))
  
  SwitchGallery()
  
End

Public Sub SwitchGallery()
  
  Dim sNewGalleryPath As String
  
  $IsNewBD = False
  If $Configuration.WhichGallery = Enumeration.GalleryType_Private Then
    sNewGalleryPath = User.Home &/ Constants.GACELA_GALLERY_DIRECTORY
  Else
    sNewGalleryPath = Constants.GACELA_SHARED_GALLERY_DIRECTORY
  Endif
  
  If $DbGalleryDirectory = sNewGalleryPath Then
    $Log4Gambas.Debug($Titulo & ("Gallery path has not changed. No reconnection required."))
    Return
  Endif
  
  $DbGalleryDirectory = sNewGalleryPath
  InitializeDatabase()
  $Log4Gambas.Info($Titulo & ("Switching database context to:") & " " & $DbGalleryDirectory)
  ConnectDatabase()
  CheckAndCreateTables()
  
End

' Public Sub _free()
'   
'   CloseConnection()
'   
' End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub ConnectDatabase()
  
  $DB = New Connection
  $DB.Type = Constants.DATABASE_SQLITE3
  $DB.Host = $DbGalleryDirectory
  $DB.Name = Constants.DATABASE_NAME
  
  $Log4Gambas.Debug($Titulo & ("Database path:") & " " & $DbGalleryDirectory)
  $Log4Gambas.Debug($Titulo & ("Database name:") & " " & Constants.DATABASE_NAME)
  $Log4Gambas.Debug($Titulo & ("Database type:") & " " & Constants.DATABASE_SQLITE3)
  
  Try $DB.Open()
  
  If Error Then
    $Log4Gambas.Fatal($Titulo & ("Could not connect to the database:") & " " & Error.Text)
    ERROR.Propagate
  Endif
  
  $Log4Gambas.Debug($Titulo & ("Connection established with:") & " " & $DbGalleryDirectory &/ Constants.DATABASE_NAME)
  
End

Private Sub InitializeDatabase()
  
  $Log4Gambas.Info($Titulo & ("Checking for Gacela database"))
  If Not Exist($DbGalleryDirectory &/ Constants.DATABASE_NAME) Then
    $Log4Gambas.Debug($Titulo & ("Database file does not exist. Starting creation:") & " " & $DbGalleryDirectory &/ Constants.DATABASE_NAME)
    $IsNewBD = True
    
    CreateDatabase()
  Endif
  
Catch
  $Log4Gambas.Error($Titulo & ("An error occurred while initializing the database") & " " & Error.Text)
  ERROR.Propagate 
  
End

Private Sub CreateDatabase()
  
  'Create a temporary connection to create the DB
  $DB = New Connection
  $DB.Type = Constants.DATABASE_SQLITE3
  $DB.Host = $DbGalleryDirectory
  $DB.Name = "" 'Clear the name so the physical DB can be created
  
  $DB.Open()
  If Error Then
    $Log4Gambas.Fatal($Titulo & ("Cannot open connection to create DB:") & " " & Error.Text)
    ERROR.Propagate
  Endif
  
  If Not $DB.Databases.Exist(Constants.DATABASE_NAME) Then 'We already know the DB file does not exist; now ask via connect
    '' NOTE: This is where the database is created
    $DB.Databases.Add(Constants.DATABASE_NAME)
    Wait 0.5 ' Small pause to ensure physical file creation
    If Error Then
      $Log4Gambas.Fatal($Titulo & ("Cannot create database:") & " " & Error.Text)
      $DB.Close()
      ERROR.Propagate
    Endif
    
    If $DB.Databases.Count = 0 Then ' Extreme fallback: create DB from a preexisting one
      Copy "clear_database" &/ Constants.DATABASE_NAME To $DbGalleryDirectory &/ Constants.DATABASE_NAME
      Wait 0.5
    Endif
    
  Endif
  $DB.Close()
  
  $Log4Gambas.Info($Titulo & ("Database created successfully"))
  
End

Private Sub CheckAndCreateTables()
  
  $Log4Gambas.Debug($Titulo & ("Checking the existence of schema tables..."))
  ' 1. Photos table (photos)
  If Not $DB.Tables.Exist(Constants.TABLE_PHOTOS) Then
    $Log4Gambas.Info($Titulo & "[" & Constants.TABLE_PHOTOS & "]" & $TableNotExist)
    CreatePhotosTable()
  Endif
  ' 2. Albums table (albums)
  If Not $DB.Tables.Exist(Constants.TABLE_ALBUMS) Then
    $Log4Gambas.Info($Titulo & "[" & Constants.TABLE_ALBUMS & "]" & $TableNotExist)
    CreateAlbumsTable()
  Endif
  ' 3. Tags table (tags)
  If Not $DB.Tables.Exist(Constants.TABLE_TAGS) Then
    $Log4Gambas.Info($Titulo & "[" & Constants.TABLE_TAGS & "]" & $TableNotExist)
    CreateTagsTable()
  Endif
  ' 4. Photos-Albums relationship table (photo_albums)
  If Not $DB.Tables.Exist(Constants.TABLE_PHOTOS_ALBUMS) Then
    $Log4Gambas.Info($Titulo & "[" & Constants.TABLE_PHOTOS_ALBUMS & "]" & $TableNotExist)
    CreatePhotosAlbumsTable() ' Assuming this method exists
  Endif
  ' 5. Photos-Tags relationship table (photos_tags)
  If Not $DB.Tables.Exist(Constants.TABLE_PHOTOS_TAGS) Then
    $Log4Gambas.Info($Titulo & "[" & Constants.TABLE_PHOTOS_TAGS & "]" & $TableNotExist)
    CreatePhotosTagsTable()
  Endif
  
  If Not $DB.Tables.Exist("DBVersion") Then
    CreateDBVersionTable()
  Endif
  EnsureDBVersion()
  RunMigrations()

  EnsurePhotosTableColumns()
  $Log4Gambas.Debug($Titulo & ("Table check and creation finished."))
  
Catch
  $Log4Gambas.Error($Titulo & ("Table check/creation failed:") & " " & Error.Text)
  Error.Raise($Titulo & ("Table check/creation failed:") & " " & Error.Text)
  
End

Private Sub CreatePhotosTable()
  
  Dim oTable As Table
  Dim sQuery As String
  
  oTable = $DB.Tables.Add(Constants.TABLE_PHOTOS)
  With oTable
    .Fields.Add("photo_id", db.Serial)                 '' Record identifier
    .Fields.Add("file_name", db.String, 255)           '' Original file name
    .Fields.Add("width_pixels", db.Integer)            '' Width in pixels
    .Fields.Add("height_pixels", db.Integer)           '' Height in pixels
    .Fields.Add("creation_date", db.Date)              '' Photo creation date
    .Fields.Add("import_date", db.Date)                '' Import date into Gacela
    .Fields.Add("description", db.String)              '' Photo description
    .Fields.Add("stars", db.Integer)                   '' Star rating count
    .Fields.Add("import_user", db.String, 50)          '' Importing user
    .Fields.Add("image_path", db.String, 255)          '' Full path to original image
    .Fields.Add("original_path", db.String, 255)       '' Original source path
    .Fields.Add("Hash256", db.String, 255)              '' Image hash for existence validation
    .Fields.Add("thumbnail", db.Blob)                  '' MINIATURA (BLOB)
    .Fields.Add("last_sync_date", db.Date)             '' Last sync date (for future cloud sync)
    .Fields.Add("sync_status", db.Integer)              '' Sync status indicator
    .Fields.Add("soft_delete", db.Boolean)             '' Soft delete (garbage collector)
    .Fields.Add("soft_deleted_date", db.date)          '' Date when it was soft-deleted
    .Fields.Add("soft_deleted_by", db.String, 50)      '' User who deleted it
    .Fields.Add("soft_deleted_auto", db.Date)           '' Date when it should be physically deleted
    .Fields.Add("is_locked", db.Boolean)               '' Indicates if it is locked for deletion
    .Fields.Add("locked_by", db.String, 50)            '' User who locked the photo
    .Fields.Add("locked_date", db.date)                '' Date when it was locked
    .Fields.Add("lock_reason", db.String, 200)         '' Reason why it was locked
    .PrimaryKey = ["photo_id"]                         '' Create primary key
    .Update()
  End With
  
  $Log4Gambas.Debug($Titulo & "[" & Constants.TABLE_PHOTOS & "]" & $TableCreate)
  
End

Private Sub EnsurePhotosTableColumns()
  
  Dim oTable As Table
  Dim oResult As Result
  Dim bHasOriginalPath As Boolean
  
  If Not $DB.Tables.Exist(Constants.TABLE_PHOTOS) Then Return
  
  oTable = $DB.Tables[Constants.TABLE_PHOTOS]
  If Not oTable.Fields.Exist("original_path") Then
    Try $DB.Exec("ALTER TABLE " & Constants.TABLE_PHOTOS & " ADD COLUMN original_path TEXT")
    If Error Then
      $Log4Gambas.Error($Titulo & ("Error adding original_path column") & " " & Error.Text)
    Endif
  Endif
  
  bHasOriginalPath = False
  oResult = $DB.Exec("PRAGMA table_info(" & Constants.TABLE_PHOTOS & ")")
  While oResult.Available
    If oResult["name"] = "original_path" Then
      bHasOriginalPath = True
      Exit
    Endif
    oResult.MoveNext()
  Wend
  
  If Not bHasOriginalPath Then
    $Log4Gambas.Warning($Titulo & ("Column original_path was not created"))
  Endif
  
End

Private Sub CreateAlbumsTable()
  
  Dim oTable As Table
  
  oTable = $DB.Tables.Add(Constants.TABLE_ALBUMS)
  With oTable
    .Fields.Add("album_id", db.Serial)                 '' Record identifier
    .Fields.Add("name", db.String, 255)                '' Album short name
    .Fields.Add("description", db.String)              '' Album description
    .Fields.Add("creation_date", db.Date)              '' Album creation date
    .Fields.Add("creation_user", db.String, 50)        '' User who created the album
    .Fields.Add("thumbnail", db.Blob)                  '' ← MINIATURA (BLOB)
    .Fields.Add("soft_delete", db.Boolean)             '' Soft delete
    .PrimaryKey = ["album_id"]                         '' Create primary key
    .Update()
  End With
  
  $Log4Gambas.Debug($Titulo & "[" & Constants.TABLE_ALBUMS & "]" & $TableCreate)
  
End

Private Sub CreatePhotosAlbumsTable()
  
  Dim oTable As Table
  
  oTable = $DB.Tables.Add(Constants.TABLE_PHOTOS_ALBUMS)
  With oTable
    .Fields.Add("pho_alb_id", db.Serial)               '' Record identifier
    .Fields.Add("photo_id", db.Integer)                '' Associated photo ID
    .Fields.Add("album_id", db.Integer)                '' Associated album ID
    .Fields.Add("order_in_album", db.Integer)          '' Photo order within the album
    .Fields.Add("added_date", db.Date)                 '' Date added to album
    .Fields.Add("added_user", db.String, 50)           '' User who added the relationship
    .PrimaryKey = ["pho_alb_id"]
    .Update()
  End With
  
  $Log4Gambas.Debug($Titulo & "[" & Constants.TABLE_PHOTOS_ALBUMS & "]" & $TableCreate)
  
End

Private Sub CreateTagsTable()
  
  Dim oTable As Table
  
  oTable = $DB.Tables.Add(Constants.TABLE_TAGS)
  With oTable
    .Fields.Add("tag_id", db.Serial)                 '' Record identifier
    .Fields.Add("name", db.String, 100)              '' Tag name
    .Fields.Add("description", db.String)            '' Tag description
    .Fields.Add("color", db.String, 7)               '' Tag display color
    .Fields.Add("creation_date", db.Date)            '' Creation date
    .Fields.Add("creation_user", db.String, 50)      '' User who created the tag
    .PrimaryKey = ["tag_id"]
    .Update()
  End With
  
  $Log4Gambas.Debug($Titulo & "[" & Constants.TABLE_TAGS & "]" & $TableCreate)
  
End

Private Sub CreatePhotosTagsTable()
  
  Dim oTable As Table
  
  oTable = $DB.Tables.Add(Constants.TABLE_PHOTOS_TAGS)
  With oTable
    .Fields.Add("pho_tag_id", db.Serial)             '' Record identifier
    .Fields.Add("photo_id", db.Integer)              '' Related photo ID
    .Fields.Add("tag_id", db.Integer)                '' Related tag ID
    .Fields.Add("added_date", db.Date)               '' Date added
    .Fields.Add("added_user", db.String, 50)         '' User who added the relationship
    .PrimaryKey = ["pho_tag_id"]
    .Update()
  End With
  
  $Log4Gambas.Debug($Titulo & "[" & Constants.TABLE_PHOTOS_TAGS & "]" & $TableCreate)
  
End

Private Sub CreateDBVersionTable()
  
  Dim oTable As Table
  
  oTable = $DB.Tables.Add("DBVersion")
  With oTable
    .Fields.Add("version", db.String, 10)
    .Update()
  End With
  
End

Private Sub EnsureDBVersion()
  
  Dim oResult As Result
  
  oResult = $DB.Exec("SELECT COUNT(*) as total FROM DBVersion")
  If oResult.Available Then
    If oResult["total"] = 0 Then
      $DB.Exec("INSERT INTO DBVersion(version) VALUES(&1)", SCHEMA_VERSION)
    Endif
  Endif
  
End

Private Sub RunMigrations()
  
  Dim sCurrentVersion As String
  
  sCurrentVersion = GetDbVersion()
  If sCurrentVersion = "1.0" Then
    Migrate_1_0_to_1_1()
  Endif
  
End

Private Function GetDbVersion() As String
  
  Dim oResult As Result
  
  oResult = $DB.Exec("SELECT version FROM DBVersion LIMIT 1")
  If oResult.Available Then
    Return oResult["version"]
  Endif
  
  Return ""
  
End

Private Sub SetDbVersion(sVersion As String)
  
  $DB.Exec("UPDATE DBVersion SET version = &1", sVersion)
  
End

Private Sub Migrate_1_0_to_1_1()
  
  ' Placeholder for future migration logic.
  SetDbVersion("1.1")
  
End

Private Sub CloseConnection()
  
  If $DB Then
    If $DB.Opened Then
      Try $DB.Close()
      $Log4Gambas.Info($Titulo & ("Database connection closed"))
    Endif
  Endif
  
End

' ====================================================
'
' Property to access the connection
'
' ====================================================
Private Function DBConnection_Read() As Connection
  
  Return $DB
  
End

Private Function IsNewDatabase_Read() As Boolean
  
  Return $IsNewBD
  
End
