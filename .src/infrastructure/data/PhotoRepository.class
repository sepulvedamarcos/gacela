' Gambas class file

'
'
' Data access class for DB
'
'
Private $Log4Gambas As Log4Gambas3
Private $DbContext As SQLiteContext
Private $Configuration As Configuration
Private $Titulo As String = "[PhotoRepository] "

Property Read DBContext As SQLiteContext

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(cConfiguration As Configuration, oLogger As Log4Gambas3, cContext As SQLiteContext)
  
  $Log4Gambas = oLogger
  $DbContext = cContext
  $Configuration = cConfiguration
  
End

Public Function SwitchGallery() As Boolean
  
  $DbContext.SwitchGallery()
  
Catch
  Error.Propagate()

End

Public Function IsNewDatabase() As Boolean
  
  Return $DbContext.IsNewDatabase
  
End

Public Function GetPhotos(Optional id As Integer) As PhotoEntity[]
  
  ' Dim cPhoto As PhotoEntity
  ' Dim oPhotos As PhotoEntity[]
  Dim oPhotoResult As Result
  Dim sQuery As String
  
  $Log4Gambas.Debug($Titulo & "Photo extraction")
  
  sQuery = "soft_delete = &1"
  If id > 0 Then
    sQuery &= " AND photo_id = " & id
  End If
  
  oPhotoResult = $DbContext.DBConnection.Find(Constants.TABLE_PHOTOS, sQuery, False)
  
  If oPhotoResult.Available Then
    $Log4Gambas.Debug($Titulo & "Extracted " & oPhotoResult.Count & " photos from response")
    
    Return MapResultToEntities(oPhotoResult)
    
  Endif
  
Catch
  $Log4Gambas.Error($Titulo & "Problems retrieving photos " & Error.Text)
  Error.Propagate
  
End

Public Function FindWithFilters(whereClause As String, sortBy As String, sortOrder As String, limit As Integer, offset As Integer) As PhotoEntity[] '' Get records with filters
  
  Dim oResult As Result
  Dim sQuery As String
  Dim sOrderBy As String = "import_date"
  Dim sOrderType As String = "desc"
  
  $Log4Gambas.Debug($Titulo & "Executing query with filters")
  
  If sortBy <> "" Then
    sOrderBy = sortBy
  Endif
  If sortOrder <> "" Then
    sOrderType = sortOrder
  Endif
  sOrderBy &= " " & sOrderType
  
  ' Execute query with LIMIT and OFFSET
  ' In Gambas, Find does not directly support LIMIT/OFFSET
  ' We must use Exec with SQL
  sQuery = "SELECT * FROM " & Constants.TABLE_PHOTOS &
    " WHERE " & whereClause &
    " ORDER BY " & sOrderBy &
    " LIMIT " & limit &
    " OFFSET " & offset
  
  $Log4Gambas.Debug($Titulo & sQuery)
  ' Convert params to array for Exec
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return MapResultToEntities(oResult)
  Endif
  Return New PhotoEntity[]
  
Catch
  $Log4Gambas.Error($Titulo & "Problem in FindWithFilters: " & Error.Text)
  
  Return New PhotoEntity[]
  
End

Public Function CountWithFilters(whereClause As String) As Integer '' Count records in the photos table
  
  Dim oResult As Result
  Dim sQuery As String
  
  $Log4Gambas.Info($Titulo & "Counting photos in the current database")
  
  sQuery = "SELECT COUNT(*) as iTotal FROM " & Constants.TABLE_PHOTOS &
    " WHERE " & whereClause
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return oResult["iTotal"]
  Endif
  
  Return 0
  
Catch
  $Log4Gambas.Error($Titulo & "Problem in CountWithFilters: " & Error.Text)
  Error.Propagate
  
End

Public Function CreateAlbum(cAlbum As AlbumEntity) As Integer
  
  Dim oResult As Result
  Dim iLastRecord As Integer
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Create(Constants.TABLE_ALBUMS)
  oResult["name"] = cAlbum.Name
  oResult["description"] = cAlbum.Description
  oResult["creation_date"] = Now
  oResult["creation_user"] = cAlbum.CreationUser
  oResult["thumbnail"] = ""
  oResult["soft_delete"] = False
  oResult.Update()
  
  $DbContext.DBConnection.Commit
  iLastRecord = $DbContext.DBConnection.LastInsertId
  
  $Log4Gambas.Debug($Titulo & ("Album code created [" & iLastRecord & "]"))
  Return iLastRecord
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error($Titulo & ("Problems creating album, rolling back"))
  Error.Propagate
  
End

Public Function DeleteAlbum(id As Integer) As Integer
  
  Dim oResult As Result
  
  $DbContext.DBConnection.Begin()
  oResult = $DbContext.DBConnection.Edit(Constants.TABLE_ALBUMS)
  oResult["album_id"] = id
  oResult["soft_delete"] = 1
  oResult.Update()
  
  $DbContext.DBConnection.Commit
  Return $DbContext.DBConnection.LastInsertId
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error($Titulo & ("Problems deleting album, rolling back"))
  Error.Propagate
  
End

Public Function DeletePhoto(id As Integer) As Boolean
  
  Dim oRes As Result
  
  ' FIXME : cascade delete should remove related TAGS and Albums. The layer above should also check locking.
  
  $DbContext.DBConnection.Begin()
  oRes = $DbContext.DBConnection.Edit(Constants.TABLE_PHOTOS)
  oRes["photo_id"] = id
  oRes["soft_delete"] = 1
  oRes.Update()
  
  $DbContext.DBConnection.Commit
  Return $DbContext.DBConnection.LastInsertId
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error($Titulo & ("Problems deleting image from DB, rolling back"))
  Error.Propagate
  
End

Public Function CreatePhoto(photoE As PhotoEntity, Optional photoAlbumE As PhotoAlbumEntity) As Boolean
  
  Dim oResult As Result
  Dim iPhotoId As Integer
  Dim iPhotoAlbumId As Integer
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Create(Constants.TABLE_PHOTOS)
  oResult["file_name"] = photoE.FileName
  oResult["width_pixels"] = photoE.WidthPixels
  oResult["height_pixels"] = photoE.HeightPixels
  oResult["creation_date"] = Now()
  oResult["import_date"] = photoE.ImportDate
  oResult["description"] = photoE.Description
  oResult["stars"] = photoE.Stars
  oResult["import_user"] = photoE.ImportUser
  oResult["image_path"] = photoE.ImagePath
  oResult["original_path"] = photoE.OriginalPath
  oResult["Hash256"] = photoE.Hash256
  oResult["thumbnail"] = photoE.Thumbnail
  oResult["last_sync_date"] = Null
  oResult["sync_status"] = 0
  oResult["soft_delete"] = False
  oResult["soft_deleted_date"] = Null
  oResult["soft_deleted_by"] = Null
  oResult["soft_deleted_auto"] = Null
  oResult["is_locked"] = False
  oResult["locked_by"] = Null
  oResult["locked_date"] = Null
  oResult["lock_reason"] = Null
  oResult.Update()
  
  iPhotoId = $DbContext.DBConnection.LastInsertId
  $Log4Gambas.Debug($Titulo & ("Photo code created") & " [" & iPhotoId & "]")
  
  If photoAlbumE <> Null Then
    oResult = $DbContext.DBConnection.Create(Constants.TABLE_PHOTOS_ALBUMS)
    oResult["photo_id"] = iPhotoId
    oResult["album_id"] = photoAlbumE.AlbumId
    oResult["order_in_album"] = photoAlbumE.OrderInAlbum
    oResult["added_date"] = Now()
    oResult["added_user"] = photoAlbumE.AddedUser
    oResult.Update()
    
    iPhotoAlbumId = $DbContext.DBConnection.LastInsertId
    $Log4Gambas.Debug($Titulo & ("Photo-album code created") & " [" & iPhotoAlbumId & "]")
    
  End If
  
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error($Titulo & "Problems creating photo, rolling back")
  Error.Propagate
  
End

Public Function ValidateHash256Exist(sHash256 As String) As Boolean
  
  Dim sQuery As String
  Dim iTotal As Integer
  Dim oResult As Result
  
  $Log4Gambas.Debug($Titulo & ("Validating in table with Hash256") & " [" & sHash256 & "]")
  sQuery = "SELECT COUNT(*) as iTotal FROM " & Constants.TABLE_PHOTOS &
    " WHERE Hash256 = &1"
  oResult = $DbContext.DBConnection.Exec(sQuery, sHash256)
  
  If oResult.Available Then
    iTotal = oResult["iTotal"]
    If iTotal >= 1 Then
      $Log4Gambas.Debug($Titulo & ("Image already exists with that Hash256"))
      Return True
    End If
  End If
  
  $Log4Gambas.Debug($Titulo & ("Image does not exist"))
  Return False
  
Catch
  $Log4Gambas.Error($Titulo & ("Error searching photo by Hash256"))
  Error.Propagate
  
End

Public Function FindAlbums(Optional text As String, Optional id As Integer = 0, Optional useSoftDelete As Integer = -1) As AlbumEntity[]
  
  Dim sQuery As String
  Dim oResult As Result
  Dim sCon As String = " WHERE "
  
  sQuery = "SELECT * FROM " & Constants.TABLE_ALBUMS
  If useSoftDelete <> -1 Then
    sQuery &= " WHERE soft_delete = " & useSoftDelete
    sCon = " AND "
  Endif
  
  If id <> 0 Then
    sQuery &= sCon & " album_id = " & id
  Endif
  
  If text <> "" Then
    sQuery &= sCon & " LOWER(name) LIKE '%" & Lower(text) & "%'"
  Endif
  
  $Log4Gambas.Debug($Titulo & "Query [" & sQuery & "]")
  oResult = $DbContext.DBConnection.Exec(sQuery)
  If oResult.Available Then
    Return MapAlbumEntitys(oResult)
  Endif
  
  Return New AlbumEntity[]
  
Catch
  $Log4Gambas.Error($Titulo & "Problem reading albums")
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================

Private Function MapResultToEntities(oResult As Result) As PhotoEntity[]
  
  Dim cPhoto As PhotoEntity
  Dim oPhotos As New PhotoEntity[]
  
  For Each oResult
    cPhoto = New PhotoEntity
    cPhoto.Id = oResult["photo_id"]
    cPhoto.FileName = oResult["file_name"]
    cPhoto.WidthPixels = IIf(oResult["width_pixels"] <> Null, oResult["width_pixels"], 0)
    cPhoto.HeightPixels = IIf(oResult["height_pixels"] <> Null, oResult["height_pixels"], 0)
    cPhoto.CreationDate = oResult["creation_date"]
    cPhoto.ImportDate = oResult["import_date"]
    cPhoto.Description = oResult["description"]
    cPhoto.Stars = oResult["stars"]
    cPhoto.ImportUser = oResult["import_user"]
    cPhoto.ImagePath = oResult["image_path"]
    cPhoto.OriginalPath = oResult["original_path"]
    cPhoto.Hash256 = oResult["Hash256"]
    cPhoto.Thumbnail = oResult["thumbnail"]
    cPhoto.LastSyncDate = oResult["last_sync_date"]
    cPhoto.SyncStatus = oResult["sync_status"]
    cPhoto.SoftDelete = oResult["soft_delete"]
    cPhoto.SoftDeleteDate = oResult["soft_deleted_date"]
    cPhoto.SoftDeleteBy = oResult["soft_deleted_by"]
    cPhoto.SoftDeleteAuto = oResult["soft_deleted_auto"]
    cPhoto.IsLocked = oResult["is_locked"]
    cPhoto.LockedBy = oResult["locked_by"]
    cPhoto.Lockreason = oResult["lock_reason"]
    
    oPhotos.Add(cPhoto)
  Next
  
  Return oPhotos
  
Catch
  $Log4Gambas.Error($Titulo & "Problem mapping Photo data: " & Error.Text)
  Error.Propagate
  
End

Private Sub MapAlbumEntitys(oResult As Result) As AlbumEntity[] '' Map albums
  
  Dim cAlbum As AlbumEntity
  Dim oAlbums As New AlbumEntity[]
  
  While (oResult.Available)
    cAlbum = New AlbumEntity
    
    ' Map all fields
    cAlbum.Id = oResult["album_id"]
    cAlbum.Name = oResult["name"]
    cAlbum.Description = oResult["description"]
    cAlbum.CreationDate = oResult["creation_date"]
    cAlbum.CreationUser = oResult["creation_user"]
    cAlbum.Thumbnail = oResult["thumbnail"]
    cAlbum.SoftDelete = oResult["soft_delete"]
    oAlbums.Add(cAlbum)
    
    oResult.MoveNext()
  Wend
  
  Return oAlbums
  
Catch
  $Log4Gambas.Error($Titulo & "Problem mapping cAlbum data")
  Error.Propagate
  
End

Private Function DBContext_Read() As SQLiteContext
  
  Return $DbContext
  
End
