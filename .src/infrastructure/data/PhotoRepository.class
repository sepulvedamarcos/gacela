' Gambas class file

'
'
' Data access class for DB
'
'
Private $Log4Gambas As Log4Gambas3
Private $DbContext As SQLiteContext
Private $Configuration As Configuration
Private $Titulo As String = "[PhotoRepository] "

Public Const TABLE_PHOTOS As String = "photos"
Public Const TABLE_ALBUMS As String = "albums"
Public Const TABLE_TAGS As String = "tags"
Public Const TABLE_PHOTOS_ALBUMS As String = "photo_albums"
Public Const TABLE_PHOTOS_TAGS As String = "photos_tags"
Public Const SCHEMA_VERSION As String = "1.1"

Private $TableNotExist As String = ("Table does not exist, creating ...")
Private $TableCreate As String = ("Table created")

Property Read DBContext As SQLiteContext

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(cConfiguration As Configuration, oLogger As Log4Gambas3)
  
  $Log4Gambas = oLogger
  $Configuration = cConfiguration
  $DbContext = New SQLiteContext($Configuration, $Log4Gambas)
  EnsureSchema()
  
End

Public Function SwitchGallery() As Boolean
  
  $DbContext.SwitchGallery()
  EnsureSchema()
  
Catch
  Error.Propagate()

End

Public Function IsNewDatabase() As Boolean
  
  Return $DbContext.IsNewDatabase
  
End

Public Function GetPhotos(Optional id As Integer) As PhotoEntity[]
  
  ' Dim cPhoto As PhotoEntity
  ' Dim oPhotos As PhotoEntity[]
  Dim oPhotoResult As Result
  Dim sQuery As String
  
  $Log4Gambas.Debug(LogPrefix("GetPhotos") & "Photo extraction")
  
  sQuery = "soft_delete = &1"
  If id > 0 Then
    sQuery &= " AND photo_id = " & id
  End If
  
  oPhotoResult = $DbContext.DBConnection.Find(PhotoRepository.TABLE_PHOTOS, sQuery, False)
  
  If oPhotoResult.Available Then
    $Log4Gambas.Debug(LogPrefix("GetPhotos") & "Extracted " & oPhotoResult.Count & " photos from response")
    
    Return MapResultToEntities(oPhotoResult)
    
  Endif
  
Catch
  $Log4Gambas.Error(LogPrefix("GetPhotos") & "Problems retrieving photos " & Error.Text)
  Error.Propagate
  
End

Public Function FindWithFilters(whereClause As String, sortBy As String, sortOrder As String, limit As Integer, offset As Integer) As PhotoEntity[] '' Get records with filters
  
  Dim oResult As Result
  Dim sQuery As String
  Dim sOrderBy As String = "import_date"
  Dim sOrderType As String = "desc"
  
  $Log4Gambas.Debug(LogPrefix("FindWithFilters") & "Executing query with filters")
  
  If sortBy <> "" Then
    sOrderBy = sortBy
  Endif
  If sortOrder <> "" Then
    sOrderType = sortOrder
  Endif
  sOrderBy &= " " & sOrderType
  
  ' Execute query with LIMIT and OFFSET
  ' In Gambas, Find does not directly support LIMIT/OFFSET
  ' We must use Exec with SQL
  sQuery = "SELECT * FROM " & PhotoRepository.TABLE_PHOTOS &
    " WHERE " & whereClause &
    " ORDER BY " & sOrderBy &
    " LIMIT " & limit &
    " OFFSET " & offset
  
  $Log4Gambas.Debug(LogPrefix("FindWithFilters") & sQuery)
  ' Convert params to array for Exec
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return MapResultToEntities(oResult)
  Endif
  Return New PhotoEntity[]
  
Catch
  $Log4Gambas.Error(LogPrefix("FindWithFilters") & "Problem in FindWithFilters: " & Error.Text)
  
  Return New PhotoEntity[]
  
End

Public Function CountWithFilters(whereClause As String) As Integer '' Count records in the photos table
  
  Dim oResult As Result
  Dim sQuery As String
  
  $Log4Gambas.Info(LogPrefix("CountWithFilters") & "Counting photos in the current database")
  
  sQuery = "SELECT COUNT(*) as iTotal FROM " & PhotoRepository.TABLE_PHOTOS &
    " WHERE " & whereClause
  oResult = $DbContext.DBConnection.Exec(sQuery)
  
  If oResult.Available Then
    Return oResult["iTotal"]
  Endif
  
  Return 0
  
Catch
  $Log4Gambas.Error(LogPrefix("CountWithFilters") & "Problem in CountWithFilters: " & Error.Text)
  Error.Propagate
  
End

Public Function CreateAlbum(cAlbum As AlbumEntity) As Integer
  
  Dim oResult As Result
  Dim iLastRecord As Integer
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Create(PhotoRepository.TABLE_ALBUMS)
  oResult["name"] = cAlbum.Name
  oResult["description"] = cAlbum.Description
  oResult["creation_date"] = Now
  oResult["creation_user"] = cAlbum.CreationUser
  oResult["thumbnail"] = ""
  oResult["soft_delete"] = False
  oResult.Update()
  
  $DbContext.DBConnection.Commit
  iLastRecord = $DbContext.DBConnection.LastInsertId
  
  $Log4Gambas.Debug(LogPrefix("CreateAlbum") & ("Album code created [" & iLastRecord & "]"))
  Return iLastRecord
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error(LogPrefix("CreateAlbum") & ("Problems creating album, rolling back"))
  Error.Propagate
  
End

Public Function DeleteAlbum(id As Integer) As Integer
  
  Dim oResult As Result
  
  $DbContext.DBConnection.Begin()
  oResult = $DbContext.DBConnection.Edit(PhotoRepository.TABLE_ALBUMS)
  oResult["album_id"] = id
  oResult["soft_delete"] = 1
  oResult.Update()
  
  $DbContext.DBConnection.Commit
  Return $DbContext.DBConnection.LastInsertId
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error(LogPrefix("DeleteAlbum") & ("Problems deleting album, rolling back"))
  Error.Propagate
  
End

Public Function DeletePhoto(id As Integer) As Boolean
  
  Dim oRes As Result
  
  ' FIXME : cascade delete should remove related TAGS and Albums. The layer above should also check locking.
  
  Return MarkPhotoAsDeleted(id, User.Name, False)
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error(LogPrefix("DeletePhoto") & ("Problems deleting image from DB, rolling back"))
  Error.Propagate
  
End

Public Function MarkPhotoAsDeleted(id As Integer, deletedBy As String, deletedAuto As Boolean) As Boolean
  
  Dim oRes As Result
  
  $DbContext.DBConnection.Begin()
  oRes = $DbContext.DBConnection.Edit(PhotoRepository.TABLE_PHOTOS)
  oRes["photo_id"] = id
  oRes["soft_delete"] = 1
  oRes["soft_deleted_date"] = Now()
  oRes["soft_deleted_by"] = deletedBy
  oRes["soft_deleted_auto"] = deletedAuto
  oRes.Update()
  
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error(LogPrefix("MarkPhotoAsDeleted") & "Problems marking image as deleted, rolling back")
  Error.Propagate
  
End

Public Function PermanentlyDeletePhoto(id As Integer) As Boolean
  
  Dim sQuery As String
  
  $DbContext.DBConnection.Begin()
  
  sQuery = "DELETE FROM " & PhotoRepository.TABLE_PHOTOS_TAGS & " WHERE photo_id = &1"
  $DbContext.DBConnection.Exec(sQuery, id)
  
  sQuery = "DELETE FROM " & PhotoRepository.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1"
  $DbContext.DBConnection.Exec(sQuery, id)
  
  sQuery = "DELETE FROM " & PhotoRepository.TABLE_PHOTOS & " WHERE photo_id = &1"
  $DbContext.DBConnection.Exec(sQuery, id)
  
  $DbContext.DBConnection.Commit
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error(LogPrefix("PermanentlyDeletePhoto") & "Problems permanently deleting image, rolling back")
  Error.Propagate
  
End

Public Function CreatePhoto(photoE As PhotoEntity, Optional photoAlbumE As PhotoAlbumEntity) As Boolean
  
  Dim oResult As Result
  Dim iPhotoId As Integer
  Dim iPhotoAlbumId As Integer
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Create(PhotoRepository.TABLE_PHOTOS)
  oResult["file_name"] = photoE.FileName
  oResult["width_pixels"] = photoE.WidthPixels
  oResult["height_pixels"] = photoE.HeightPixels
  oResult["creation_date"] = Now()
  oResult["import_date"] = photoE.ImportDate
  oResult["description"] = photoE.Description
  oResult["stars"] = photoE.Stars
  oResult["import_user"] = photoE.ImportUser
  oResult["image_path"] = photoE.ImagePath
  oResult["original_path"] = photoE.OriginalPath
  oResult["Hash256"] = photoE.Hash256
  oResult["thumbnail"] = photoE.Thumbnail
  oResult["last_sync_date"] = Null
  oResult["sync_status"] = 0
  oResult["soft_delete"] = False
  oResult["soft_deleted_date"] = Null
  oResult["soft_deleted_by"] = Null
  oResult["soft_deleted_auto"] = Null
  oResult["is_locked"] = False
  oResult["locked_by"] = Null
  oResult["locked_date"] = Null
  oResult["lock_reason"] = Null
  oResult.Update()
  
  iPhotoId = $DbContext.DBConnection.LastInsertId
  $Log4Gambas.Debug(LogPrefix("CreatePhoto") & ("Photo code created") & " [" & iPhotoId & "]")
  
  If photoAlbumE <> Null Then
    oResult = $DbContext.DBConnection.Create(PhotoRepository.TABLE_PHOTOS_ALBUMS)
    oResult["photo_id"] = iPhotoId
    oResult["album_id"] = photoAlbumE.AlbumId
    oResult["order_in_album"] = photoAlbumE.OrderInAlbum
    oResult["added_date"] = Now()
    oResult["added_user"] = photoAlbumE.AddedUser
    oResult.Update()
    
    iPhotoAlbumId = $DbContext.DBConnection.LastInsertId
    $Log4Gambas.Debug(LogPrefix("CreatePhoto") & ("Photo-album code created") & " [" & iPhotoAlbumId & "]")
    
  End If
  
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $Log4Gambas.Error(LogPrefix("CreatePhoto") & "Problems creating photo, rolling back")
  Error.Propagate
  
End

Public Function ValidateHash256Exist(sHash256 As String) As Boolean
  
  Dim sQuery As String
  Dim iTotal As Integer
  Dim oResult As Result
  
  $Log4Gambas.Debug(LogPrefix("ValidateHash256Exist") & ("Validating in table with Hash256") & " [" & sHash256 & "]")
  sQuery = "SELECT COUNT(*) as iTotal FROM " & PhotoRepository.TABLE_PHOTOS &
    " WHERE Hash256 = &1"
  oResult = $DbContext.DBConnection.Exec(sQuery, sHash256)
  
  If oResult.Available Then
    iTotal = oResult["iTotal"]
    If iTotal >= 1 Then
      $Log4Gambas.Debug(LogPrefix("ValidateHash256Exist") & ("Image already exists with that Hash256"))
      Return True
    End If
  End If
  
  $Log4Gambas.Debug(LogPrefix("ValidateHash256Exist") & ("Image does not exist"))
  Return False
  
Catch
  $Log4Gambas.Error(LogPrefix("ValidateHash256Exist") & ("Error searching photo by Hash256"))
  Error.Propagate
  
End

Public Function FindAlbums(Optional text As String, Optional id As Integer = 0, Optional useSoftDelete As Integer = -1) As AlbumEntity[]
  
  Dim sQuery As String
  Dim oResult As Result
  Dim sCon As String = " WHERE "
  
  sQuery = "SELECT * FROM " & PhotoRepository.TABLE_ALBUMS
  If useSoftDelete <> -1 Then
    sQuery &= " WHERE soft_delete = " & useSoftDelete
    sCon = " AND "
  Endif
  
  If id <> 0 Then
    sQuery &= sCon & " album_id = " & id
  Endif
  
  If text <> "" Then
    sQuery &= sCon & " LOWER(name) LIKE '%" & Lower(text) & "%'"
  Endif
  
  $Log4Gambas.Debug(LogPrefix("FindAlbums") & "Query [" & sQuery & "]")
  oResult = $DbContext.DBConnection.Exec(sQuery)
  If oResult.Available Then
    Return MapAlbumEntitys(oResult)
  Endif
  
  Return New AlbumEntity[]
  
Catch
  $Log4Gambas.Error(LogPrefix("FindAlbums") & "Problem reading albums")
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub EnsureSchema()
  
  Dim oDb As Connection
  
  oDb = $DbContext.DBConnection
  If oDb Is Null Or oDb.Tables Is Null Then
    Error.Raise(LogPrefix("EnsureSchema") & "Database connection is not ready")
  Endif
  
  $Log4Gambas.Debug(LogPrefix("EnsureSchema") & ("Checking the existence of schema tables..."))
  ' 1. Photos table (photos)
  If Not oDb.Tables.Exist(PhotoRepository.TABLE_PHOTOS) Then
    $Log4Gambas.Info(LogPrefix("EnsureSchema") & "[" & PhotoRepository.TABLE_PHOTOS & "]" & $TableNotExist)
    CreatePhotosTable(oDb)
  Endif
  ' 2. Albums table (albums)
  If Not oDb.Tables.Exist(PhotoRepository.TABLE_ALBUMS) Then
    $Log4Gambas.Info(LogPrefix("EnsureSchema") & "[" & PhotoRepository.TABLE_ALBUMS & "]" & $TableNotExist)
    CreateAlbumsTable(oDb)
  Endif
  ' 3. Tags table (tags)
  If Not oDb.Tables.Exist(PhotoRepository.TABLE_TAGS) Then
    $Log4Gambas.Info(LogPrefix("EnsureSchema") & "[" & PhotoRepository.TABLE_TAGS & "]" & $TableNotExist)
    CreateTagsTable(oDb)
  Endif
  ' 4. Photos-Albums relationship table (photo_albums)
  If Not oDb.Tables.Exist(PhotoRepository.TABLE_PHOTOS_ALBUMS) Then
    $Log4Gambas.Info(LogPrefix("EnsureSchema") & "[" & PhotoRepository.TABLE_PHOTOS_ALBUMS & "]" & $TableNotExist)
    CreatePhotosAlbumsTable(oDb)
  Endif
  ' 5. Photos-Tags relationship table (photos_tags)
  If Not oDb.Tables.Exist(PhotoRepository.TABLE_PHOTOS_TAGS) Then
    $Log4Gambas.Info(LogPrefix("EnsureSchema") & "[" & PhotoRepository.TABLE_PHOTOS_TAGS & "]" & $TableNotExist)
    CreatePhotosTagsTable(oDb)
  Endif
  
  If Not oDb.Tables.Exist("DBVersion") Then
    CreateDBVersionTable(oDb)
  Endif
  EnsureDBVersion(oDb)
  RunMigrations(oDb)
  
  EnsurePhotosTableColumns(oDb)
  $Log4Gambas.Debug(LogPrefix("EnsureSchema") & ("Table check and creation finished."))
  
Catch
  $Log4Gambas.Error(LogPrefix("EnsureSchema") & ("Table check/creation failed:") & " " & Error.Text)
  Error.Raise(LogPrefix("EnsureSchema") & ("Table check/creation failed:") & " " & Error.Text)
  
End

Private Sub CreatePhotosTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables Is Null Then Error.Raise(LogPrefix("CreatePhotosTable") & "Tables collection is not available")
  oTable = oDb.Tables.Add(PhotoRepository.TABLE_PHOTOS)
  If oTable Is Null Then Error.Raise(LogPrefix("CreatePhotosTable") & "Cannot create table " & PhotoRepository.TABLE_PHOTOS)
  With oTable
    .Fields.Add("photo_id", db.Serial)                 '' Record identifier
    .Fields.Add("file_name", db.String, 255)           '' Original file name
    .Fields.Add("width_pixels", db.Integer)            '' Width in pixels
    .Fields.Add("height_pixels", db.Integer)           '' Height in pixels
    .Fields.Add("creation_date", db.Date)              '' Photo creation date
    .Fields.Add("import_date", db.Date)                '' Import date into Gacela
    .Fields.Add("description", db.String)              '' Photo description
    .Fields.Add("stars", db.Integer)                   '' Star rating count
    .Fields.Add("import_user", db.String, 50)          '' Importing user
    .Fields.Add("image_path", db.String, 255)          '' Full path to original image
    .Fields.Add("original_path", db.String, 255)       '' Original source path
    .Fields.Add("Hash256", db.String, 255)             '' Image hash for existence validation
    .Fields.Add("thumbnail", db.Blob)                  '' MINIATURA (BLOB)
    .Fields.Add("last_sync_date", db.Date)             '' Last sync date (for future cloud sync)
    .Fields.Add("sync_status", db.Integer)             '' Sync status indicator
    .Fields.Add("soft_delete", db.Boolean)             '' Soft delete (garbage collector)
    .Fields.Add("soft_deleted_date", db.date)          '' Date when it was soft-deleted
    .Fields.Add("soft_deleted_by", db.String, 50)      '' User who deleted it
    .Fields.Add("soft_deleted_auto", db.Date)          '' Date when it should be physically deleted
    .Fields.Add("is_locked", db.Boolean)               '' Indicates if it is locked for deletion
    .Fields.Add("locked_by", db.String, 50)            '' User who locked the photo
    .Fields.Add("locked_date", db.date)                '' Date when it was locked
    .Fields.Add("lock_reason", db.String, 200)         '' Reason why it was locked
    .PrimaryKey = ["photo_id"]                         '' Create primary key
    .Update()
  End With
  
  $Log4Gambas.Debug(LogPrefix("CreatePhotosTable") & "[" & PhotoRepository.TABLE_PHOTOS & "]" & $TableCreate)
  
End

Private Sub EnsurePhotosTableColumns(oDb As Connection)
  
  Dim oTable As Table
  Dim oResult As Result
  Dim bHasOriginalPath As Boolean
  
  If Not oDb.Tables.Exist(PhotoRepository.TABLE_PHOTOS) Then Return
  
  oTable = oDb.Tables[PhotoRepository.TABLE_PHOTOS]
  If oTable Is Null Then Error.Raise(LogPrefix("EnsurePhotosTableColumns") & "Cannot open table " & PhotoRepository.TABLE_PHOTOS)
  If Not oTable.Fields.Exist("original_path") Then
    Try oDb.Exec("ALTER TABLE " & PhotoRepository.TABLE_PHOTOS & " ADD COLUMN original_path TEXT")
    If Error Then
      $Log4Gambas.Error(LogPrefix("EnsurePhotosTableColumns") & ("Error adding original_path column") & " " & Error.Text)
    Endif
  Endif
  
  bHasOriginalPath = False
  oResult = oDb.Exec("PRAGMA table_info(" & PhotoRepository.TABLE_PHOTOS & ")")
  While oResult.Available
    If oResult["name"] = "original_path" Then
      bHasOriginalPath = True
      Exit
    Endif
    oResult.MoveNext()
  Wend
  
  If Not bHasOriginalPath Then
    $Log4Gambas.Warning(LogPrefix("EnsurePhotosTableColumns") & ("Column original_path was not created"))
  Endif
  
End

Private Sub CreateAlbumsTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables Is Null Then Error.Raise(LogPrefix("CreateAlbumsTable") & "Tables collection is not available")
  oTable = oDb.Tables.Add(PhotoRepository.TABLE_ALBUMS)
  If oTable Is Null Then Error.Raise(LogPrefix("CreateAlbumsTable") & "Cannot create table " & PhotoRepository.TABLE_ALBUMS)
  With oTable
    .Fields.Add("album_id", db.Serial)                 '' Record identifier
    .Fields.Add("name", db.String, 255)                '' Album short name
    .Fields.Add("description", db.String)              '' Album description
    .Fields.Add("creation_date", db.Date)              '' Album creation date
    .Fields.Add("creation_user", db.String, 50)        '' User who created the album
    .Fields.Add("thumbnail", db.Blob)                  '' ← MINIATURA (BLOB)
    .Fields.Add("soft_delete", db.Boolean)             '' Soft delete
    .PrimaryKey = ["album_id"]                         '' Create primary key
    .Update()
  End With
  
  $Log4Gambas.Debug(LogPrefix("CreateAlbumsTable") & "[" & PhotoRepository.TABLE_ALBUMS & "]" & $TableCreate)
  
End

Private Sub CreatePhotosAlbumsTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables Is Null Then Error.Raise(LogPrefix("CreatePhotosAlbumsTable") & "Tables collection is not available")
  oTable = oDb.Tables.Add(PhotoRepository.TABLE_PHOTOS_ALBUMS)
  If oTable Is Null Then Error.Raise(LogPrefix("CreatePhotosAlbumsTable") & "Cannot create table " & PhotoRepository.TABLE_PHOTOS_ALBUMS)
  With oTable
    .Fields.Add("pho_alb_id", db.Serial)               '' Record identifier
    .Fields.Add("photo_id", db.Integer)                '' Associated photo ID
    .Fields.Add("album_id", db.Integer)                '' Associated album ID
    .Fields.Add("order_in_album", db.Integer)          '' Photo order within the album
    .Fields.Add("added_date", db.Date)                 '' Date added to album
    .Fields.Add("added_user", db.String, 50)           '' User who added the relationship
    .PrimaryKey = ["pho_alb_id"]
    .Update()
  End With
  
  $Log4Gambas.Debug(LogPrefix("CreatePhotosAlbumsTable") & "[" & PhotoRepository.TABLE_PHOTOS_ALBUMS & "]" & $TableCreate)
  
End

