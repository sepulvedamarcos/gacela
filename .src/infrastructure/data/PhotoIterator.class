Private Sub UpdateTotalCount()

  $iTotalCount = $cRepository.CountWithFilters(BuildFilterQuery())

  $Log4Gambas.Debug("Total photos with filters: " & $iTotalCount)

Catch
  $Log4Gambas.Error("Error counting photos: " & Error.Text)
  $iTotalCount = 0
  Error.Propagate

End

' Build WHERE query with active filters
Private Function BuildFilterQuery() As String

  Dim aConditions As String[] = New String[]

  aConditions.Add("soft_delete = " & If($bFilterGarbage, "true", "false"))

  ' Filter: favorites only
  If $bFilterFavorites Then
    aConditions.Add("is_favorite = &2")
  Endif

  ' Filter: by format
  If $sFilterFormat <> "" Then
    aConditions.Add("LOWER(original_format) = &3")
  Endif

  ' Filter: date range
  If $dFilterDateFrom Then
    aConditions.Add("creation_date >= &4")
  Endif

  If $dFilterDateTo Then
    aConditions.Add("creation_date <= &5")
  Endif

  ' Filter: by user
  If $sFilterUser <> "" Then
    aConditions.Add("import_user = &6")
  Endif

  ' Filter: search by name
  If $sSearchText <> "" Then
    aConditions.Add("LOWER(file_name) LIKE &7")
  Endif
  
  ' Filter: by album
  If $iFilterAlbumId > 0 Then
    aConditions.Add("EXISTS (SELECT 1 FROM " & PhotoRepository.TABLE_PHOTOS_ALBUMS & " pa WHERE pa.photo_id = " & PhotoRepository.TABLE_PHOTOS & ".photo_id AND pa.album_id = " & $iFilterAlbumId & ")")
  Endif

  Return aConditions.Join(" AND ")

End

