' Gambas class file

'' Iterator for photo collections with pagination support.
'' Uses PhotoSpecification to handle complex filtering logic through the repository.

Private $cRepository As PhotoRepositoryPort
Private $iPageSize As Integer = 15
Private $iCurrentPage As Integer = 0
Private $iTotalCount As Integer = 0
Private $Logger As LoggerPort
Private $HasMorePages As Boolean = True
Private $Specification As PhotoSpecification

Private $sSortBy As String = "import_date"  '' Column to sort by (import_date, file_name, creation_date).
Private $sSortOrder As String = "DESC"      '' Sort order (ASC, DESC).

Private $Titulo As String = "PhotoIterator"
Private $LogMessage As LogMessage

' =============================================================================
'
'          Public methods
'
' =============================================================================

Public Sub _new(oRepository As PhotoRepositoryPort, oLogger As LoggerPort)
  
  $cRepository = oRepository
  $Logger = oLogger
  $Specification = New PhotoSpecification
  
  ' Count total with current (empty) filters
  UpdateTotalCount()

End

Public Sub SetSpecification(oSpec As PhotoSpecification) '' Updates the active specification and resets the iterator.
  
  If oSpec = Null Then 
    $Specification = New PhotoSpecification
  Else
    $Specification = oSpec
  Endif
  
  Reset()
  
End

Public Sub SetFilterAlbum(iAlbumId As Integer) '' Shortcut to filter by a specific album.
  
  If $Specification.AlbumId = iAlbumId Then Return

  $Specification.AlbumId = iAlbumId
  Reset()

End

Public Function LoadNextBatch() As PhotoEntity[] '' Loads the next batch of photos for infinite scroll.

  Dim iOffset As Integer
  Dim oNewPhotos As New PhotoEntity[]

  ' If there are no more pages according to our previous count and current page
  If Not $HasMorePages Then
    $LogMessage = New LogMessage($Titulo, "LoadNextBatch", "No more pages to load")
    $Logger.Debug($LogMessage)
    Return oNewPhotos
  Endif

  $iCurrentPage += 1
  iOffset = ($iCurrentPage - 1) * $iPageSize

  $LogMessage = New LogMessage($Titulo, "LoadNextBatch", "Loading page " & $iCurrentPage & " (iOffset=" & iOffset & ", limit=" & $iPageSize & ", total=" & $iTotalCount & ")")
  $Logger.Debug($LogMessage)

  ' Load next batch using the Specification
  oNewPhotos = $cRepository.FindWithFilters($Specification, $sSortBy, $sSortOrder, $iPageSize, iOffset)

  ' Update HasMorePages based on total count
  If (iOffset + oNewPhotos.Count) >= $iTotalCount Then
    $HasMorePages = False
    $LogMessage = New LogMessage($Titulo, "LoadNextBatch", "Last page reached (total=" & $iTotalCount & ")")
    $Logger.Debug($LogMessage)
  Endif

  $LogMessage = New LogMessage($Titulo, "LoadNextBatch", "Batch loaded: " & oNewPhotos.Count & " photos.")
  $Logger.Debug($LogMessage)

  Return oNewPhotos

Catch
  $LogMessage = New LogMessage($Titulo, "LoadNextBatch", "Error loading next batch: " & Error.Text)
  $Logger.Error($LogMessage)
  Return New PhotoEntity[]

End

Public Sub Reset() '' Resets the iterator to the first page.

  $iCurrentPage = 0
  $HasMorePages = True
  UpdateTotalCount()

  $LogMessage = New LogMessage($Titulo, "Reset", "Iterator reset")
  $Logger.Debug($LogMessage)

End

' =============================================================================
'
'          Private methods
'
' =============================================================================

Private Sub UpdateTotalCount()

  $iTotalCount = $cRepository.CountWithFilters($Specification)
  
  ' If total is 0, no more pages from the start
  If $iTotalCount = 0 Then
    $HasMorePages = False
  Endif

  $LogMessage = New LogMessage($Titulo, "UpdateTotalCount", "Total photos with specification: " & $iTotalCount)
  $Logger.Debug($LogMessage)

Catch
  $LogMessage = New LogMessage($Titulo, "UpdateTotalCount", "Error counting photos: " & Error.Text)
  $Logger.Error($LogMessage)
  $iTotalCount = 0
  $HasMorePages = False
  Error.Propagate

End
