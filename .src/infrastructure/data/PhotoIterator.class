Private $cRepository As PhotoRepository
Private $iCurrentIndex As Integer = 0
Private $iPageSize As Integer = 15
Private $iCurrentPage As Integer = 0
Private $aCachedPhotos As PhotoEntity[]
Private $iTotalCount As Integer = 0
Private $Log4Gambas As LoggerPort
Private $bHasMorePages As Boolean = True
' Filters
Private $bFilterGarbage As Boolean = False
Private $bFilterFavorites As Boolean = False
Private $sFilterFormat As String = ""
Private $dFilterDateFrom As Date
Private $dFilterDateTo As Date
Private $sFilterUser As String = ""
Private $sSearchText As String = ""
Private $iFilterAlbumId As Integer = 0
Private $sSortBy As String = "import_date"  ' import_date, file_name, creation_date
Private $sSortOrder As String = "DESC"      ' ASC, DESC

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(cRepository As PhotoRepository, oLogger As LoggerPort)
  $cRepository = cRepository
  $Log4Gambas = oLogger
  $aCachedPhotos = New PhotoEntity[]

  ' Count total with current filters
  UpdateTotalCount()

End

Public Sub SetFilterAlbum(albumId As Integer)
  
  If $iFilterAlbumId = albumId Then Return
  
  $iFilterAlbumId = albumId
  Reset()
  
End

