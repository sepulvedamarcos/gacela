' Read-only properties
Property Read IsFiltered As Boolean

Function IsFiltered_Read() As Boolean

  Return $bFilterFavorites Or $sFilterFormat <> "" Or $dFilterDateFrom <> Null Or $dFilterDateTo <> Null Or $sFilterUser <> "" Or $sSearchText <> "" Or $iFilterAlbumId > 0

End
