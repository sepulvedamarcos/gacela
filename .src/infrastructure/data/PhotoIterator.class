Public Function LoadNextBatch() As PhotoEntity[] '' Load next batch for infinite scroll

  Dim iOffset As Integer
  Dim oNewPhotos As New PhotoEntity[]

  ' If there are no more pages
  If Not $bHasMorePages Then
    $Log4Gambas.Debug("No more pages to load")
    Return oNewPhotos
  Endif

  $iCurrentPage = $iCurrentPage + 1
  iOffset = ($iCurrentPage - 1) * $iPageSize

  $Log4Gambas.Debug("Loading page " & $iCurrentPage & " (iOffset=" & iOffset & ", limit=" & $iPageSize & ")")

  ' Load next batch from $cRepository
  oNewPhotos = $cRepository.FindWithFilters(BuildFilterQuery(), $sSortBy, $sSortOrder, $iPageSize, iOffset)

  For Each cPhoto As PhotoEntity In oNewPhotos
    $aCachedPhotos.Add(cPhoto)
  Next

  ' If fewer than expected were loaded, there are no more pages
  If oNewPhotos.Count < $iPageSize Then
    $bHasMorePages = False
    $Log4Gambas.Debug("Last page reached")
  Endif

  $Log4Gambas.Debug("Batch loaded: " & oNewPhotos.Count & " photos. Cached total: " & $aCachedPhotos.Count)

  Return oNewPhotos

Catch
  $Log4Gambas.Error("Error loading next batch: " & Error.Text)

End

Public Sub Reset() '' Reset iterator

  $iCurrentIndex = 0
  $iCurrentPage = 0
  $aCachedPhotos.Clear()
  $bHasMorePages = True
  UpdateTotalCount()

  $Log4Gambas.Debug("Iterator reset")

End

