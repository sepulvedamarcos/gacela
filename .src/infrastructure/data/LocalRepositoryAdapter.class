Public Function CreatePhoto(photoE As PhotoEntity, Optional photoAlbumE As PhotoAlbumEntity) As Boolean
  
  Dim oResult As Result
  Dim iPhotoId As Integer
  Dim iPhotoAlbumId As Integer
  
  $DbContext.DBConnection.Begin()
  
  oResult = $DbContext.DBConnection.Create(LocalRepositoryAdapter.TABLE_PHOTOS)
  oResult["file_name"] = photoE.FileName
  oResult["width_pixels"] = photoE.WidthPixels
  oResult["height_pixels"] = photoE.HeightPixels
  oResult["creation_date"] = Now()
  oResult["import_date"] = photoE.ImportDate
  oResult["description"] = photoE.Description
  oResult["stars"] = photoE.Stars
  oResult["import_user"] = photoE.ImportUser
  oResult["image_path"] = photoE.ImagePath
  oResult["original_path"] = photoE.OriginalPath
  oResult["Hash256"] = photoE.Hash256
  oResult["thumbnail"] = photoE.Thumbnail
  oResult["last_sync_date"] = Null
  oResult["sync_status"] = 0
  oResult["soft_delete"] = False
  oResult["soft_deleted_date"] = Null
  oResult["soft_deleted_by"] = Null
  oResult["soft_deleted_auto"] = Null
  oResult["is_locked"] = False
  oResult["locked_by"] = Null
  oResult["locked_date"] = Null
  oResult["lock_reason"] = Null
  oResult.Update()
  
  iPhotoId = $DbContext.DBConnection.LastInsertId
  $LogMessage = New LogMessage($Titulo, "CreatePhoto", ("Photo code created") & " [" & iPhotoId & "]")
  $Logger.Debug($LogMessage)
  
  If photoAlbumE <> Null Then
    oResult = $DbContext.DBConnection.Create(LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS)
    oResult["photo_id"] = iPhotoId
    oResult["album_id"] = photoAlbumE.AlbumId
    oResult["order_in_album"] = photoAlbumE.OrderInAlbum
    oResult["added_date"] = Now()
    oResult["added_user"] = photoAlbumE.AddedUser
    oResult.Update()
    
    iPhotoAlbumId = $DbContext.DBConnection.LastInsertId
    $LogMessage = New LogMessage($Titulo, "CreatePhoto", ("Photo-album code created") & " [" & iPhotoAlbumId & "]")
  $Logger.Debug($LogMessage)
    
  End If
  
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "CreatePhoto", "Problems creating photo, rolling back")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function AddPhotoToAlbum(photoId As Integer, albumId As Integer, Optional orderInAlbum As Integer = 0, Optional addedUser As String = "") As Boolean
  
  Dim oResult As Result
  Dim iExists As Integer
  
  If photoId <= 0 Or albumId <= 0 Then Return False
  If addedUser = "" Then addedUser = User.Name
  
  oResult = $DbContext.DBConnection.Exec("SELECT COUNT(*) AS iTotal FROM " & LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1 AND album_id = &2", photoId, albumId)
  If oResult.Available Then
    iExists = oResult["iTotal"]
  Endif
  
  If iExists > 0 Then
    Return True
  Endif
  
  $DbContext.DBConnection.Begin
  oResult = $DbContext.DBConnection.Create(LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS)
  oResult["photo_id"] = photoId
  oResult["album_id"] = albumId
  oResult["order_in_album"] = orderInAlbum
  oResult["added_date"] = Now
  oResult["added_user"] = addedUser
  oResult.Update()
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "AddPhotoToAlbum", "Problem adding photo to album: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function RemovePhotoFromAlbum(photoId As Integer, albumId As Integer) As Boolean
  
  If photoId <= 0 Or albumId <= 0 Then Return False
  
  $DbContext.DBConnection.Begin
  $DbContext.DBConnection.Exec("DELETE FROM " & LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS & " WHERE photo_id = &1 AND album_id = &2", photoId, albumId)
  $DbContext.DBConnection.Commit
  
  Return True
  
Catch
  $DbContext.DBConnection.Rollback
  $LogMessage = New LogMessage($Titulo, "RemovePhotoFromAlbum", "Problem removing photo from album: " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function ValidateHash256Exist(sHash256 As String) As Boolean
  
  Dim sQuery As String
  Dim iTotal As Integer
  Dim oResult As Result
  
  $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Validating in table with Hash256") & " [" & sHash256 & "]")
  $Logger.Debug($LogMessage)
  sQuery = "SELECT COUNT(*) as iTotal FROM " & LocalRepositoryAdapter.TABLE_PHOTOS &
    " WHERE Hash256 = &1"
  oResult = $DbContext.DBConnection.Exec(sQuery, sHash256)
  
  If oResult.Available Then
    iTotal = oResult["iTotal"]
    If iTotal >= 1 Then
      $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Image already exists with that Hash256"))
  $Logger.Debug($LogMessage)
      Return True
    End If
  End If
  
  $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Image does not exist"))
  $Logger.Debug($LogMessage)
  Return False
  
Catch
  $LogMessage = New LogMessage($Titulo, "ValidateHash256Exist", ("Error searching photo by Hash256"))
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Public Function FindAlbums(Optional text As String, Optional id As Integer = 0, Optional useSoftDelete As Integer = -1) As AlbumEntity[]
  
  Dim sQuery As String
  Dim oResult As Result
  Dim sCon As String = " WHERE "
  
  sQuery = "SELECT * FROM " & LocalRepositoryAdapter.TABLE_ALBUMS
  If useSoftDelete <> -1 Then
    sQuery &= " WHERE soft_delete = " & useSoftDelete
    sCon = " AND "
  Endif
  
  If id <> 0 Then
    sQuery &= sCon & " album_id = " & id
  Endif
  
  If text <> "" Then
    sQuery &= sCon & " LOWER(name) LIKE '%" & Lower(text) & "%'"
  Endif
  
  $LogMessage = New LogMessage($Titulo, "FindAlbums", "Query [" & sQuery & "]")
  $Logger.Debug($LogMessage)
  oResult = $DbContext.DBConnection.Exec(sQuery)
  If oResult.Available Then
    Return MapAlbumEntitys(oResult)
  Endif
  
  Return New AlbumEntity[]
  
Catch
  $LogMessage = New LogMessage($Titulo, "FindAlbums", "Problem reading albums")
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================
Private Sub EnsureSchema()
  
  Dim oDb As Connection
  
  oDb = $DbContext.DBConnection
  If oDb = Null Or oDb.Tables = Null Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Database connection is not ready"))
    Error.Raise($LogMessage.ToText())
  Endif
  
  $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Checking the existence of schema tables..."))
  $Logger.Debug($LogMessage)
  ' 1. Photos table (photos)
  If Not oDb.Tables.Exist(LocalRepositoryAdapter.TABLE_PHOTOS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & LocalRepositoryAdapter.TABLE_PHOTOS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreatePhotosTable(oDb)
  Endif
  ' 2. Albums table (albums)
  If Not oDb.Tables.Exist(LocalRepositoryAdapter.TABLE_ALBUMS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & LocalRepositoryAdapter.TABLE_ALBUMS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreateAlbumsTable(oDb)
  Endif
  ' 3. Tags table (tags)
  If Not oDb.Tables.Exist(LocalRepositoryAdapter.TABLE_TAGS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & LocalRepositoryAdapter.TABLE_TAGS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreateTagsTable(oDb)
  Endif
  ' 4. Photos-Albums relationship table (photo_albums)
  If Not oDb.Tables.Exist(LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreatePhotosAlbumsTable(oDb)
  Endif
  ' 5. Photos-Tags relationship table (photos_tags)
  If Not oDb.Tables.Exist(LocalRepositoryAdapter.TABLE_PHOTOS_TAGS) Then
    $LogMessage = New LogMessage($Titulo, "EnsureSchema", "[" & LocalRepositoryAdapter.TABLE_PHOTOS_TAGS & "]" & $TableNotExist)
    $Logger.Info($LogMessage)
    CreatePhotosTagsTable(oDb)
  Endif
  
  If Not oDb.Tables.Exist("DBVersion") Then
    CreateDBVersionTable(oDb)
  Endif
  EnsureDBVersion(oDb)
  RunMigrations(oDb)
  
  EnsurePhotosTableColumns(oDb)
  $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Table check and creation finished."))
  $Logger.Debug($LogMessage)
  
Catch
  $LogMessage = New LogMessage($Titulo, "EnsureSchema", ("Table check/creation failed:") & " " & Error.Text)
  $Logger.Error($LogMessage)
  Error.Raise($LogMessage.ToText())
  
End

Private Sub CreatePhotosTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables = Null Then
    $LogMessage = New LogMessage($Titulo, "CreatePhotosTable", "Tables collection is not available")
    Error.Raise($LogMessage.ToText())
  Endif
  oTable = oDb.Tables.Add(LocalRepositoryAdapter.TABLE_PHOTOS)
  If oTable = Null Then
    $LogMessage = New LogMessage($Titulo, "CreatePhotosTable", "Cannot create table " & LocalRepositoryAdapter.TABLE_PHOTOS)
    Error.Raise($LogMessage.ToText())
  Endif
  With oTable
    .Fields.Add("photo_id", db.Serial)                 '' Record identifier
    .Fields.Add("file_name", db.String, 255)           '' Original file name
    .Fields.Add("width_pixels", db.Integer)            '' Width in pixels
    .Fields.Add("height_pixels", db.Integer)           '' Height in pixels
    .Fields.Add("creation_date", db.Date)              '' Photo creation date
    .Fields.Add("import_date", db.Date)                '' Import date into Gacela
    .Fields.Add("description", db.String)              '' Photo description
    .Fields.Add("stars", db.Integer)                   '' Star rating count
    .Fields.Add("import_user", db.String, 50)          '' Importing user
    .Fields.Add("image_path", db.String, 255)          '' Full path to original image
    .Fields.Add("original_path", db.String, 255)       '' Original source path
    .Fields.Add("Hash256", db.String, 255)             '' Image hash for existence validation
    .Fields.Add("thumbnail", db.Blob)                  '' MINIATURA (BLOB)
    .Fields.Add("last_sync_date", db.Date)             '' Last sync date (for future cloud sync)
    .Fields.Add("sync_status", db.Integer)             '' Sync status indicator
    .Fields.Add("soft_delete", db.Boolean)             '' Soft delete (garbage collector)
    .Fields.Add("soft_deleted_date", db.date)          '' Date when it was soft-deleted
    .Fields.Add("soft_deleted_by", db.String, 50)      '' User who deleted it
    .Fields.Add("soft_deleted_auto", db.Date)          '' Date when it should be physically deleted
    .Fields.Add("is_locked", db.Boolean)               '' Indicates if it is locked for deletion
    .Fields.Add("locked_by", db.String, 50)            '' User who locked the photo
    .Fields.Add("locked_date", db.date)                '' Date when it was locked
    .Fields.Add("lock_reason", db.String, 200)         '' Reason why it was locked
    .PrimaryKey = ["photo_id"]                         '' Create primary key
    .Update()
  End With
  
  $LogMessage = New LogMessage($Titulo, "CreatePhotosTable", "[" & LocalRepositoryAdapter.TABLE_PHOTOS & "]" & $TableCreate)
  $Logger.Debug($LogMessage)
  
End

Private Sub EnsurePhotosTableColumns(oDb As Connection)
  
  Dim oTable As Table
  Dim oResult As Result
  Dim bHasOriginalPath As Boolean
  
  If Not oDb.Tables.Exist(LocalRepositoryAdapter.TABLE_PHOTOS) Then Return
  
  oTable = oDb.Tables[LocalRepositoryAdapter.TABLE_PHOTOS]
  If oTable = Null Then
    $LogMessage = New LogMessage($Titulo, "EnsurePhotosTableColumns", "Cannot open table " & LocalRepositoryAdapter.TABLE_PHOTOS)
    Error.Raise($LogMessage.ToText())
  Endif
  If Not oTable.Fields.Exist("original_path") Then
    Try oDb.Exec("ALTER TABLE " & LocalRepositoryAdapter.TABLE_PHOTOS & " ADD COLUMN original_path TEXT")
    If Error Then
      $LogMessage = New LogMessage($Titulo, "EnsurePhotosTableColumns", ("Error adding original_path column") & " " & Error.Text)
      $Logger.Error($LogMessage)
    Endif
  Endif
  
  bHasOriginalPath = False
  oResult = oDb.Exec("PRAGMA table_info(" & LocalRepositoryAdapter.TABLE_PHOTOS & ")")
  While oResult.Available
    If oResult["name"] = "original_path" Then
      bHasOriginalPath = True
      Exit
    Endif
    oResult.MoveNext()
  Wend
  
  If Not bHasOriginalPath Then
    $LogMessage = New LogMessage($Titulo, "EnsurePhotosTableColumns", ("Column original_path was not created"))
    $Logger.Warning($LogMessage)
  Endif
  
End

Private Sub CreateAlbumsTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables = Null Then
    $LogMessage = New LogMessage($Titulo, "CreateAlbumsTable", "Tables collection is not available")
    Error.Raise($LogMessage.ToText())
  Endif
  oTable = oDb.Tables.Add(LocalRepositoryAdapter.TABLE_ALBUMS)
  If oTable = Null Then
    $LogMessage = New LogMessage($Titulo, "CreateAlbumsTable", "Cannot create table " & LocalRepositoryAdapter.TABLE_ALBUMS)
    Error.Raise($LogMessage.ToText())
  Endif
  With oTable
    .Fields.Add("album_id", db.Serial)                 '' Record identifier
    .Fields.Add("name", db.String, 255)                '' Album short name
    .Fields.Add("description", db.String)              '' Album description
    .Fields.Add("creation_date", db.Date)              '' Album creation date
    .Fields.Add("creation_user", db.String, 50)        '' User who created the album
    .Fields.Add("thumbnail", db.Blob)                  '' ← MINIATURA (BLOB)
    .Fields.Add("soft_delete", db.Boolean)             '' Soft delete
    .PrimaryKey = ["album_id"]                         '' Create primary key
    .Update()
  End With
  
  $LogMessage = New LogMessage($Titulo, "CreateAlbumsTable", "[" & LocalRepositoryAdapter.TABLE_ALBUMS & "]" & $TableCreate)
  $Logger.Debug($LogMessage)
  
End

Private Sub CreatePhotosAlbumsTable(oDb As Connection)
  
  Dim oTable As Table
  
  If oDb.Tables = Null Then
    $LogMessage = New LogMessage($Titulo, "CreatePhotosAlbumsTable", "Tables collection is not available")
    Error.Raise($LogMessage.ToText())
  Endif
  oTable = oDb.Tables.Add(LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS)
  If oTable = Null Then
    $LogMessage = New LogMessage($Titulo, "CreatePhotosAlbumsTable", "Cannot create table " & LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS)
