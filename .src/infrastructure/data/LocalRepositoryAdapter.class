    .PrimaryKey = ["pho_alb_id"]
    .Update()
  End With
  
  $LogMessage = New LogMessage($Titulo, "CreatePhotosAlbumsTable", "[" & LocalRepositoryAdapter.TABLE_PHOTOS_ALBUMS & "]" & $TableCreate)
  $Logger.Debug($LogMessage)
  
End

