' Gambas class file

' Local filesystem implementation for FileStoragePort.
Inherits FileStoragePort

Public Function EnsureDirectory(sPath As String) As Boolean

  If sPath = "" Then Return False
  If Not Exist(sPath) Then Mkdir sPath
  Return True

Catch
  Error.Propagate

End

Public Function SaveFile(sSourcePath As String, sTargetPath As String) As Boolean

  Copy sSourcePath To sTargetPath
  Return True

Catch
  Error.Propagate

End

Public Function DeleteFile(sPath As String) As Boolean

  Kill sPath
  Return True

Catch
  Error.Propagate

End

Public Function MoveFile(sSourcePath As String, sTargetPath As String) As Boolean '' Implements filesystem-level file moving.

  Move sSourcePath To sTargetPath
  Return True

Catch
  Error.Propagate

End

Public Function Exists(sPath As String) As Boolean

  Return Exist(sPath)

End
