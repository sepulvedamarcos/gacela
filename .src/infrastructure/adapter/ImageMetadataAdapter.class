' Gambas class file

'
'
' Class that adapts the use of identify from the command line
'
'

Private $Log4gambas As Log4Gambas3
Private $Titulo As String = "[ImageMetadataAdapter] "

' ==================================================
'
'          Public methods
'
' ==================================================
Public Sub _new(oLog4gambas As Log4Gambas3)
  
  $Log4gambas = oLog4gambas
  
End

Public Function GetExifDateTimeOriginal(imagenPath As String) As String
  
  Dim sCommandText As String
  Dim sExifData As String
  
  $Log4gambas.info($Titulo & "Extracting metadata with identify")
  sCommandText = "identify -format \"%[EXIF:DateTimeOriginal]\" -- " & ShellQuote(imagenPath)
  sExifData = ExecShellCommand(sCommandText)
  
  Return NormalizeExifDate(Trim(sExifData))
  
Catch
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================

Private Function ExecShellCommand(sCommandText As String) As String
  
  Dim sOutputCommand As String
  
  $Log4gambas.Debug($Titulo & "Shell execution [" & sCommandText & "]")
  Shell sCommandText To sOutputCommand
  
  $Log4gambas.Debug($Titulo & "Shell response [" & sOutputCommand & "]")
  
  Return sOutputCommand
  
Catch 
  $Log4gambas.Error($Titulo & ("Error extracting image metadata: ") & Error.Text)
  Error.Propagate
  
End

Private Function NormalizeExifDate(sExifText As String) As String
  
  Dim sText As String
  Dim sParts As String[]
  Dim sDateParts As String[]
  Dim sTimeParts As String[]
  Dim iYear As Integer
  Dim iMonth As Integer
  Dim iDay As Integer
  Dim iHour As Integer
  Dim iMinute As Integer
  Dim iSecond As Integer
  
  sText = Trim(sExifText)
  If sText = "" Then Return ""
  
  ' EXIF format: YYYY:MM:DD HH:MM:SS (or date only)
  If sText Like "****:**:** **:**:**" Or sText Like "****:**:**" Then
    sParts = Split(sText, " ")
    sDateParts = Split(sParts[0], ":")
    If sDateParts.Count <> 3 Then Return ""
    
    iYear = Val(sDateParts[0])
    iMonth = Val(sDateParts[1])
    iDay = Val(sDateParts[2])
    
    If Len(sDateParts[0]) <> 4 Then Return ""
    If Len(sDateParts[1]) <> 2 Then Return ""
    If Len(sDateParts[2]) <> 2 Then Return ""
    If iYear < 1 Then Return ""
    If iMonth < 1 Or iMonth > 12 Then Return ""
    If iDay < 1 Or iDay > 31 Then Return ""
    
    sParts[0] = sDateParts[1] & "/" & sDateParts[2] & "/" & sDateParts[0]
    
    If sParts.Count > 1 Then
      sTimeParts = Split(sParts[1], ":")
      If sTimeParts.Count <> 3 Then Return ""
      
      iHour = Val(sTimeParts[0])
      iMinute = Val(sTimeParts[1])
      iSecond = Val(sTimeParts[2])
      
      If Len(sTimeParts[0]) <> 2 Then Return ""
      If Len(sTimeParts[1]) <> 2 Then Return ""
      If Len(sTimeParts[2]) <> 2 Then Return ""
      If iHour < 0 Or iHour > 23 Then Return ""
      If iMinute < 0 Or iMinute > 59 Then Return ""
      If iSecond < 0 Or iSecond > 59 Then Return ""
      
      Return sParts[0] & " " & sParts[1]
    Endif
    
    Return sParts[0]
  Endif
  
  ' If no ":" but valid date, return as-is. Otherwise, reject.
  If IsDate(sText) Then Return sText
  
  Return ""
  
End

Private Function ShellQuote(sValue As String) As String
  
  ' Protects spaces and special characters for shell execution.
  Return "'" & Replace(sValue, "'", "'\\''") & "'"
  
End
