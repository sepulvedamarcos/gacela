' Gambas class file

'
'
' Class that adapts the use of identify from the command line
'
'

Private $Logger As Log4GambasAdapter
Private $LogMessage As LogMessage
Private $Titulo As String = "ImageMetadataAdapter"
' ==================================================
'
'          Public methods
'
' ==================================================

Public Sub _new(oLogger As Log4GambasAdapter)
  
  $Logger = oLogger
  
End

Public Function GetExifDateTimeOriginal(sImagenPath As String) As Date
  
  Dim sCommandText As String
  Dim sExifData As String
  Dim sMethod As String = "GetExifDateTimeOriginal"
  Dim sMessage As String = ("Extracting metadata with identify")
  
  $LogMessage = New LogMessage($Titulo, sMethod, sMessage)
  $Logger.Info($LogMessage)
  sCommandText = "identify -format \"%[EXIF:DateTimeOriginal]\" -- " & ShellQuote(sImagenPath)
  sExifData = ExecShellCommand(sCommandText)
  
  Return NormalizeExifDate(Trim(sExifData))
  
Catch
  Error.Propagate
  
End

' ==================================================
'
'          Private methods
'
' ==================================================

Private Function ExecShellCommand(sCommandText As String) As String
  
  Dim sOutputCommand As String
  
  $LogMessage = New LogMessage($Titulo, "ExecShellCommand", "Shell execution [" & sCommandText & "]")
  $Logger.Debug($LogMessage)
  Shell sCommandText To sOutputCommand
  
  $LogMessage = New LogMessage($Titulo, "ExecShellCommand", "Shell response [" & sOutputCommand & "]")
  $Logger.Debug($LogMessage)
  
  Return sOutputCommand
  
Catch
  $LogMessage = New LogMessage($Titulo, "ExecShellCommand", ("Error extracting image metadata: ") & Error.Text)
  $Logger.Error($LogMessage)
  Error.Propagate
  
End

Private Function NormalizeExifDate(sExifText As String) As Date
  
  Dim sText As String
  Dim aParts As String[]
  Dim aDateParts As String[]
  Dim aTimeParts As String[]
  Dim dExifDate As Date 
  
  '' This function must return the date format dd/mm/yyyy HH:mm:ss
  
  sText = Trim(sExifText)
  If sText = "" Then Return ""
  ' EXIF format often uses ":" instead of "-" or "/" for dates (YYYY:MM:DD)
  ' We try to detect and convert it so Gambas CDate can handle it.
  If sText Like "****:**:** *" Or sText Like "****:**:**" Then
    aParts = Split(sText, " ")
    aDateParts = Split(aParts[0], ":")
    aTimeParts = Split(aParts[1], ":")
    
    If aDateParts.Count = 3 Then
      ' Convert YYYY:MM:DD to YYYY-MM-DD
      ' Return sDateParts[0] & "-" & sDateParts[1] & "-" & sDateParts[2] & If(sParts.Count > 1, " " & sParts[1], "")
      ' Return sDateParts[2] & "/" & sDateParts[1] & "/" & sDateParts[0] & If(sParts.Count > 1, " " & sParts[1], "")
      dExifDate = Date(aDateParts[0], aDateParts[1], aDateParts[2], aTimeParts[0], aTimeParts[1], aTimeParts[2])
      Return dExifDate
    Endif
  Endif
  
  If IsDate(sText) Then Return sText
  
  Return ""
  
End

Private Function ShellQuote(sValue As String) As String
  
  ' Protects spaces and special characters for shell execution.
  Return "'" & Replace(sValue, "'", "'\\''") & "'"
  
End
