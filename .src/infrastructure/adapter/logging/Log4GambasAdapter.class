' Gambas class file

' Adapter from LoggerPort to Log4Gambas3.
' this class it's used only in factory method
Inherits LoggerPort

Private $Backend As New Log4Gambas3

Public Sub Debug(oMessage As LogMessage)
  $Backend.Debug(Super.FormatMessage(oMessage))
End

Public Sub Info(oMessage As LogMessage)
  $Backend.Info(Super.FormatMessage(oMessage))
End

Public Sub Warning(oMessage As LogMessage)
  $Backend.Warning(Super.FormatMessage(oMessage))
End

Public Sub Error(oMessage As LogMessage)
  $Backend.Error(Super.FormatMessage(oMessage))
End

Public Sub Fatal(oMessage As LogMessage)
  $Backend.Fatal(Super.FormatMessage(oMessage))
End

Public Sub SetAppName(sAppName As String)
  $Backend.SetAppName(sAppName)
End

Public Sub SetMinLevel(iLevel As Integer)
  $Backend.SetMinLevel(iLevel)
End

Public Sub SetOutput(iOutput As Integer)
  $Backend.SetOutput(iOutput)
End

Public Sub SetLogFile(sLogFile As String)
  $Backend.SetLogFile(sLogFile)
End

Public Sub SetMaxFileSize(iSizeBytes As Integer)
  $Backend.SetMaxFileSize(iSizeBytes)
End

Public Sub SetMaxFiles(iMaxFiles As Integer)
  $Backend.SetMaxFiles(iMaxFiles)
End

Public Function GetMinLevel() As Integer
  Return $Backend.GetMinLevel()
End

Public Function GetLogFile() As String
  Return $Backend.GetLogFile()
End

Public Function GetMaxFileSize() As Integer
  Return $Backend.GetMaxFileSize()
End

Public Function GetMaxFiles() As Integer
  Return $Backend.GetMaxFiles()
End

Public Function GetDefaultLevelDebug() As Integer
  Return $Backend.LEVEL_DEBUG
End

Public Function GetDefaultOutputBoth() As Integer
  Return $Backend.OUTPUT_BOTH
End

Public Function GetLevels() As String[]
  Return $Backend.Levels
End

Public Function GetOutputs() As String[]
  Return $Backend.Outputs
End
